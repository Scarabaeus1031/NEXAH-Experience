---
import DoorCard from "@/components/navigation/DoorCard.astro";
import OrientationScienceEntry from "@/components/navigation/OrientationScienceEntry.astro";
import { editorialDoors, guidedBeginnings } from "@/data/navigation";
import BaseLayout from "@/layouts/BaseLayout.astro";

const remainingDoors = editorialDoors.filter((door) => door.id !== "foundations");
---

<BaseLayout title="Explore Orientation Cartography — NEXAH" description="Six editorial doors into the fields, maps and publications of NEXAH orientation cartography.">
  <header class="container explore-hero">
    <p class="eyebrow">Where should I begin?</p>
    <h1>Choose a way into the mapped landscape.</h1>
    <p class="lead">These are editorial doors, not categories. Each reveals a different field of relationships.</p>
  </header>

  <section class="container explore-science" aria-label="Orientation Science entrance">
    <OrientationScienceEntry />
  </section>

  <section class="container door-grid" aria-label="Editorial entry doors">
    {remainingDoors.map((door) => <DoorCard door={door} />)}
  </section>

  <section class="container guided-beginnings" aria-labelledby="guided-title">
    <header><p class="eyebrow">Guided beginnings</p><h2 id="guided-title">If you would rather follow a path.</h2></header>
    <ol>
      {guidedBeginnings.map((beginning, index) => (
        <li><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{beginning.title}</h3><p>{beginning.description}</p></div><a href={beginning.href} aria-label={`Begin: ${beginning.title}`} data-carry-question={beginning.id === "study-the-system" ? undefined : true}>→</a></li>
      ))}
    </ol>
  </section>

  <aside class="container complete-library-invitation">
    <div><p class="eyebrow">What exists?</p><h2>The complete Library remains open.</h2></div>
    <a class="button button--secondary" href="/library/" data-carry-question>View all 61 publications</a>
  </aside>
</BaseLayout>
