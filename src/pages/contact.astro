---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Contact — NEXAH" description="The preferred public contact for the NEXAH editorial research project.">
  <article class="legal-page">
    <header class="container legal-hero">
      <p class="eyebrow">Contact</p>
      <h1>A quiet line to NEXAH.</h1>
      <p class="lead">For editorial, research and publication enquiries, email is the preferred public contact.</p>
    </header>

    <div class="container legal-content">
      <section aria-labelledby="email-title">
        <h2 id="email-title">Write to us</h2>
        <p><a class="button" href="mailto:contact@nexah.de">contact@nexah.de</a></p>
        <p>There is no contact form, account or newsletter. Your email is sent through your own email provider.</p>
      </section>

      <section class="contact-address" aria-labelledby="operator-title">
        <h2 id="operator-title">Operator</h2>
        <address>
          Haptikdesign GmbH<br />
          Fuchstanzstraße 33–35<br />
          60489 Frankfurt am Main<br />
          Germany
        </address>
      </section>
    </div>
  </article>
</BaseLayout>
