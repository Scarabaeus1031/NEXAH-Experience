---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withPublicRevision } from "@/data/public-route";

const publicRoutes = [
  {
    code: "01",
    title: { de: "Orientieren", en: "Orient" },
    description: { de: "Verstehen, was NEXAH ist, welche Aufgabe es hat und wo seine Grenzen liegen.", en: "Understand what NEXAH is, what it is for and where its boundaries lie." },
    href: "/about/",
    action: { de: "About NEXAH", en: "About NEXAH" },
  },
  {
    code: "02",
    title: { de: "Forschen", en: "Research" },
    description: { de: "Stand, Resultate, Belege, mathematische Felder und offene Fragen prüfen.", en: "Inspect current status, results, evidence, mathematical fields and open questions." },
    href: "/forschen/",
    action: { de: "Zum Forschungsraum", en: "Enter the research space" },
  },
  {
    code: "03",
    title: { de: "Lesen & erkunden", en: "Read & explore" },
    description: { de: "Bücher, Publikationen, Karten und Atlanten als eigene Räume öffnen.", en: "Open books, publications, maps and atlases as spaces in their own right." },
    href: "/library/",
    action: { de: "Zur Library", en: "Open the Library" },
  },
  {
    code: "04",
    title: { de: "Anwenden & erleben", en: "Apply & experience" },
    description: { de: "Touren, Instrumente, Laboratory und die verbundenen öffentlichen Häuser öffnen.", en: "Open tours, instruments, the Laboratory and the connected public houses." },
    href: "/explore/journeys/",
    action: { de: "Tour beginnen", en: "Begin the tour" },
  },
] as const;

const practiceSteps = [
  ["01", { de: "Beobachten", en: "Observe" }, { de: "Zuerst wahrnehmen, was in der gegenwärtigen Ansicht tatsächlich sichtbar ist.", en: "First notice what is actually visible in the present view." }],
  ["02", { de: "Auswählen", en: "Select" }, { de: "Erkennen, dass Aufmerksamkeit und Darstellung immer eine Auswahl treffen.", en: "Recognize that attention and representation always make a selection." }],
  ["03", { de: "Schnitt zeigen", en: "Show the cut" }, { de: "Die Grenze der Ansicht sichtbar machen, statt sie mit der Situation gleichzusetzen.", en: "Make the boundary of the view visible instead of equating it with the situation." }],
  ["04", { de: "Quelle halten", en: "Hold the source" }, { de: "Herkunft, Kontext und Veränderung so erhalten, dass sie später prüfbar bleiben.", en: "Preserve origin, context and change so they remain inspectable later." }],
  ["05", { de: "Vergleichen", en: "Compare" }, { de: "Mehrere Ansichten zusammenhalten, ohne ihre Unterschiede einzuebnen.", en: "Hold multiple views together without flattening their differences." }],
  ["06", { de: "Residuum bewahren", en: "Keep the residual" }, { de: "Widerspruch, Unsicherheit und das noch Ungelöste nicht verstecken.", en: "Do not hide contradiction, uncertainty or what remains unresolved." }],
  ["07", { de: "Zurückkehren", en: "Return" }, { de: "Das Ergebnis an menschliches Urteil, Revision und mögliche Handlung zurückgeben.", en: "Return the result to Human judgment, revision and possible action." }],
] as const;

---

<BaseLayout
  title="NEXAH — Orientierung zwischen Ansichten"
  description="NEXAH macht Quellen, Perspektiven, Veränderungen, Grenzen und mögliche Rückwege zwischen Darstellungen sichtbar."
  hideSessionQuestion={true}
  hideFooter={true}
  lang="de"
>
  <section class="cosmos-threshold" aria-labelledby="cosmos-title">
    <div class="container cosmos-threshold__inner">
      <div class="cosmos-threshold__copy">
        <p class="eyebrow"><span class="lang-copy lang-copy--de">NEXAH · Orientierung an der Schwelle</span><span class="lang-copy lang-copy--en">NEXAH · Orientation at the threshold</span></p>
        <h1 id="cosmos-title"><span class="lang-copy lang-copy--de">Ein Blick in den NEXAH-Kosmos.</span><span class="lang-copy lang-copy--en">A view into the NEXAH Cosmos.</span></h1>
        <p class="lead"><span class="lang-copy lang-copy--de">NEXAH macht Position, Perspektive, Relation und mögliche Wege sichtbar. Es hilft, eine überzeugende Darstellung nicht mit der ganzen Situation zu verwechseln.</span><span class="lang-copy lang-copy--en">NEXAH makes position, perspective, relation and possible paths visible. It helps us avoid mistaking a convincing representation for the whole situation.</span></p>
        <div class="cosmos-threshold__actions">
          <a class="button" href="#what-is-nexah"><span class="lang-copy lang-copy--de">NEXAH verstehen</span><span class="lang-copy lang-copy--en">Understand NEXAH</span> <span aria-hidden="true">↓</span></a>
          <a class="button button--quiet" href={withPublicRevision("/forschen/")}><span class="lang-copy lang-copy--de">Zum Forschungsraum</span><span class="lang-copy lang-copy--en">Enter research</span> <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="cosmos-threshold__diagram" aria-label="Eine Quelle, mehrere begrenzte Ansichten und ein sichtbarer Rückweg">
        <span class="cosmos-threshold__orbit cosmos-threshold__orbit--outer" aria-hidden="true"></span>
        <span class="cosmos-threshold__orbit cosmos-threshold__orbit--inner" aria-hidden="true"></span>
        <span class="cosmos-threshold__axis cosmos-threshold__axis--horizontal" aria-hidden="true"></span>
        <span class="cosmos-threshold__axis cosmos-threshold__axis--vertical" aria-hidden="true"></span>
        <strong>N</strong>
        <small><span class="lang-copy lang-copy--de">Ein Träger.<br />Mehrere begrenzte Ansichten.<br />Ein expliziter Rückweg.</span><span class="lang-copy lang-copy--en">One carrier.<br />Several bounded views.<br />One explicit return path.</span></small>
      </div>
    </div>
  </section>

  <section id="what-is-nexah" class="cosmos-definition section--line" aria-labelledby="definition-title">
    <div class="container cosmos-definition__inner">
      <header>
        <p class="eyebrow"><span class="lang-copy lang-copy--de">Was ist NEXAH?</span><span class="lang-copy lang-copy--en">What is NEXAH?</span></p>
        <h2 id="definition-title"><span class="lang-copy lang-copy--de">Orientierung beginnt dort, wo eine Ansicht ihre Grenze zeigt.</span><span class="lang-copy lang-copy--en">Orientation begins where a view reveals its boundary.</span></h2>
      </header>
      <div class="cosmos-definition__copy">
        <p class="lead"><span class="lang-copy lang-copy--de">NEXAH ist ein Human-governed Orientierungssystem zwischen Kultur, Wissenschaft, Design und Technologie.</span><span class="lang-copy lang-copy--en">NEXAH is a Human-governed orientation system across culture, science, design and technology.</span></p>
        <p><span class="lang-copy lang-copy--de">Es hält Quelle, Auswahl, Veränderung, Evidenz, Unsicherheit und das außerhalb einer Ansicht Liegende unterscheidbar. So können verschiedene Darstellungen miteinander in Beziehung treten, ohne vorschnell identisch gesetzt zu werden.</span><span class="lang-copy lang-copy--en">It keeps source, selection, change, evidence, uncertainty and what lies outside a view distinguishable. Different representations can thus enter into relation without being prematurely declared identical.</span></p>
        <blockquote><span class="lang-copy lang-copy--de">NEXAH unterstützt Verstehen. Bedeutung, Urteil und Verantwortung bleiben beim Menschen.</span><span class="lang-copy lang-copy--en">NEXAH supports understanding. Meaning, judgment and responsibility remain Human.</span></blockquote>
      </div>
    </div>
  </section>

  <section class="cosmos-practice section--line" aria-labelledby="practice-title">
    <div class="container">
      <header class="cosmos-section-heading">
        <div>
          <p class="eyebrow"><span class="lang-copy lang-copy--de">Eine einfache Praxis</span><span class="lang-copy lang-copy--en">A simple practice</span></p>
          <h2 id="practice-title"><span class="lang-copy lang-copy--de">Orientierung beginnt vor der Antwort.</span><span class="lang-copy lang-copy--en">Orientation begins before the answer.</span></h2>
        </div>
        <p><span class="lang-copy lang-copy--de">NEXAH ist kein automatisches Urteilssystem. Es ist eine nachvollziehbare Bewegung vom ersten Blick über Quelle und Vergleich bis zum menschlichen Return.</span><span class="lang-copy lang-copy--en">NEXAH is not an automated judgment system. It is an inspectable movement from the first view through source and comparison to Human return.</span></p>
      </header>
      <ol class="cosmos-practice__steps">
        {practiceSteps.map(([number, title, description]) => (
          <li>
            <span>{number}</span>
            <h3><span class="lang-copy lang-copy--de">{title.de}</span><span class="lang-copy lang-copy--en">{title.en}</span></h3>
            <p><span class="lang-copy lang-copy--de">{description.de}</span><span class="lang-copy lang-copy--en">{description.en}</span></p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="cosmos-routes section--line" aria-labelledby="routes-title">
    <div class="container">
      <header class="cosmos-section-heading">
        <div>
          <p class="eyebrow"><span class="lang-copy lang-copy--de">Öffentliche Wege</span><span class="lang-copy lang-copy--en">Public paths</span></p>
          <h2 id="routes-title"><span class="lang-copy lang-copy--de">Wohin möchten Sie gehen?</span><span class="lang-copy lang-copy--en">Where would you like to go?</span></h2>
        </div>
        <p><span class="lang-copy lang-copy--de">Vier Einstiege ordnen den vorhandenen Bestand. Die vollständige Übersicht bleibt jederzeit über <strong>Navigation +</strong> erreichbar.</span><span class="lang-copy lang-copy--en">Four entrances organize what is already here. The complete directory remains available through <strong>Directory +</strong>.</span></p>
      </header>
      <nav class="cosmos-route-grid" aria-label="Öffentliche NEXAH Wege">
        {publicRoutes.map((route) => (
          <a href={withPublicRevision(route.href)}>
            <span>{route.code}</span>
            <h3><span class="lang-copy lang-copy--de">{route.title.de}</span><span class="lang-copy lang-copy--en">{route.title.en}</span></h3>
            <p><span class="lang-copy lang-copy--de">{route.description.de}</span><span class="lang-copy lang-copy--en">{route.description.en}</span></p>
            <strong><span class="lang-copy lang-copy--de">{route.action.de}</span><span class="lang-copy lang-copy--en">{route.action.en}</span> <b aria-hidden="true">→</b></strong>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="cosmos-boundary" aria-labelledby="boundary-title">
    <div class="container cosmos-boundary__inner">
      <div>
        <p class="eyebrow"><span class="lang-copy lang-copy--de">Öffentliche Projektion</span><span class="lang-copy lang-copy--en">Public projection</span></p>
        <h2 id="boundary-title"><span class="lang-copy lang-copy--de">Die Website zeigt den Weg. Die Quellen tragen die Aussagen.</span><span class="lang-copy lang-copy--en">The website shows the way. The sources carry the claims.</span></h2>
      </div>
      <p><span class="lang-copy lang-copy--de">Interne Desks, Mission Control, Arbeitsaufträge und nicht freigegebene Forschungsstände bleiben außerhalb dieser öffentlichen Ansicht. Science-Inhalte werden source-bound aus dem Science Desk und Science Lab projiziert.</span><span class="lang-copy lang-copy--en">Internal Desks, Mission Control, work orders and unreleased research states remain outside this public view. Science content is projected source-bound from the Science Desk and Science Lab.</span></p>
      <a class="text-link" href="/how-nexah-works/"><span class="lang-copy lang-copy--de">So arbeitet NEXAH →</span><span class="lang-copy lang-copy--en">How NEXAH works →</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .cosmos-threshold {
    position: relative;
    min-height: clamp(36rem, 70vh, 46rem);
    overflow: hidden;
    background: radial-gradient(circle at 78% 47%, rgba(59, 197, 221, .13), transparent 24rem), linear-gradient(135deg, #061a21, #082632 60%, #102b45);
    color: #edf4f2;
  }
  .cosmos-threshold::after { position: absolute; inset: auto -12rem -24rem auto; width: 52rem; height: 52rem; border: 1px solid rgba(59, 197, 221, .24); border-radius: 50%; content: ""; }
  .cosmos-threshold__inner { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(18rem, .7fr); gap: clamp(2.25rem, 4.5vw, 4.5rem); align-items: center; min-height: inherit; padding-block: clamp(2.75rem, 5vw, 4.75rem); }
  .cosmos-threshold .eyebrow { color: #f1bd3d; }
  .cosmos-threshold h1 { max-width: 13ch; margin: .8rem 0 1.35rem; color: #edf4f2; font-size: clamp(2.8rem, 4.35vw, 4.5rem); line-height: .98; }
  .cosmos-threshold .lead { max-width: 46rem; color: #c8d6d9; }
  .cosmos-threshold__actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }
  .cosmos-threshold .button--quiet { border-color: rgba(237,244,242,.45); color: #edf4f2; }
  .cosmos-threshold__diagram { position: relative; aspect-ratio: 1; min-width: 0; border-radius: 50%; }
  .cosmos-threshold__orbit, .cosmos-threshold__axis { position: absolute; display: block; }
  .cosmos-threshold__orbit { inset: 8%; border: 1px solid rgba(59,197,221,.55); border-radius: 50%; }
  .cosmos-threshold__orbit--inner { inset: 28%; border-color: rgba(241,189,61,.7); }
  .cosmos-threshold__axis--horizontal { top: 50%; right: 14%; left: 14%; border-top: 1px solid #f1bd3d; }
  .cosmos-threshold__axis--vertical { top: 14%; bottom: 14%; left: 50%; border-left: 1px solid #f1bd3d; }
  .cosmos-threshold__diagram > strong { position: absolute; inset: 50% auto auto 50%; transform: translate(-50%,-50%); color: #fff; font: 600 3rem/1 var(--serif); }
  .cosmos-threshold__diagram > small { position: absolute; right: 4%; bottom: 9%; max-width: 14rem; color: #a9bdc2; font: 600 .68rem/1.5 var(--mono); }
  .cosmos-definition { background: var(--paper); }
  .cosmos-definition__inner { display: grid; grid-template-columns: minmax(0,.85fr) minmax(0,1.15fr); gap: var(--space-6); padding-block: var(--space-6); }
  .cosmos-definition h2, .cosmos-section-heading h2, .cosmos-boundary h2 { margin: .8rem 0 0; font-size: var(--step-3); line-height: 1.02; }
  .cosmos-definition__copy { max-width: 50rem; }
  .cosmos-definition blockquote { margin: var(--space-5) 0 0; padding: var(--space-4); border-left: 3px solid var(--gold); background: rgba(255,255,255,.45); font-family: var(--serif); font-size: var(--step-1); }
  .cosmos-section-heading { display: grid; grid-template-columns: minmax(0,.8fr) minmax(0,1.2fr); gap: var(--space-6); align-items: end; margin-bottom: var(--space-5); }
  .cosmos-section-heading > p { max-width: 45rem; margin: 0; color: var(--muted); }
  .cosmos-practice { padding-block: var(--space-6); background: #f4efe5; }
  .cosmos-practice__steps { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); margin: 0; padding: 0; border: 1px solid var(--rule); list-style: none; }
  .cosmos-practice__steps li { min-height: 14rem; padding: var(--space-4); border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); background: rgba(255,255,255,.34); }
  .cosmos-practice__steps li:nth-child(4n) { border-right: 0; }
  .cosmos-practice__steps li:nth-last-child(-n+3) { border-bottom: 0; }
  .cosmos-practice__steps li:last-child { border-right: 0; }
  .cosmos-practice__steps span { color: var(--gold); font: 800 .65rem/1 var(--mono); }
  .cosmos-practice__steps h3 { margin: 2.25rem 0 .75rem; font-family: var(--serif); font-size: var(--step-1); font-weight: 400; }
  .cosmos-practice__steps p { color: var(--muted); font-size: .84rem; }
  .cosmos-routes { padding-block: var(--space-6); }
  .cosmos-route-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); border: 1px solid var(--rule); }
  .cosmos-route-grid a { display: flex; min-height: 17rem; flex-direction: column; padding: var(--space-4); border-right: 1px solid var(--rule); color: var(--ink); text-decoration: none; }
  .cosmos-route-grid a:last-child { border-right: 0; }
  .cosmos-route-grid h3 { margin: 2rem 0 .8rem; font-family: var(--serif); font-size: var(--step-1); font-weight: 400; }
  .cosmos-route-grid p { color: var(--muted); }
  .cosmos-route-grid span { color: #f1bd3d; font: 800 .66rem/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; }
  .cosmos-route-grid strong { margin-top: auto; padding-top: var(--space-5); color: var(--gold); font: 800 .68rem/1.4 var(--mono); letter-spacing: .07em; text-transform: uppercase; }
  .cosmos-boundary { padding-block: var(--space-6); border-top: 4px solid var(--gold); background: #f4efe5; }
  .cosmos-boundary__inner { display: grid; grid-template-columns: .9fr 1.1fr; gap: var(--space-6); align-items: start; }
  .cosmos-boundary__inner > p { margin: 0; color: var(--muted); }
  .cosmos-boundary .text-link { grid-column: 2; }
  @media (max-width: 900px) {
    .cosmos-threshold { min-height: auto; }
    .cosmos-threshold__inner, .cosmos-definition__inner, .cosmos-section-heading, .cosmos-boundary__inner { grid-template-columns: 1fr; }
    .cosmos-threshold__diagram { width: min(80vw, 32rem); margin-inline: auto; }
    .cosmos-route-grid { grid-template-columns: repeat(2,1fr); }
    .cosmos-route-grid a:nth-child(2) { border-right: 0; }
    .cosmos-route-grid a:nth-child(-n+2) { border-bottom: 1px solid var(--rule); }
    .cosmos-practice__steps { grid-template-columns: repeat(2,1fr); }
    .cosmos-practice__steps li { min-height: 15rem; border-bottom: 1px solid var(--rule); }
    .cosmos-practice__steps li:nth-child(odd) { border-right: 1px solid var(--rule); }
    .cosmos-practice__steps li:nth-child(even) { border-right: 0; }
    .cosmos-practice__steps li:last-child { border-bottom: 0; }
    .cosmos-boundary .text-link { grid-column: 1; }
  }
  @media (max-width: 600px) {
    .cosmos-threshold h1 { font-size: clamp(2.5rem, 11vw, 3.5rem); }
    .cosmos-threshold__actions { display: grid; }
    .cosmos-route-grid { grid-template-columns: 1fr; }
    .cosmos-route-grid a { min-height: 16rem; border-right: 0; border-bottom: 1px solid var(--rule); }
    .cosmos-route-grid a:last-child { border-bottom: 0; }
    .cosmos-practice__steps { grid-template-columns: 1fr; }
    .cosmos-practice__steps li { min-height: auto; border-right: 0 !important; border-bottom: 1px solid var(--rule); }
  }
</style>
