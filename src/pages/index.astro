---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { publications } from "@/data/catalog";
import { repositoryDocumentUrl } from "@/data/laboratory";

const practiceMovements = [
  {
    number: "01",
    label: "See the frame",
    title: "Notice what became visible.",
    description: "Begin with the present view before reaching for an answer.",
    steps: [
      ["Observe", "Notice what is present before reaching a conclusion."],
      ["Select", "Recognize that attention always chooses."],
      ["Cut", "Make the boundary of the present view visible."],
    ],
  },
  {
    number: "02",
    label: "Keep the difference",
    title: "Make the view inspectable.",
    description: "Preserve enough context to compare without flattening what differs.",
    steps: [
      ["Record", "Keep source, context and selection inspectable."],
      ["Compare", "Hold different views together without making them identical."],
      ["Keep the residual", "Do not hide contradiction, uncertainty or what remains unresolved."],
    ],
  },
  {
    number: "03",
    label: "Human return",
    title: "Bring the result back.",
    description: "The movement ends with Human judgment—not with an automatic conclusion.",
    steps: [
      ["Return", "Bring the result back to Human judgment, revision and possible action."],
    ],
  },
] as const;

const humanWorks = [
  {
    eyebrow: "Clarity",
    title: "CLEAR MIND",
    description: "A Human entry into attention, discernment and meaningful action in a world of overwhelming information.",
    href: "/library/volume-iii-clear-mind/",
  },
  {
    eyebrow: "Beyond information",
    title: "BEYOND INFORMATION",
    description: "Why more knowledge, more experts and more answers do not automatically give a person orientation.",
    href: "/library/beyond-information/",
  },
  {
    eyebrow: "A first path",
    title: "THE VISITOR’S GUIDE",
    description: "A calm beginning through the Library, its rooms and the different ways a person may enter the work.",
    href: "/library/visitors-guide/",
  },
] as const;

const nexahedronUrl = import.meta.env.DEV
  ? "http://127.0.0.1:3001/"
  : "https://nexahedron.com";

const entrances = [
  {
    number: "01",
    eyebrow: "Understood here",
    title: "Understand NEXAH",
    description: "See how source, aperture, difference and Human Return form one practice without becoming the whole world.",
    href: "/about/",
    external: false,
  },
  {
    number: "02",
    eyebrow: "Experienced there",
    title: "Enter NEXAHEDRON",
    description: "Move through one bounded Human View by deliberate choice—and return with the difference intact.",
    href: nexahedronUrl,
    external: true,
  },
  {
    number: "03",
    eyebrow: "Made there",
    title: "Visit Scarabæus",
    description: "Meet the independent studio, released works, making and the Rödelheim Observatory workshop window.",
    href: "https://www.scarabaeus1033.net",
    external: true,
  },
];

const evidence = [
  {
    value: publications.length.toString(),
    title: "Catalogued works",
    description: "Books, visual essays, atlases and field reports catalogued in one public Library.",
    href: "/library/",
    action: "Explore the Library",
    external: false,
  },
  {
    value: "Orientation Language 1.0",
    title: "A bounded vocabulary",
    description: "Published semantics for representations, relations and transitions behind the public practice.",
    href: repositoryDocumentUrl("ORIENTATION_LANGUAGE/README.md"),
    action: "Read the specification",
    external: true,
  },
  {
    value: "Research & Applications",
    title: "A testing layer",
    description: "Methods, documented tests and software kept separate from interpretation and final judgment.",
    href: "/laboratory/",
    action: "Inspect the Laboratory",
    external: false,
  },
];

const publicResearchStatus = [
  ["FORMAL STATUS", "Results available"],
  ["MATURITY", "R2–R3 · internal"],
  ["OPERATING STATE", "Structure Freeze · 0 active"],
  ["NEXT GATE", "External review"],
] as const;
---

<BaseLayout
  title="NEXAH — A Human Project for Orientation"
  description="NEXAH is a source-aware orientation space for knowledge, representations and Human judgment."
  hideEcosystemRail={true}
>
  <section class="home-hero">
    <div class="container home-hero__content">
      <p class="eyebrow arrive">Orientation for knowledge</p>
      <p class="home-hero__mission arrive arrive--2">NEXAH helps people see where a representation ends and judgment begins.</p>
      <h1 class="arrive arrive--2">
        <span>Find your bearings</span>
        <span>in knowledge.</span>
      </h1>
      <p class="lead arrive arrive--2">NEXAH brings sources, images, instruments and research into relation. It helps you see where knowledge comes from, what a view leaves out and which questions open next.</p>
      <div class="home-hero__actions arrive arrive--3">
        <a class="button" href="#public-entrances">Explore the field <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <div class="home-hero__relations" aria-hidden="true">
      <span class="home-hero__relation-trace home-hero__relation-trace--one"></span>
      <span class="home-hero__relation-trace home-hero__relation-trace--two"></span>
      <span class="home-hero__relation-trace home-hero__relation-trace--three"></span>
      <span class="home-hero__relation-trace home-hero__relation-trace--four"></span>
      <span class="home-hero__comparison-point"></span>
    </div>
    <div class="home-hero__landscape" aria-hidden="true"></div>
  </section>

  <section id="mission" class="home-mission section--line" aria-labelledby="home-mission-title">
    <div class="container home-mission__inner">
      <header>
        <p class="eyebrow">Source-aware orientation</p>
        <h2 id="home-mission-title">Know where a view comes from.</h2>
      </header>
      <div class="home-mission__copy">
        <p class="lead">Knowledge reaches us through sources, selections and representations. NEXAH keeps their provenance, context, uncertainty and authority visible enough to inspect and compare.</p>
        <p>A linked source is not automatically a finding, and a convincing view is not the whole situation. Evidence, interpretation and open questions remain distinguishable.</p>
        <blockquote>NEXAH supports orientation. Scientific validity still depends on review, reproducibility and the relevant community of inquiry.</blockquote>
      </div>
    </div>
  </section>

  <section class="home-research-status" aria-labelledby="home-research-status-title">
    <div class="container">
      <header class="home-research-status__header">
        <div>
          <p class="eyebrow">NEXAH Science · Public status</p>
          <h2 id="home-research-status-title">What currently carries.</h2>
        </div>
        <p>Finite results, negative findings and explicit limits are part of the public work. No general theory, physical mechanism or external validation is claimed by presentation alone.</p>
      </header>
      <div class="home-research-status__grid">
        {publicResearchStatus.map(([label, value]) => (
          <div><span>{label}</span><strong>{value}</strong></div>
        ))}
      </div>
      <a class="home-research-status__link" href="/laboratory/">Read results, boundaries and sources <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="home-nexahedron" aria-labelledby="home-nexahedron-title">
    <div class="container home-nexahedron__inner">
      <div class="home-nexahedron__copy">
        <p class="eyebrow">NEXAHEDRON · NEXAH Human View</p>
        <h2 id="home-nexahedron-title">A Built World.</h2>
        <p class="lead">Enter the Human-facing NEXAH world through reading, movement, comparison, play and Return. NEXAHEDRON is where the orientation practice becomes an experience.</p>
        <a class="button" href={nexahedronUrl} target="_blank" rel="noopener noreferrer">Enter NEXAHEDRON <span aria-hidden="true">↗</span></a>
        <small>Bounded public experience · method and science return to NEXAH</small>
      </div>
      <a class="home-nexahedron__portal" href={nexahedronUrl} target="_blank" rel="noopener noreferrer" aria-label="Enter the NEXAHEDRON Human View">
        <span class="home-nexahedron__orbit home-nexahedron__orbit--outer" aria-hidden="true"></span>
        <span class="home-nexahedron__orbit home-nexahedron__orbit--inner" aria-hidden="true"></span>
        <span class="home-nexahedron__aperture" aria-hidden="true"></span>
        <span class="home-nexahedron__signal" aria-hidden="true">READ · TURN · COMPARE · PLAY · RETURN</span>
        <strong>Enter the world <span aria-hidden="true">→</span></strong>
      </a>
    </div>
  </section>

  <section class="home-practice section--line" aria-labelledby="home-practice-title">
    <div class="container">
      <header class="home-practice__header">
        <div>
          <p class="eyebrow">A simple practice</p>
          <h2 id="home-practice-title">Orientation begins before the answer.</h2>
        </div>
        <p>One movement in three parts. First see the frame, then keep the difference, and finally return the result to Human judgment. Open a part only when you want its vocabulary.</p>
      </header>
      <ol class="home-practice__grid">
        {practiceMovements.map((movement) => (
          <li class="home-practice__movement">
            <p class="home-practice__marker"><span>{movement.number}</span>{movement.label}</p>
            <h3>{movement.title}</h3>
            <p class="home-practice__summary">{movement.description}</p>
            <details>
              <summary>Open this movement <span aria-hidden="true">+</span></summary>
              <ol class="home-practice__steps">
                {movement.steps.map(([name, description]) => (
                  <li>
                    <strong>{name}</strong>
                    <p>{description}</p>
                  </li>
                ))}
              </ol>
            </details>
          </li>
        ))}
      </ol>
      <div class="home-practice__return" aria-label="Continue to the public entrances">
        <span aria-hidden="true">↳</span>
        <p><strong>Return, then choose.</strong> The practice stays the same; the next door changes how deeply you enter it.</p>
        <a class="text-link" href="#public-entrances">Choose a door ↓</a>
      </div>
    </div>
  </section>

  <section id="public-entrances" class="home-entrances section--line" aria-labelledby="home-entrances-title">
    <div class="container">
      <header class="home-entrances__header">
        <div>
          <p class="eyebrow">One field · Three doors</p>
          <h2 id="home-entrances-title">Begin here. Choose where to go deeper.</h2>
        </div>
        <p>nexah.de is the common foyer. NEXAH explains the method, NEXAHEDRON lets it be experienced, and Scarabæus shows the independent studio and making behind selected works.</p>
      </header>
      <nav class="home-entrance-grid" aria-label="Public NEXAH field entrances">
        {entrances.map((entrance) => (
          <a
            class="home-entrance"
            href={entrance.href}
            target={entrance.external ? "_blank" : undefined}
            rel={entrance.external ? "noopener noreferrer" : undefined}
          >
            <span class="home-entrance__number">{entrance.number} · {entrance.eyebrow}</span>
            <h3>{entrance.title}</h3>
            <p>{entrance.description}</p>
            <span class="home-entrance__arrow" aria-hidden="true">{entrance.external ? "↗" : "→"}</span>
          </a>
        ))}
      </nav>
      <p class="home-field-boundary">Connected does not mean identical. Each house keeps its own source, role and authority; every door includes a way back.</p>
    </div>
  </section>

  <section class="home-works section--line" aria-labelledby="home-works-title">
    <div class="container">
      <header class="home-works__header">
        <div>
          <p class="eyebrow">Begin with the Human work</p>
          <h2 id="home-works-title">Ideas become useful when they can be lived.</h2>
        </div>
        <p>These works begin with attention, experience and the everyday need to find one’s way. The research remains available behind them—not in front of them.</p>
      </header>
      <div class="home-works__grid">
        {humanWorks.map((work) => (
          <a href={work.href}>
            <span>{work.eyebrow}</span>
            <h3>{work.title}</h3>
            <p>{work.description}</p>
            <b aria-hidden="true">→</b>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-evidence section--line" aria-labelledby="home-evidence-title">
    <div class="container">
      <header class="home-evidence__header">
        <div>
          <p class="eyebrow">The work behind the mission</p>
          <h2 id="home-evidence-title">Culture, design and research remain distinct.</h2>
        </div>
        <p>The Library carries Human experience. The language and instruments support design. The Laboratory tests selected questions. They inform one another without becoming the same claim.</p>
      </header>
      <div class="home-evidence-grid">
        {evidence.map((item) => (
          <article class="home-evidence-card">
            <p class="home-evidence-card__value">{item.value}</p>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <a
              href={item.href}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener noreferrer" : undefined}
            >
              {item.action} <span aria-hidden="true">{item.external ? "↗" : "→"}</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="home-invitation section--line" aria-labelledby="home-invitation-title">
    <div class="container home-invitation__inner">
      <header>
        <p class="eyebrow">The return</p>
        <h2 id="home-invitation-title">
          <span>Notice the frame.</span>
          <span>Keep the difference.</span>
          <span>Return to Human judgment.</span>
        </h2>
      </header>
      <div class="home-invitation__copy">
        <p>NEXAH does not promise a final theory or an automated answer. It builds cultural works, practical instruments and bounded research so that people can remain participants in the systems that shape their lives.</p>
        <nav class="home-invitation__actions" aria-label="Continue exploring NEXAH">
          <a class="button" href="/explore/journeys/">Begin with experience <span aria-hidden="true">→</span></a>
          <a class="button button--quiet" href="/library/">Explore the Library</a>
          <a class="text-link" href="/about/">About NEXAH</a>
        </nav>
        <a class="home-experiment-link" href={nexahedronUrl} target="_blank" rel="noopener noreferrer">
          <small>Experimental access</small>
          <span>Try one Human-facing session in NEXAHEDRON <b aria-hidden="true">↗</b></span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-research-status {
    padding-block: var(--space-6);
    border-bottom: 4px solid var(--gold);
    background: var(--ink);
    color: var(--paper);
  }

  .home-research-status__header {
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    gap: var(--space-6);
    align-items: end;
    margin-bottom: var(--space-5);
  }

  .home-research-status .eyebrow { color: var(--gold); }
  .home-research-status h2 { margin: .45rem 0 0; color: #fff; font-family: var(--serif); font-size: var(--step-3); font-weight: 400; line-height: 1; }
  .home-research-status__header > p { max-width: 44rem; margin: 0; color: color-mix(in srgb, var(--paper) 72%, transparent); }
  .home-research-status__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid #315464; border-left: 1px solid #315464; }
  .home-research-status__grid div { display: flex; min-height: 8rem; flex-direction: column; gap: 1.2rem; padding: 1.25rem; border-right: 1px solid #315464; border-bottom: 1px solid #315464; }
  .home-research-status__grid span { color: var(--cyan); font-size: .65rem; font-weight: 800; letter-spacing: .1em; }
  .home-research-status__grid strong { margin-top: auto; color: #fff; font-family: var(--serif); font-size: var(--step-1); font-weight: 400; line-height: 1.05; }
  .home-research-status__link { display: inline-flex; gap: .75rem; margin-top: var(--space-4); color: var(--gold); font-size: .72rem; font-weight: 800; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }

  .home-hero__mission {
    max-width: 43rem;
    margin: 0 auto var(--space-4);
    color: var(--ink);
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.35;
  }

  .home-mission__inner,
  .home-practice__header,
  .home-works__header {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-6);
    padding-block: var(--space-7);
  }

  .home-mission__inner::before,
  .home-practice__header::before,
  .home-works__header::before {
    position: absolute;
    top: var(--space-4);
    bottom: var(--space-4);
    left: 40%;
    width: 1px;
    background: linear-gradient(transparent, var(--line) 18% 82%, transparent);
    content: "";
    pointer-events: none;
  }

  .home-mission h2,
  .home-practice h2,
  .home-works h2 {
    max-width: 13ch;
    margin: 0;
    font-family: var(--serif);
    font-size: var(--step-3);
    font-weight: 400;
    line-height: 1.08;
  }

  .home-mission__copy {
    max-width: 46rem;
  }

  .home-nexahedron {
    position: relative;
    overflow: hidden;
    border-top: 1px solid #27414f;
    border-bottom: 4px solid var(--gold);
    background:
      radial-gradient(circle at 76% 34%, rgba(61, 196, 224, 0.15), transparent 28%),
      radial-gradient(circle at 68% 72%, rgba(236, 70, 181, 0.12), transparent 25%),
      linear-gradient(90deg, rgba(255,255,255,.018) 0 48.8%, rgba(0,0,0,.34) 50%, rgba(255,255,255,.012) 51.2% 100%),
      #07141e;
    color: #dce8ee;
    box-shadow: inset 0 2.2rem 4.5rem rgba(0,0,0,.2), inset 0 -2.2rem 4.5rem rgba(0,0,0,.24);
  }

  .home-nexahedron::before {
    position: absolute;
    inset: 0 auto 0 50%;
    width: 1px;
    background: linear-gradient(transparent 5%, rgba(114,216,237,.16) 28%, rgba(238,84,190,.2) 72%, transparent 95%);
    content: "";
    pointer-events: none;
  }

  .home-nexahedron__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(24rem, 1.22fr);
    gap: var(--space-7);
    align-items: center;
    min-height: 42rem;
    padding-block: var(--space-7);
  }

  .home-nexahedron .eyebrow { color: var(--gold); }
  .home-nexahedron h2 {
    max-width: 8ch;
    margin: var(--space-3) 0 var(--space-4);
    color: #fff;
    font-family: var(--serif);
    font-size: clamp(4rem, 8vw, 8rem);
    font-weight: 400;
    line-height: 0.84;
    letter-spacing: -0.06em;
  }

  .home-nexahedron__copy .lead { max-width: 36rem; color: #b7c8d1; }
  .home-nexahedron__copy small { display: block; margin-top: var(--space-4); color: #7f98a5; }
  .home-nexahedron__copy .button { margin-top: var(--space-4); background: var(--gold); color: #07141e; }

  .home-nexahedron__portal {
    position: relative;
    display: grid;
    min-height: 33rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid #345365;
    background:
      linear-gradient(rgba(90, 154, 177, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(90, 154, 177, 0.08) 1px, transparent 1px),
      radial-gradient(circle at center, rgba(232, 183, 71, 0.12), transparent 42%),
      #030a10;
    background-size: 2rem 2rem, 2rem 2rem, auto, auto;
    color: #fff;
    text-decoration: none;
    box-shadow: 1.1rem 1.1rem 0 rgba(232, 183, 71, 0.08);
  }

  .home-nexahedron__orbit,
  .home-nexahedron__aperture { position: absolute; border-radius: 50%; }
  .home-nexahedron__orbit--outer { width: 25rem; height: 25rem; border: 1px solid rgba(70, 198, 225, 0.45); color: rgba(70, 198, 225, 0.24); animation: nexah-orbit 22s linear infinite; }
  .home-nexahedron__orbit--inner { width: 15rem; height: 15rem; border: 1px solid rgba(238, 84, 190, 0.5); color: rgba(238, 84, 190, 0.24); animation: nexah-orbit 14s linear infinite reverse; }
  .home-nexahedron__orbit::before,
  .home-nexahedron__orbit::after { content: ""; position: absolute; top: 50%; left: 50%; background: currentColor; transform: translate(-50%, -50%); }
  .home-nexahedron__orbit::before { width: 115%; height: 1px; }
  .home-nexahedron__orbit::after { width: 1px; height: 115%; }
  .home-nexahedron__aperture {
    width: 6rem;
    height: 6rem;
    border: 1px solid var(--gold);
    background: radial-gradient(circle, var(--gold) 0 5%, transparent 6% 100%);
    animation: nexah-breathe 5s ease-in-out infinite;
  }

  .home-nexahedron__signal {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    color: #72d8ed;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.11em;
  }

  .home-nexahedron__portal strong {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-4);
    color: var(--gold);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .home-nexahedron__portal:hover,
  .home-nexahedron__portal:focus-visible { border-color: var(--gold); }

  @keyframes nexah-orbit { to { transform: rotate(360deg); } }
  @keyframes nexah-breathe { 50% { transform: rotate(45deg) scale(1.22); } }

  .home-mission__copy blockquote {
    margin: var(--space-5) 0 0;
    padding: var(--space-4) 0 var(--space-4) var(--space-5);
    border-left: 1px solid var(--gold);
    color: var(--ink);
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.35;
  }

  .home-practice__header > p,
  .home-works__header > p,
  .home-entrances__header > p {
    max-width: 42rem;
    margin: 0;
    align-self: end;
  }

  .home-practice__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--rule);
    background: rgba(255, 255, 255, 0.18);
  }

  .home-practice__movement {
    position: relative;
    min-width: 0;
    padding: var(--space-5);
  }

  .home-practice__movement + .home-practice__movement {
    border-left: 1px solid var(--rule);
  }

  .home-practice__movement:last-child {
    background: linear-gradient(135deg, rgba(180, 132, 38, 0.09), transparent 70%);
  }

  .home-practice__marker {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .home-practice__marker span,
  .home-works__grid > a > span {
    color: var(--gold);
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .home-practice__movement h3,
  .home-works__grid h3 {
    margin: var(--space-4) 0 var(--space-3);
    font-family: var(--serif);
    font-size: var(--step-1);
    font-weight: 400;
  }

  .home-practice__summary,
  .home-works__grid p {
    margin: 0;
  }

  .home-practice__movement details {
    margin-top: var(--space-5);
    border-top: 1px solid var(--rule);
  }

  .home-practice__movement summary {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-3);
    color: var(--ink);
    cursor: pointer;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    list-style: none;
    text-transform: uppercase;
  }

  .home-practice__movement summary::-webkit-details-marker { display: none; }
  .home-practice__movement summary span { color: var(--gold); font-size: 1rem; transition: transform 160ms ease; }
