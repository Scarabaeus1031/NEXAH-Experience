---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { predictionPaper } from "@/data/prediction-paper";

const reviewChecks = [
  ["01", "Source & frame", "Are the orbit sources, epochs, coordinate frame and exit-asymptote transforms sufficiently declared and independently reproducible?"],
  ["02", "Target eligibility", "Can the first eligible post-seal object be selected without discretionary target inspection or retrospective exclusion?"],
  ["03", "Operator", "Are phase, longitude, latitude and executable ALGO transformations deterministic and complete before lock?"],
  ["04", "Uncertainty", "Are covariance or clone ensemble, corridor width and boundary semantics scientifically defensible and frozen in advance?"],
  ["05", "Scoring", "Do HIT, MISS, INDETERMINATE and invalid/null outcomes follow one unambiguous algorithm?"],
  ["06", "Control separation", "Is SLOG-7 reported separately, unable to rescue ALGO and free of a falsely assumed 1/7 observational baseline?"],
  ["07", "Reproducibility", "Can an independent reviewer reproduce every transform from the declared packet and test vectors?"],
  ["08", "Claim boundary", "Do the paper and interface avoid speed, identity, composition, mechanism and universal-resonance claims?"],
] as const;
---

<BaseLayout
  title="Method Review — NEXAH Prediction Protocol 01"
  description="Independent pre-lock method review for NEXAH Prediction Protocol 01. The forecast is not locked or activated."
  robots="noindex, follow"
>
  <main class="method-review">
    <header class="review-hero">
      <nav class="container review-breadcrumb" aria-label="Breadcrumb"><a href="/forschen/">Research</a><span>/</span><a href={`/papers/${predictionPaper.slug}/`}>Protocol 01</a><span>/</span><span aria-current="page">Method review</span></nav>
      <div class="container review-hero__grid">
        <div><p class="eyebrow">Open method review · Pre-lock packet</p><h1>Review the method<br /><em>before the prediction.</em></h1></div>
        <aside><strong>{predictionPaper.reviewRoomStatus}</strong><p>{predictionPaper.prelockReceipt.state}</p><dl><div><dt>Forecast</dt><dd>{predictionPaper.predictionStatus}</dd></div><div><dt>Study</dt><dd>NONE CREATED</dd></div><div><dt>Graph delta</dt><dd>0 / 0 / 0</dd></div></dl></aside>
      </div>
    </header>

    <section class="review-intro container">
      <div><p class="eyebrow">Review question</p><h2><span class="lang-copy lang-copy--de">Ist dieses Protokoll vor jeder Zielinspektion eindeutig, fair und falsifizierbar?</span><span class="lang-copy lang-copy--en">Is this protocol unambiguous, fair and falsifiable before any target inspection?</span></h2></div>
      <div><p class="lead"><span class="lang-copy lang-copy--de">Dieser Raum prüft ausschließlich Methode, Quellen, Lock-Felder, Unsicherheit und Auswertungslogik. Er bestätigt weder ALGO noch SLOG‑7 und aktiviert keine Vorhersage.</span><span class="lang-copy lang-copy--en">This room reviews method, sources, lock fields, uncertainty and scoring logic only. It validates neither ALGO nor SLOG-7 and activates no prediction.</span></p><p><span class="lang-copy lang-copy--de">Eine qualifizierte Rückgabe lautet <code>PASS</code>, <code>REVISE</code> oder <code>STOP</code>. Erst danach kann eine getrennte Human-Owner-Entscheidung über einen möglichen Lock erfolgen.</span><span class="lang-copy lang-copy--en">A qualified return is <code>PASS</code>, <code>REVISE</code> or <code>STOP</code>. Only then may a separate Human Owner decision consider a possible lock.</span></p></div>
    </section>

    <section class="review-packet">
      <div class="container review-grid">
        <div><p class="eyebrow">Packet identity</p><h2>Exact inputs.<br />No moving target.</h2></div>
        <dl><div><dt>Paper</dt><dd><code>{predictionPaper.source.sha256}</code></dd></div><div><dt>Preregistration</dt><dd><code>{predictionPaper.preregistration.sha256}</code></dd></div><div><dt>Pre-lock receipt</dt><dd><code>{predictionPaper.prelockReceipt.sha256}</code></dd></div><div><dt>Primary</dt><dd>ALGO · unresolved before lock</dd></div><div><dt>Secondary control</dt><dd>SLOG-7 · separately scored · no rescue</dd></div></dl>
      </div>
    </section>

    <section class="review-checklist container">
      <header><p class="eyebrow">Reviewer checklist</p><h2>Eight gates.</h2></header>
      <div>{reviewChecks.map(([number, title, question]) => <article><span>{number}</span><h3>{title}</h3><p>{question}</p></article>)}</div>
    </section>

    <section class="review-return">
      <div class="container review-grid">
        <div><p class="eyebrow">Return</p><h2>Pass, revise<br />or stop.</h2><p><span class="lang-copy lang-copy--de">Der Reviewer dokumentiert Identität, Qualifikation, Interessenkonflikt, geprüfte Hashes, Befunde und Empfehlung im Formular.</span><span class="lang-copy lang-copy--en">The reviewer records identity, qualification, conflicts, checked hashes, findings and recommendation in the form.</span></p></div>
        <div class="review-actions"><a class="button" href="/review-assets/nexah-prediction-protocol-01/REVIEW_FORM.md">Review form</a><a class="button review-contact-button" href="/contact/">Review contact</a><a class="button button--secondary" href="/review-assets/nexah-prediction-protocol-01/PRELOCK_REVIEW_RECEIPT.json">Pre-lock receipt</a><a class="button button--secondary" href={`/papers/${predictionPaper.slug}/`}>Working paper</a><a class="button button--secondary" href="/laboratory/roedelheim-observatory/measurement-gate/interstellar-entry-exit/">Instrument</a></div>
      </div>
    </section>

    <footer class="review-boundary"><div class="container"><strong>Boundary</strong><p>PUBLIC METHOD-REVIEW SURFACE · REVIEWER PENDING · PREDICTION NOT LOCKED · PREDICTION NOT ACTIVATED · NO STUDY · NO FINDING · NO CLAIM PROMOTION · GRAPH DELTA ZERO</p></div></footer>
  </main>
</BaseLayout>

<style>
  .method-review{background:#f2efe6;color:#12242a}.review-hero{padding:clamp(6rem,11vw,10rem) 0 5rem;background:radial-gradient(circle at 78% 18%,#15404a 0,transparent 34%),#071820;color:#edf2ef}.review-breadcrumb{display:flex;gap:.65rem;margin-bottom:clamp(4rem,8vw,7rem);font:700 .7rem/1.2 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:#86a2a9}.review-breadcrumb a{color:#efbd3d}.review-hero__grid,.review-grid,.review-intro{display:grid;grid-template-columns:minmax(0,.72fr) minmax(0,1.28fr);gap:clamp(2rem,7vw,7rem)}.eyebrow{color:#efbd3d;font:800 .7rem/1.4 var(--mono);letter-spacing:.12em;text-transform:uppercase}.review-hero h1,.review-intro h2,.review-packet h2,.review-checklist h2,.review-return h2{margin:1rem 0;font-size:clamp(3rem,6.5vw,6.7rem);line-height:.88;letter-spacing:-.06em}.review-hero h1 em{color:#58cbe6;font-weight:inherit}.review-hero aside{padding-left:1.5rem;border-left:1px solid #efbd3d}.review-hero aside>strong{color:#efbd3d;font:800 .72rem/1.4 var(--mono)}.review-hero aside>p{color:#a8bcc1}.review-hero dl div,.review-packet dl div{display:grid;grid-template-columns:10rem 1fr;gap:1rem;padding:.75rem 0;border-top:1px solid #34505a}.review-hero dt{color:#8ca3a9}.review-hero dd,.review-packet dd{margin:0;overflow-wrap:anywhere}.review-intro{padding-block:clamp(5rem,9vw,8rem)}.review-intro .lead{font-size:clamp(1.3rem,2.3vw,2rem);line-height:1.3}.review-packet,.review-return{padding-block:clamp(5rem,9vw,8rem);background:#0a1c23;color:#edf2ef}.review-packet dl div{border-color:#2e4a53}.review-packet dt{color:#86a4ab}.review-packet code{color:#59cae5;font-size:.72rem}.review-checklist{padding-block:clamp(5rem,9vw,8rem)}.review-checklist>div{display:grid;grid-template-columns:repeat(2,1fr);border:1px solid #aeb2ac}.review-checklist article{min-height:15rem;padding:1.5rem;border-bottom:1px solid #aeb2ac}.review-checklist article:nth-child(odd){border-right:1px solid #aeb2ac}.review-checklist span{color:#a87400;font:800 .75rem/1 var(--mono)}.review-checklist h3{font-family:var(--serif);font-size:2rem;font-weight:400}.review-checklist p{color:#52646a}.review-return p{color:#b8c8cc}.review-actions{display:flex;align-content:flex-start;gap:.8rem;flex-wrap:wrap}.review-actions .button--secondary{border-color:#80959a;color:#edf2ef;background:transparent}.review-actions .review-contact-button{border-color:#d63283;background:#e54793;color:#fff}.review-actions .review-contact-button:hover{background:#c82b76}.review-boundary{padding-block:2rem;background:#edbb3c}.review-boundary strong{font:800 .7rem/1 var(--mono);text-transform:uppercase}.review-boundary p{font:800 .72rem/1.6 var(--mono)}@media(max-width:780px){.review-hero__grid,.review-grid,.review-intro{grid-template-columns:1fr}.review-checklist>div{grid-template-columns:1fr}.review-checklist article:nth-child(odd){border-right:0}.review-hero aside{padding:1.5rem 0 0;border-top:1px solid #efbd3d;border-left:0}}
</style>
