  ["C3", "Directed structure", "180 unique recurrence edges"],
  ["C4", "Carrier integrity", "Connected and facewise Pascal recurrence"],
  ["C5", "Declared action", "Rotations and reflections form D5"],
  ["C6", "Exact typed group", "Full typed automorphism group is exactly D5"],
] as const;
