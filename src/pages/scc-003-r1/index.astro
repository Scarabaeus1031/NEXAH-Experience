<script>
  // @ts-nocheck -- browser instrument imports a published public verifier module.
  import { SCC003_STAGES, buildSCC003Stage, projectNode } from "@/lib/scc003-quotient-construction.mjs";

  const constructionNamespace = "http://www.w3.org/2000/svg";
  const constructionStages = SCC003_STAGES.map((_, index) => buildSCC003Stage(index));
  const constructionQuery = (selector) => document.querySelector(selector);
  const constructionEdges = constructionQuery("[data-construction-edges]");
  const constructionNodes = constructionQuery("[data-construction-nodes]");
  const constructionSlider = constructionQuery("[data-construction-slider]");
  const constructionPlay = constructionQuery("[data-construction-play]");
  let constructionCurrent = 0;
  let constructionTimer;

  function constructionElement(name, attributes) {
    const node = document.createElementNS(constructionNamespace, name);
    for (const [key, value] of Object.entries(attributes)) node.setAttribute(key, String(value));
    return node;
  }

  function renderConstruction(index) {
    constructionCurrent = Math.max(0, Math.min(6, index));
    const stage = constructionStages[constructionCurrent];
    const positions = new Map(stage.nodes.map((node) => [node.id, projectNode(node, constructionCurrent)]));
    constructionEdges.replaceChildren();
    constructionNodes.replaceChildren();
    stage.edges.forEach(([source, target]) => {
      const [x1, y1] = positions.get(source);
      const [x2, y2] = positions.get(target);
      constructionEdges.append(constructionElement("line", { x1, y1, x2, y2, class: "construction-edge" }));
    });
    stage.nodes.forEach((node) => {
      const [cx, cy] = positions.get(node.id);
      constructionNodes.append(constructionElement("circle", {
        cx, cy, r: node.id === "A" ? 6.2 : node.seam ? 5 : 3.9,
        class: `construction-node ${node.seam ? "construction-node--seam" : ""}`,
      }));
    });
    constructionQuery("[data-construction-step]").textContent = `Stage ${constructionCurrent} / 6`;
    constructionQuery("[data-construction-notation]").textContent = stage.notation;
    constructionQuery("[data-construction-label]").textContent = stage.label;
    const metrics = { raw: stage.rawCount, nodes: stage.nodes.length, edges: stage.edges.length, incidences: stage.incidenceCount };
    Object.entries(metrics).forEach(([key, value]) => {
      constructionQuery(`[data-construction-metric="${key}"]`).textContent = String(value);
    });
    constructionSlider.value = String(constructionCurrent);
    constructionQuery("[data-construction-previous]").disabled = constructionCurrent === 0;
    constructionQuery("[data-construction-next]").disabled = constructionCurrent === 6;
  }

  function stopConstruction() {
    clearInterval(constructionTimer);
    constructionTimer = undefined;
    constructionPlay.textContent = "Play sequence";
  }

  constructionPlay.addEventListener("click", () => {
    if (constructionTimer) return stopConstruction();
    if (constructionCurrent === 6) renderConstruction(0);
    constructionPlay.textContent = "Pause";
    constructionTimer = window.setInterval(() => {
      if (constructionCurrent === 6) return stopConstruction();
      renderConstruction(constructionCurrent + 1);
    }, window.matchMedia("(prefers-reduced-motion: reduce)").matches ? 2500 : 1400);
  });
  constructionQuery("[data-construction-previous]").addEventListener("click", () => { stopConstruction(); renderConstruction(constructionCurrent - 1); });
  constructionQuery("[data-construction-next]").addEventListener("click", () => { stopConstruction(); renderConstruction(constructionCurrent + 1); });
  constructionSlider.addEventListener("input", () => { stopConstruction(); renderConstruction(Number(constructionSlider.value)); });

  async function verifyConstruction() {
    const badge = constructionQuery("[data-construction-verification]");
    try {
      const { verifySCC003 } = await import(/* @vite-ignore */ "/review-assets/scc-003-r1/proof/scc003-proof-verifier.mjs?rev=scc003-r1-public-20261112");
      const certificate = await fetch("/review-assets/scc-003-r1/proof/scc003-proof-certificate.json").then((response) => response.json());
      const result = verifySCC003(certificate);
      const closed = constructionStages[6];
      const pass = result.status === "PASS" && result.summary.closed_nodes === closed.nodes.length && result.summary.directed_edges === closed.edges.length;
      badge.classList.toggle("pass", pass);
      badge.classList.toggle("fail", !pass);
      badge.innerHTML = `<span></span> ${pass ? "Verified · certificate agrees" : "Verification failed"}`;
    } catch {
      badge.classList.add("fail");
      badge.innerHTML = "<span></span> Verifier unavailable";
    }
  }

  renderConstruction(0);
  verifyConstruction();
</script>

