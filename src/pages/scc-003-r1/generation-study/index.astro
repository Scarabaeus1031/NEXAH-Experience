  const swingInput = document.querySelector("[data-swing-phase]");
  const swingOutput = document.querySelector("[data-swing-output]");
  const swingTicks = document.querySelector("[data-swing-ticks]");
  const swingPrimaryArm = document.querySelector('[data-swing-arm="primary"]');
  const swingOffsetArm = document.querySelector('[data-swing-arm="offset"]');
  const swingPrimaryBob = document.querySelector('[data-swing-bob="primary"]');
  const swingOffsetBob = document.querySelector('[data-swing-bob="offset"]');
  const swingOffsetArc = document.querySelector("[data-swing-offset-arc]");
  const swingOffsetLabel = document.querySelector("[data-swing-offset-label]");
  const swingNote = document.querySelector("[data-swing-note]");
  const swingCx = 380;
  const swingPivotY = 150;
  const swingLength = 350;
  const swingAmplitude = 45;
  const swingDelta = 12;

  for (let tick = 0; tick < 60; tick += 1) {
    const angle = (tick / 60 * Math.PI * 2) - Math.PI / 2;
    const outer = 286;
    const inner = tick % 15 === 0 ? 254 : tick % 5 === 0 ? 263 : 274;
    const x1 = swingCx + Math.cos(angle) * inner;
    const y1 = 360 + Math.sin(angle) * inner;
    const x2 = swingCx + Math.cos(angle) * outer;
    const y2 = 360 + Math.sin(angle) * outer;
    swingTicks?.append(make("line", { x1, y1, x2, y2, class: `swing-tick${tick % 5 === 0 ? " swing-tick--hour" : ""}${tick % 15 === 0 ? " swing-tick--quarter" : ""}` }));
  }

  const swingPoint = (degrees) => {
    const radians = degrees * Math.PI / 180;
    return [swingCx + Math.sin(radians) * swingLength, swingPivotY + Math.cos(radians) * swingLength];
  };

  const swingArcPath = (startDegrees, endDegrees, radius) => {
    const start = [swingCx + Math.sin(startDegrees * Math.PI / 180) * radius, swingPivotY + Math.cos(startDegrees * Math.PI / 180) * radius];
    const end = [swingCx + Math.sin(endDegrees * Math.PI / 180) * radius, swingPivotY + Math.cos(endDegrees * Math.PI / 180) * radius];
    return `M${start[0].toFixed(2)} ${start[1].toFixed(2)} A${radius} ${radius} 0 0 ${endDegrees > startDegrees ? 0 : 1} ${end[0].toFixed(2)} ${end[1].toFixed(2)}`;
  };

  function updateSwing() {
    if (!swingInput) return;
    const phase = Number(swingInput.value);
    const primaryAngle = swingAmplitude * Math.cos(phase * Math.PI / 180);
    const offsetAngle = swingAmplitude * Math.cos((phase + swingDelta) * Math.PI / 180);
    const primary = swingPoint(primaryAngle);
    const offset = swingPoint(offsetAngle);
    setLine(swingPrimaryArm, swingCx, swingPivotY, primary[0], primary[1]);
    setLine(swingOffsetArm, swingCx, swingPivotY, offset[0], offset[1]);
    swingPrimaryBob?.setAttribute("cx", primary[0].toFixed(2));
    swingPrimaryBob?.setAttribute("cy", primary[1].toFixed(2));
    swingOffsetBob?.setAttribute("cx", offset[0].toFixed(2));
    swingOffsetBob?.setAttribute("cy", offset[1].toFixed(2));
    swingOffsetArc?.setAttribute("d", swingArcPath(Math.min(primaryAngle, offsetAngle), Math.max(primaryAngle, offsetAngle), 78));
    const labelAngle = (primaryAngle + offsetAngle) / 2;
    const labelPoint = swingPoint(labelAngle);
    swingOffsetLabel?.setAttribute("x", (swingCx + (labelPoint[0] - swingCx) * .31 + 12).toFixed(2));
    swingOffsetLabel?.setAttribute("y", (swingPivotY + (labelPoint[1] - swingPivotY) * .31).toFixed(2));
    const separation = Math.hypot(primary[0] - offset[0], primary[1] - offset[1]);
    const kiss = separation < 8;
    const phaseRole = phase === 0 || phase === 360 ? "C / TURN" : phase === 180 ? "D / TURN" : phase < 180 ? "C → D / PASSAGE" : "D → C / RETURN";
    if (swingOutput) swingOutput.value = `${phase}° · ${kiss ? "KISS / COINCIDENCE" : phaseRole}`;
    if (swingNote) swingNote.textContent = kiss
      ? "K · SAME PROJECTION · DISTINCT PHASES"
      : "C → D → C · DISPLAY CYCLE · LINEAR τ";
  }

  swingInput?.addEventListener("input", updateSwing);
  updateSwing();

  const bodyInput = document.querySelector("[data-body-phase]");
  const bodyOutput = document.querySelector("[data-body-output]");
  const bodyRouteButtons = [...document.querySelectorAll("[data-body-route]")];
  const bodyStepButton = document.querySelector("[data-body-step]");
  const bodyTurnButton = document.querySelector("[data-body-turn]");
  const bodySnapButton = document.querySelector("[data-body-snap]");
  const bodyReturnButton = document.querySelector("[data-body-return]");
  const bodyStepAddressButtons = [...document.querySelectorAll("[data-body-step-address]")];
  const bodyBelt = document.querySelector("[data-body-belt]");
  const bodyPearl = document.querySelector("[data-body-pearl]");
  const bodyPearlLabel = document.querySelector("[data-body-pearl-label]");
  const bodyYugoVector = document.querySelector("[data-body-yugo-vector]");
  const bodyReturnRoute = document.querySelector("[data-body-return-route]");
  const bodyJoints = Object.fromEntries(["sl", "sr", "hl", "hr"].map((key) => [key, document.querySelector(`[data-body-joint="${key}"]`)]));
  const bodyRods = {
    left: document.querySelector('[data-body-rod="left"]'),
    right: document.querySelector('[data-body-rod="right"]'),
  };
  const bodyBase = {
    sl: [238, 174], sr: [522, 174], hl: [238, 546], hr: [522, 546],
  };
  let bodyRoute = "LR";
  let bodyStep = 1;

  function bodyStepRole(step) {
    if (step === 1) return "TA";
    if (step === 7) return "KINK / PHANTOM TINE";
    if (step === 10) return "FULL FAMILY";
    return "STEP";
  }

  function updateBodyKinematics() {
    if (!bodyInput) return;
    const phase = Number(bodyInput.value);
    const radians = phase * Math.PI / 180;
    const handed = bodyRoute === "LR" ? 1 : -1;
    const wave = Math.sin(radians) * handed;
    const quadrature = Math.cos(radians) * handed;
    const halfAngle = phase / 2;
    const spinorA = Math.cos(halfAngle * Math.PI / 180);
    const sheet = spinorA < -1e-10 ? "−" : "+";
    const points = {
      sl: [bodyBase.sl[0] - 18 * wave, bodyBase.sl[1] - 8 * quadrature],
      sr: [bodyBase.sr[0] + 18 * wave, bodyBase.sr[1] + 8 * quadrature],
      hl: [bodyBase.hl[0] + 14 * wave, bodyBase.hl[1] - 10 * quadrature],
      hr: [bodyBase.hr[0] - 14 * wave, bodyBase.hr[1] + 10 * quadrature],
    };
    const barycenterP = (wave + 1) / 2;
    const barycenter = [380 + 30 * quadrature, 360 + 76 * wave];

    for (const [key, point] of Object.entries(points)) {
      const base = bodyBase[key];
      const rotation = (key === "sl" || key === "hr" ? 1 : -1) * wave * 9;
      bodyJoints[key]?.setAttribute("transform", `translate(${(point[0] - base[0]).toFixed(2)} ${(point[1] - base[1]).toFixed(2)}) rotate(${rotation.toFixed(2)} ${base[0]} ${base[1]})`);
    }
    setLine(bodyRods.left, points.sl[0], points.sl[1], points.hr[0], points.hr[1]);
    setLine(bodyRods.right, points.sr[0], points.sr[1], points.hl[0], points.hl[1]);
    setLine(bodyYugoVector, 380, 360, barycenter[0], barycenter[1]);
    bodyPearl?.setAttribute("cx", barycenter[0].toFixed(2));
    bodyPearl?.setAttribute("cy", barycenter[1].toFixed(2));
    bodyPearlLabel?.setAttribute("x", (barycenter[0] + (quadrature >= 0 ? 17 : -17)).toFixed(2));
    bodyPearlLabel?.setAttribute("y", (barycenter[1] - 12).toFixed(2));
    bodyPearlLabel?.setAttribute("text-anchor", quadrature >= 0 ? "start" : "end");
    if (bodyPearlLabel) bodyPearlLabel.textContent = `WHITE PEARL · G_B(${barycenterP.toFixed(3)})`;
    bodyReturnRoute?.setAttribute("d", `M${points.hl[0].toFixed(2)} ${points.hl[1].toFixed(2)} Q300 640 380 628 Q446 612 ${barycenter[0].toFixed(2)} ${barycenter[1].toFixed(2)}`);
    bodyBelt?.setAttribute("transform", `rotate(${halfAngle.toFixed(2)} 380 360)`);
    bodyBelt?.classList.toggle("is-negative", sheet === "−");
    bodyRouteButtons.forEach((button) => button.classList.toggle("is-active", button.dataset.bodyRoute === bodyRoute));
    bodyStepAddressButtons.forEach((button) => button.classList.toggle("is-active", Number(button.dataset.bodyStepAddress) === bodyStep));
    bodyJoints.hl?.classList.toggle("is-kink", bodyStep === 7);
    const role = Math.abs(phase) === 720
      ? "720° RETURN"
      : phase >= -720 && phase <= -270
        ? "SNAP CORRIDOR"
        : Math.abs(wave) < .02
          ? "HELD AXIS"
          : wave > 0
            ? "OPEN / WIGGLE"
            : "COUNTER / RETURN";
    if (bodyOutput) bodyOutput.value = `${phase}° · ${bodyRoute} · ${sheet} SHEET · P${bodyStep} / ${bodyStepRole(bodyStep)} · G_B(${barycenterP.toFixed(3)}) · ${role}`;
  }

  bodyInput?.addEventListener("input", updateBodyKinematics);
  bodyRouteButtons.forEach((button) => button.addEventListener("click", () => {
    bodyRoute = button.dataset.bodyRoute;
    updateBodyKinematics();
  }));
  bodyStepButton?.addEventListener("click", () => {
    bodyStep = bodyStep === 10 ? 1 : bodyStep + 1;
    updateBodyKinematics();
  });
  bodyStepAddressButtons.forEach((button) => button.addEventListener("click", () => {
    bodyStep = Number(button.dataset.bodyStepAddress);
    updateBodyKinematics();
  }));
  bodyTurnButton?.addEventListener("click", () => {
    const next = Number(bodyInput?.value || 0) + 90;
    if (bodyInput) bodyInput.value = String(next > 720 ? -720 : next);
    updateBodyKinematics();
  });
  bodySnapButton?.addEventListener("click", () => {
    if (bodyInput) bodyInput.value = "-270";
    updateBodyKinematics();
  });
  bodyReturnButton?.addEventListener("click", () => {
    if (bodyInput) bodyInput.value = "720";
    updateBodyKinematics();
  });
  updateBodyKinematics();

  const rhythmPlaneButtons = [...document.querySelectorAll("[data-rhythm-plane]")];
