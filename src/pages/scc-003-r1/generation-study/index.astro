  rhythmPlaneButtons.forEach((button) => button.addEventListener("click", () => updateRhythmPlanes(button.dataset.rhythmPlane)));
  updateRhythmPlanes("all");

  const shutterSection = document.querySelector(".study-shutter");
  const shutterInput = document.querySelector("[data-shutter-fold]");
  const shutterOutput = document.querySelector("[data-shutter-output]");
  const shutterLamellae = document.querySelector("[data-shutter-lamellae]");
  const shutterShadows = document.querySelector("[data-shutter-shadows]");
  const shutterSwitches = document.querySelector("[data-shutter-switches]");
  const shutterStar = document.querySelector("[data-shutter-star]");
  const shutterElevators = document.querySelector("[data-shutter-elevators]");
  const shutterModeButtons = [...document.querySelectorAll("[data-shutter-mode]")];
  const horizonModeButtons = [...document.querySelectorAll("[data-horizon-mode]")];
  const shutterCx = 380;
  const shutterCy = 345;
  const shutterCoreRadius = 100;
  let shutterMode = "am";
  let horizonMode = "single";
  const lamellaTones = ["pink", "yellow", "green", "grey", "blue", "coral"];
  const shutterPoint = (index, radius, offset = 0) => {
    const angle = (-90 + index * 60 + offset) * Math.PI / 180;
    return [shutterCx + Math.cos(angle) * radius, shutterCy + Math.sin(angle) * radius];
  };

  for (let index = 0; index < 6; index += 1) {
    shutterLamellae.append(make("polygon", { class: `shutter-lamella shutter-lamella--${lamellaTones[index]}`, "data-shutter-lamella": index }));
    shutterShadows.append(make("line", { class: "shutter-shadow", "data-shutter-shadow": index }));
  }

  for (let hour = 1; hour <= 12; hour += 1) {
    const [innerX, innerY] = clockPoint(hour, 231);
    const [outerX, outerY] = clockPoint(hour, 255);
    const [labelX, labelY] = clockPoint(hour, 279);
    const emphasis = hour === 11 || hour === 12 || hour === 1 ? " shutter-switch--upper" : "";
    shutterSwitches.append(make("circle", { cx: innerX, cy: innerY, r: 5, class: `shutter-switch shutter-switch--am${emphasis}` }));
    shutterSwitches.append(make("circle", { cx: outerX, cy: outerY, r: 7, class: `shutter-switch shutter-switch--night${emphasis}` }));
    const label = make("text", { x: labelX, y: labelY + 4, "text-anchor": "middle", class: `shutter-hour${emphasis}` });
    label.textContent = hour === 1 ? "1 / 13" : String(hour);
    shutterSwitches.append(label);
  }

  function updateShutter() {
    const fold = Number(shutterInput.value);
    const t = fold / 100;
    shutterSection.dataset.shutterTheme = shutterMode;

    document.querySelectorAll("[data-shutter-lamella]").forEach((lamella) => {
      const index = Number(lamella.dataset.shutterLamella);
      const a = shutterPoint(index, shutterCoreRadius);
      const b = shutterPoint(index + 1, shutterCoreRadius);
      const apexRadius = shutterMode === "am" ? 115 + t * 145 : 104 - t * 72;
      const apex = shutterPoint(index, apexRadius, 30);
      lamella.setAttribute("points", `${a[0].toFixed(2)},${a[1].toFixed(2)} ${apex[0].toFixed(2)},${apex[1].toFixed(2)} ${b[0].toFixed(2)},${b[1].toFixed(2)}`);
      const shadow = document.querySelector(`[data-shutter-shadow="${index}"]`);
      setLine(shadow, apex[0], apex[1], apex[0], shutterCy + (apex[1] < shutterCy ? -16 : 16));
    });

    const starPoints = Array.from({ length: 12 }, (_, index) => {
      const radius = index % 2 === 0 ? 88 : 42 + t * 18;
      const angle = (-90 + index * 30) * Math.PI / 180;
      return `${(shutterCx + Math.cos(angle) * radius).toFixed(2)},${(shutterCy + Math.sin(angle) * radius).toFixed(2)}`;
    });
    shutterStar.setAttribute("points", starPoints.join(" "));
    shutterStar.style.opacity = shutterMode === "night" ? String(.3 + t * .7) : ".08";

    const elevatorY = 520 - t * 330;
    shutterElevators.setAttribute("transform", `translate(0 ${elevatorY.toFixed(2)})`);
    shutterOutput.value = `${fold}% · ${shutterMode === "am" ? "AM / OPEN" : "NIGHT / INWARD"}`;
    shutterModeButtons.forEach((button) => button.classList.toggle("is-active", button.dataset.shutterMode === shutterMode));
  }

  function updateHorizon(mode) {
    horizonMode = mode;
    document.querySelector(".shutter-horizon--single").classList.toggle("is-hidden", horizonMode === "double");
    document.querySelectorAll(".shutter-horizon--double").forEach((line) => line.classList.toggle("is-hidden", horizonMode === "single"));
    horizonModeButtons.forEach((button) => button.classList.toggle("is-active", button.dataset.horizonMode === horizonMode));
  }

  shutterInput.addEventListener("input", updateShutter);
  shutterModeButtons.forEach((button) => button.addEventListener("click", () => { shutterMode = button.dataset.shutterMode; updateShutter(); }));
  horizonModeButtons.forEach((button) => button.addEventListener("click", () => updateHorizon(button.dataset.horizonMode)));
  updateHorizon("single");
  updateShutter();

  const jointSection = document.querySelector(".study-joint");
  const jointTickInput = document.querySelector("[data-joint-tick]");
  const jointTickOutput = document.querySelector("[data-joint-output]");
  const jointAddress = document.querySelector("[data-joint-address]");
  const jointStageTitle = document.querySelector("[data-joint-stage-title]");
  const jointStageNote = document.querySelector("[data-joint-stage-note]");
  const jointStageButtons = [...document.querySelectorAll("[data-joint-stage-button]")];
  const jointCarriers = document.querySelector("[data-joint-carriers]");
  const jointTicks = document.querySelector("[data-joint-ticks]");
  const jointPentagon = document.querySelector("[data-joint-pentagon]");
  const jointCx = 380;
  const jointCy = 350;
  const jointNodes = [];
  const jointNeedles = [];

  for (let n = 0; n <= 6; n += 1) {
    for (let k = 0; k <= n; k += 1) jointNodes.push({ n, k });
  }

  const jointPoint = (carrier, node) => {
    const angle = (-90 + carrier * 72) * Math.PI / 180;
    const radial = 108 + node.n * 13.5;
    const tangent = (node.k - node.n / 2) * 14;
    return [
      jointCx + Math.cos(angle) * radial - Math.sin(angle) * tangent,
      jointCy + Math.sin(angle) * radial + Math.cos(angle) * tangent,
    ];
  };

  const pentagonPoints = Array.from({ length: 5 }, (_, carrier) => {
    const angle = (-90 + carrier * 72) * Math.PI / 180;
    return `${(jointCx + Math.cos(angle) * 92).toFixed(2)},${(jointCy + Math.sin(angle) * 92).toFixed(2)}`;
  });
  jointPentagon.setAttribute("points", pentagonPoints.join(" "));

  for (let carrier = 0; carrier < 5; carrier += 1) {
    const group = make("g", { class: "joint-carrier", "data-joint-carrier": carrier });
    const byAddress = new Map(jointNodes.map((node) => [`${node.n}:${node.k}`, node]));

    for (const node of jointNodes.filter(({ n }) => n < 6)) {
      for (const child of [node.k, node.k + 1]) {
        const target = byAddress.get(`${node.n + 1}:${child}`);
        const [x1, y1] = jointPoint(carrier, node);
        const [x2, y2] = jointPoint(carrier, target);
        group.append(make("line", { x1, y1, x2, y2, class: "joint-pascal-line" }));
      }
    }

    jointNodes.forEach((node, index) => {
      const [x, y] = jointPoint(carrier, node);
      group.append(make("circle", { cx: x, cy: y, r: 2.45, class: "joint-pea", "data-joint-address": index }));
    });

    const active = make("circle", { r: 7, class: "joint-active-pea" });
    const stem = make("line", { class: "joint-t-stem" });
    const crossbar = make("line", { class: "joint-t-crossbar" });
    const label = make("text", { class: "joint-t-label", "text-anchor": "middle" });
    label.textContent = `T${carrier}`;
    group.append(active, stem, crossbar, label);
    jointNeedles.push({ active, stem, crossbar, label });

    const labelAngle = (-90 + carrier * 72) * Math.PI / 180;
    const faceLabel = make("text", {
      x: jointCx + Math.cos(labelAngle) * 224,
      y: jointCy + Math.sin(labelAngle) * 224 + 4,
      class: "joint-face-label",
      "text-anchor": "middle",
    });
    faceLabel.textContent = `F${carrier}`;
    group.append(faceLabel);
    jointCarriers.append(group);
  }

  for (let tick = 0; tick < 28; tick += 1) {
    jointTicks.append(make("circle", { cx: 110 + tick * 20, cy: 646, r: 3.1, class: "joint-tick", "data-joint-tick-dot": tick }));
  }

  function updateJointTicker() {
    const tick = Number(jointTickInput.value);
    const node = jointNodes[tick];

    jointNeedles.forEach(({ active, stem, crossbar, label }, carrier) => {
      const [x, y] = jointPoint(carrier, node);
      const carrierAngle = (-90 + carrier * 72) * Math.PI / 180;
      const needleAngle = carrierAngle + Math.PI;
      const endX = x + Math.cos(needleAngle) * 34;
      const endY = y + Math.sin(needleAngle) * 34;
      const barX = -Math.sin(needleAngle) * 9;
      const barY = Math.cos(needleAngle) * 9;

      active.setAttribute("cx", x.toFixed(2));
      active.setAttribute("cy", y.toFixed(2));
      setLine(stem, x, y, endX, endY);
      setLine(crossbar, endX - barX, endY - barY, endX + barX, endY + barY);
      label.setAttribute("x", (endX + Math.cos(needleAngle) * 15).toFixed(2));
      label.setAttribute("y", (endY + Math.sin(needleAngle) * 15 + 4).toFixed(2));
    });

    document.querySelectorAll("[data-joint-tick-dot]").forEach((dot) => dot.classList.toggle("is-active", Number(dot.dataset.jointTickDot) === tick));
    jointTickOutput.value = `${tick + 1} / 28 · P(${node.n},${node.k})`;
    if (node.n === 0) {
      jointAddress.innerHTML = "<strong>APEX</strong> · q(T₀)=q(T₁)=…=q(T₄)=A · fiber size 5";
    } else if (node.k === 0 || node.k === node.n) {
      jointAddress.innerHTML = `<strong>SEAM</strong> · paired boundary classes at level ${node.n} · fiber size 2`;
    } else {
      jointAddress.innerHTML = `<strong>INTERIOR</strong> · five distinct classes I<sub>f,${node.n},${node.k}</sub>`;
    }
  }

  const jointStageCopy = {
    source: ["SOURCE · X", "5 × 28 = 140 LABELLED SOURCE INCIDENCES"],
    quotient: ["QUOTIENT · q:X→Q", "|Q| = 106 · |E| = 180 · 135 PASCAL RECURRENCES"],
    residual: ["RESIDUAL · ρ", "q ALONE RETURNS 106/140 · ρ RETAINS SOURCE MEMBERSHIP"],
    return: ["EXACT RETURN · (q,ρ)", "140/140 · 60/60 INVERSE SEAM TRANSITIONS · D5 PRESERVED"],
  };

  function updateJointStage(stage) {
    jointSection.dataset.jointStage = stage;
    jointStageTitle.textContent = jointStageCopy[stage][0];
    jointStageNote.textContent = jointStageCopy[stage][1];
    jointStageButtons.forEach((button) => {
      const isActive = button.dataset.jointStageButton === stage;
      button.classList.toggle("is-active", isActive);
      button.setAttribute("aria-pressed", String(isActive));
    });
  }

  jointTickInput.addEventListener("input", updateJointTicker);
  jointStageButtons.forEach((button) => button.addEventListener("click", () => updateJointStage(button.dataset.jointStageButton)));
  updateJointStage("source");
  updateJointTicker();

  async function verifyJointScience() {
    const state = document.querySelector("[data-joint-proof-state]");
    try {
      const [{ verifySCC003 }, certificate] = await Promise.all([
        import("/review-assets/scc-003-r1/proof/scc003-proof-verifier.mjs"),
        fetch("/review-assets/scc-003-r1/proof/scc003-proof-certificate.json").then((response) => response.json()),
      ]);
      const result = verifySCC003(certificate);
      document.querySelector('[data-joint-metric="raw"]').textContent = String(certificate.expected.raw_face_positions);
      document.querySelector('[data-joint-metric="open"]').textContent = result.summary.open_nodes.join("→");
      document.querySelector('[data-joint-metric="nodes"]').textContent = String(result.summary.closed_nodes);
      document.querySelector('[data-joint-metric="edges"]').textContent = String(result.summary.directed_edges);
      document.querySelector('[data-joint-metric="recurrences"]').textContent = String(result.summary.facewise_recurrence_checks);
      document.querySelector('[data-joint-metric="group"]').textContent = `${result.summary.typed_automorphism_group} · order ${result.summary.typed_automorphism_group_order}`;
      state.className = `joint-proof-state joint-proof-state--${result.status.toLowerCase()}`;
      state.innerHTML = `<span></span> ${result.status} · ${Object.keys(result.checks).length}/16 finite checks · ${result.failures.length} failures · witness reconstructed in browser`;
    } catch (error) {
      state.className = "joint-proof-state joint-proof-state--fail";
      state.innerHTML = "<span></span> ERROR · frozen certificate or verifier unavailable";
    }
  }

  verifyJointScience();

  const shadowInput = document.querySelector("[data-shadow-phase]");
  const shadowOutput = document.querySelector("[data-shadow-output]");
  const shadowPoint = document.querySelector("[data-shadow-point]");
  const shadowInnerArc = document.querySelector("[data-shadow-inner-arc]");
  const shadowTangent = document.querySelector("[data-shadow-tangent]");
  const shadowNormal = document.querySelector("[data-shadow-normal]");
  const shadowCast = document.querySelector("[data-shadow-cast]");
  const shadowPLabel = document.querySelector("[data-shadow-p-label]");
  const shadowTLabel = document.querySelector("[data-shadow-t-label]");
  const shadowNLabel = document.querySelector("[data-shadow-n-label]");
  const shadowILabel = document.querySelector("[data-shadow-i-label]");

  function setLine(line, x1, y1, x2, y2) {
    Object.entries({ x1, y1, x2, y2 }).forEach(([key, value]) => line.setAttribute(key, value.toFixed(2)));
  }

  function updateShadowFrame() {
    const degrees = Number(shadowInput.value);
    const theta = degrees * Math.PI / 180;
    const cx = 380;
    const cy = 365;
    const radius = 245;
    const x = cx + Math.cos(theta) * radius;
    const y = cy + Math.sin(theta) * radius;
    const tx = -Math.sin(theta);
    const ty = Math.cos(theta);
    const nx = Math.cos(theta);
    const ny = Math.sin(theta);
    const innerRadius = 210;
    const innerHalfAngle = 10 * Math.PI / 180;
    const innerStart = theta - innerHalfAngle;
    const innerEnd = theta + innerHalfAngle;
    const innerStartX = cx + Math.cos(innerStart) * innerRadius;
    const innerStartY = cy + Math.sin(innerStart) * innerRadius;
    const innerEndX = cx + Math.cos(innerEnd) * innerRadius;
    const innerEndY = cy + Math.sin(innerEnd) * innerRadius;
    const innerLabelRadius = 186;

    shadowPoint.setAttribute("cx", x.toFixed(2));
    shadowPoint.setAttribute("cy", y.toFixed(2));
    shadowInnerArc.setAttribute("d", `M${innerStartX.toFixed(2)} ${innerStartY.toFixed(2)} A${innerRadius} ${innerRadius} 0 0 1 ${innerEndX.toFixed(2)} ${innerEndY.toFixed(2)}`);
    setLine(shadowTangent, x - tx * 70, y - ty * 70, x + tx * 70, y + ty * 70);
    setLine(shadowNormal, x + nx * 30, y + ny * 30, x - nx * 285, y - ny * 285);
    setLine(shadowCast, 380, 84, x, y);
    shadowPLabel.setAttribute("x", (x + 15).toFixed(2));
    shadowPLabel.setAttribute("y", (y - 12).toFixed(2));
    shadowTLabel.setAttribute("x", (x + tx * 78).toFixed(2));
    shadowTLabel.setAttribute("y", (y + ty * 78).toFixed(2));
    shadowNLabel.setAttribute("x", (x - nx * 135 + 10).toFixed(2));
    shadowNLabel.setAttribute("y", (y - ny * 135).toFixed(2));
    shadowILabel.setAttribute("x", (cx + Math.cos(theta) * innerLabelRadius + 12).toFixed(2));
    shadowILabel.setAttribute("y", (cy + Math.sin(theta) * innerLabelRadius + 6).toFixed(2));
    shadowOutput.value = `${degrees}°`;
  }

  shadowInput.addEventListener("input", updateShadowFrame);
  updateShadowFrame();

  const medal = document.querySelector(".study-medal");
  const medalFaceButtons = [...document.querySelectorAll("[data-medal-face-button]")];
  const medalFlipButton = document.querySelector("[data-medal-flip]");
  function updateMedal(face) {
    if (!medal || !["rain", "reign"].includes(face)) return;
    medal.dataset.medalFace = face;
    medalFaceButtons.forEach((button) => {
      const active = button.dataset.medalFaceButton === face;
      button.classList.toggle("is-active", active);
      button.setAttribute("aria-pressed", String(active));
    });
  }
  medalFaceButtons.forEach((button) => button.addEventListener("click", () => updateMedal(button.dataset.medalFaceButton)));
  medalFlipButton?.addEventListener("click", () => updateMedal(medal?.dataset.medalFace === "rain" ? "reign" : "rain"));
  updateMedal("rain");

  const shadowStrands = document.querySelector("[data-shadow-strands]");
  const rivets = document.querySelector("[data-shadow-rivets]");
  const pentagonPoint = (index, scale = 1) => {
    const angle = -Math.PI / 2 + index * Math.PI * 2 / 5;
    return [380 + Math.cos(angle) * 138 * scale, 624 + Math.sin(angle) * 138 * scale];
  };
  const perimeterPoint = (position, scale) => {
    const edgePosition = position * 5;
    const edge = Math.floor(edgePosition) % 5;
    const local = edgePosition - Math.floor(edgePosition);
    const a = pentagonPoint(edge, scale);
    const b = pentagonPoint((edge + 1) % 5, scale);
    return [a[0] + (b[0] - a[0]) * local, a[1] + (b[1] - a[1]) * local];
  };
  for (let strand = 0; strand < 11; strand += 1) {
    const [endX, endY] = perimeterPoint(strand / 11, .94);
    shadowStrands.append(make("line", { x1: 380, y1: 624, x2: endX, y2: endY, class: "shadow-strand" }));
    for (let address = 1; address <= 8; address += 1) {
      const position = address / 9;
      const x = 380 + (endX - 380) * position;
      const y = 624 + (endY - 624) * position;
      rivets.append(make("circle", { cx: x, cy: y, r: 2.2, class: "shadow-rivet", "aria-label": `Strand ${strand + 1}, internal rivet ${address}` }));
    }
    rivets.append(make("circle", { cx: endX, cy: endY, r: 3.2, class: "shadow-rivet shadow-rivet--ring", "aria-label": `Strand ${strand + 1}, boundary rivet` }));
  }

  const rootGapFold = document.querySelector("[data-root-gap-fold]");
  const rootGapOffset = document.querySelector("[data-root-gap-offset]");
  const rootGapFoldOutput = document.querySelector("[data-root-gap-fold-output]");
  const rootGapOffsetOutput = document.querySelector("[data-root-gap-offset-output]");
  const rootGapProjection = document.querySelector("[data-root-gap-projection]");
  const rootGapOverlap = document.querySelector("[data-root-gap-overlap]");
  const rootGapPanelReadout = document.querySelector("[data-root-gap-panel-readout]");
  const rootGapBeta = document.querySelector("[data-root-gap-beta]");
  const rootGapDistance = document.querySelector("[data-root-gap-distance]");
  const rootGapArea = document.querySelector("[data-root-gap-area]");
  const rootGapBands = document.querySelector("[data-root-gap-bands]");

  if (rootGapFold && rootGapOffset && rootGapProjection && rootGapOverlap) {
    const hingeX = 200;
    const cell = 48;
    const triangleA = [[200, 76], [63, 327], [329, 282]];
    const triangleBOpen = [[200, 93], [68, 305], [331, 332]];
    const envelope = [[200, 106], [338, 207], [286, 370], [114, 370], [62, 207]];
    const polygonArea = (polygon) => Math.abs(polygon.reduce((sum, point, index) => {
      const next = polygon[(index + 1) % polygon.length];
      return sum + point[0] * next[1] - next[0] * point[1];
    }, 0)) / 2;
    const signedArea = (polygon) => polygon.reduce((sum, point, index) => {
      const next = polygon[(index + 1) % polygon.length];
      return sum + point[0] * next[1] - next[0] * point[1];
    }, 0) / 2;
    const ccw = (polygon) => signedArea(polygon) < 0 ? [...polygon].reverse() : [...polygon];
    const lineIntersection = (a, b, c, d) => {
      const abx = b[0] - a[0];
      const aby = b[1] - a[1];
      const cdx = d[0] - c[0];
      const cdy = d[1] - c[1];
      const denominator = abx * cdy - aby * cdx;
      if (Math.abs(denominator) < 1e-9) return b;
      const t = ((c[0] - a[0]) * cdy - (c[1] - a[1]) * cdx) / denominator;
      return [a[0] + t * abx, a[1] + t * aby];
    };
    const clipConvex = (subject, clip) => {
      let output = ccw(subject);
      const boundary = ccw(clip);
      for (let index = 0; index < boundary.length; index += 1) {
        const c = boundary[index];
        const d = boundary[(index + 1) % boundary.length];
        const input = output;
        output = [];
        const inside = (p) => (d[0] - c[0]) * (p[1] - c[1]) - (d[1] - c[1]) * (p[0] - c[0]) >= -1e-7;
        input.forEach((b, pointIndex) => {
          const a = input[(pointIndex + input.length - 1) % input.length];
          if (inside(b)) {
            if (!inside(a)) output.push(lineIntersection(a, b, c, d));
            output.push(b);
          } else if (inside(a)) {
            output.push(lineIntersection(a, b, c, d));
          }
        });
        if (!output.length) break;
      }
      return output;
    };
    const pointInside = (point, polygon) => {
      const boundary = ccw(polygon);
      return boundary.every((a, index) => {
        const b = boundary[(index + 1) % boundary.length];
        return (b[0] - a[0]) * (point[1] - a[1]) - (b[1] - a[1]) * (point[0] - a[0]) >= -1e-7;
      });
    };
    const segmentDistance = (point, a, b) => {
      const dx = b[0] - a[0];
      const dy = b[1] - a[1];
      const lengthSquared = dx * dx + dy * dy;
      const t = lengthSquared ? Math.max(0, Math.min(1, ((point[0] - a[0]) * dx + (point[1] - a[1]) * dy) / lengthSquared)) : 0;
      return Math.hypot(point[0] - (a[0] + t * dx), point[1] - (a[1] + t * dy));
    };
    const boundaryDistance = (point, polygon) => Math.min(...polygon.map((a, index) => segmentDistance(point, a, polygon[(index + 1) % polygon.length])));
    const pointsAttribute = (polygon) => polygon.map(([x, y]) => `${x.toFixed(2)},${y.toFixed(2)}`).join(" ");

    const updateRootGapLedger = () => {
      const beta = Number(rootGapFold.value);
      const epsilon = Number(rootGapOffset.value);
      const foldScale = Math.sin(beta * Math.PI / 360);
      const triangleB = triangleBOpen.map(([x, y]) => [hingeX + (x - hingeX) * foldScale + epsilon * cell, y]);
      const overlap = clipConvex(triangleA, triangleB);
      const splinterArea = [triangleA, triangleB].reduce((sum, triangle) => sum + Math.max(0, polygonArea(triangle) - polygonArea(clipConvex(triangle, envelope))), 0);
      const exteriorVertices = [...triangleA, ...triangleB].filter((point) => !pointInside(point, envelope));
      const distance = exteriorVertices.length ? Math.max(...exteriorVertices.map((point) => boundaryDistance(point, envelope))) : 0;
      const normalizedDistance = distance / cell;
      const normalizedArea = splinterArea / (cell * cell);
      const bands = normalizedDistance < 1e-9 ? 0 : Math.ceil(normalizedDistance - 1e-9);

      rootGapProjection.setAttribute("points", pointsAttribute(triangleB));
      rootGapOverlap.setAttribute("points", overlap.length >= 3 ? pointsAttribute(overlap) : "");
      rootGapFoldOutput.value = `${beta}°`;
      rootGapOffsetOutput.value = `${epsilon >= 0 ? "+" : ""}${epsilon.toFixed(2)} cell`;
      rootGapPanelReadout.textContent = `β ${beta}° · ε ${epsilon >= 0 ? "+" : ""}${epsilon.toFixed(2)} · nₛ ${bands}`;
      rootGapBeta.innerHTML = `β = ${beta}°`;
      rootGapDistance.innerHTML = `d<sub>S</sub> = ${normalizedDistance.toFixed(2)} cell`;
      rootGapArea.innerHTML = `A<sub>S</sub><sup>layer</sup> = ${normalizedArea.toFixed(2)} cell²`;
      rootGapBands.innerHTML = `n<sub>S</sub> = ${bands}`;
    };

    rootGapFold.addEventListener("input", updateRootGapLedger);
    rootGapOffset.addEventListener("input", updateRootGapLedger);
    updateRootGapLedger();
  }

  const rootGapDemoTabs = [...document.querySelectorAll("[data-root-gap-demo-tab]")];
  const rootGapDemoPanels = [...document.querySelectorAll("[data-root-gap-demo-panel]")];
  rootGapDemoTabs.forEach((button) => {
    button.addEventListener("click", () => {
      const target = button.dataset.rootGapDemoTab;
      rootGapDemoTabs.forEach((tab) => tab.setAttribute("aria-selected", String(tab === button)));
      rootGapDemoPanels.forEach((panel) => {
        const active = panel.dataset.rootGapDemoPanel === target;
        panel.hidden = !active;
        panel.classList.toggle("is-active", active);
      });
    });
  });
</script>

