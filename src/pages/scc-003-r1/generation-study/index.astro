import BaseLayout from "@/layouts/BaseLayout.astro";

const proofFreezeHash = "dbab929c5658f9949c0ff5424bba722a27f510a0c399c5c41e9058a0cbaf09e4";

const gcd = (a: number, b: number): number => b === 0 ? Math.abs(a) : gcd(b, a % b);
const isPrime = (n: number): boolean => {
  if (n < 2) return false;
  for (let divisor = 2; divisor * divisor <= n; divisor += 1) {
    if (n % divisor === 0) return false;
  }
  return true;
};
const smallestFactor = (n: number): number => {
  for (let divisor = 2; divisor * divisor <= n; divisor += 1) {
    if (n % divisor === 0) return divisor;
  }
  return n;
};
const primeBalanceBlocks = [
  { start: 1000, end: 1120 },
  { start: 1120, end: 1240 },
  { start: 1240, end: 1360 },
].map(({ start, end }) => {
  const candidates = Array.from({ length: end - start }, (_, index) => start + index)
    .filter((value) => gcd(value, 30) === 1);
  const primes = candidates.filter(isPrime);
  return {
    start,
    end,
    candidates,
    primes,
    stops: candidates.filter((value) => !isPrime(value)),
    gaps: primes.slice(1).map((value, index) => value - primes[index]),
  };
});
const extendedBalancePrimes = Array.from({ length: 240 }, (_, index) => 1120 + index).filter(isPrime);
const extendedBalanceGaps = extendedBalancePrimes.slice(1).map((value, index) => value - extendedBalancePrimes[index]);
const extendedGapFrequency = [...new Set(extendedBalanceGaps)]
  .sort((left, right) => left - right)
  .map((gap) => ({ gap, count: extendedBalanceGaps.filter((value) => value === gap).length }));
const wheel120Control = Array.from({ length: 120 }, (_, residue) => ({
  residue,
  open: gcd(residue, 30) === 1,
}));
