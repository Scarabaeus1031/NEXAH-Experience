<script is:inline>
  const ns = "http://www.w3.org/2000/svg";
  const make = (name, attributes = {}) => {
    const element = document.createElementNS(ns, name);
    Object.entries(attributes).forEach(([key, value]) => element.setAttribute(key, String(value)));
    return element;
  };

  function pascalCarrier(group, cx, baseline, scale = 1) {
    const points = [];
    for (let n = 0; n <= 6; n += 1) {
      for (let k = 0; k <= n; k += 1) points.push({ n, k, x: cx + (k - n / 2) * 9 * scale, y: baseline - (6 - n) * 9 * scale });
    }
    const byAddress = new Map(points.map((point) => [`${point.n}:${point.k}`, point]));
    for (const point of points.filter(({ n }) => n < 6)) {
      for (const child of [point.k, point.k + 1]) {
        const target = byAddress.get(`${point.n + 1}:${child}`);
        group.append(make("line", { x1: point.x, y1: point.y, x2: target.x, y2: target.y, class: "pascal-line" }));
      }
    }
    for (const point of points) group.append(make("circle", { cx: point.x, cy: point.y, r: 1.8 * scale, class: "pascal-node" }));
  }

  const ground = document.querySelector("[data-ground-carriers]");
  [64, 137, 210, 283, 356].forEach((x) => pascalCarrier(ground, x, 347, .82));

  function axisNodes(selector, ys, radius, className) {
    const group = document.querySelector(selector);
    ys.forEach((y) => group.append(make("circle", { cx: 210, cy: y, r: radius, class: className })));
  }
  axisNodes("[data-axis-lower]", [348, 318, 288], 8, "axis-node axis-node--lower");
  axisNodes("[data-axis-upper]", [246, 218, 190, 162, 134, 106], 5, "axis-node axis-node--upper");

  const generationFins = document.querySelector("[data-generation-fins]");
  [-2, -1, 0, 1, 2].forEach((offset) => generationFins.append(make("line", { x1: 210, y1: 215, x2: 210 + offset * 58, y2: offset % 2 === 0 ? 47 : 91, class: "generation-fin" })));

  const assemblyFins = document.querySelector("[data-assembly-fins]");
  const assemblyCenter = [380, 365];
  const ring = Array.from({ length: 5 }, (_, index) => {
    const angle = -Math.PI / 2 + index * Math.PI * 2 / 5;
    return [assemblyCenter[0] + Math.cos(angle) * 252, assemblyCenter[1] + Math.sin(angle) * 94];
  });
  ring.forEach(([x, y], index) => {
    const next = ring[(index + 1) % 5];
    assemblyFins.append(make("polygon", { points: `380,73 ${x},${y} ${next[0]},${next[1]} 380,600`, class: "assembly-fin" }));
    assemblyFins.append(make("line", { x1: 380, y1: 73, x2: x, y2: y, class: "assembly-seam" }));
    assemblyFins.append(make("line", { x1: 380, y1: 600, x2: x, y2: y, class: "assembly-seam assembly-seam--lower" }));
  });
  const lowerGroup = document.querySelector("[data-assembly-lower]");
  [535, 565, 595].forEach((y) => lowerGroup.append(make("circle", { cx: 380, cy: y, r: 9, class: "axis-node axis-node--lower" })));
  const upperGroup = document.querySelector("[data-assembly-upper]");
  [253, 223, 193, 163, 133, 103].forEach((y) => upperGroup.append(make("circle", { cx: 380, cy: y, r: 6, class: "axis-node axis-node--upper" })));

  const sealInput = document.querySelector("[data-seal-angle]");
  const sealOutput = document.querySelector("[data-seal-output]");
  const sealGate = document.querySelector("[data-seal-gate]");
  const sealEquation = document.querySelector("[data-seal-equation]");
  const sealTriangles = document.querySelector("[data-seal-triangles]");
  const sealAperture = document.querySelector("[data-seal-aperture]");
  const sealCx = 380;
  const sealCy = 318;
  const sealRadius = 180;
  const sealVertex = (index) => {
    const angle = (-90 + index * 60) * Math.PI / 180;
    return [sealCx + Math.cos(angle) * sealRadius, sealCy + Math.sin(angle) * sealRadius];
  };

  for (let sector = 0; sector < 6; sector += 1) {
    const caro = sector < 2 ? "a" : sector < 4 ? "b" : "missing";
    const triangle = make("polygon", { class: `seal-triangle seal-triangle--${caro}`, "data-seal-sector": sector });
    sealTriangles.append(triangle);
  }

  function updateSealGate() {
    const degrees = Number(sealInput.value);
    const radians = degrees * Math.PI / 180;
    const apertureRadius = degrees / 45 * 60;
    const innerPoints = [];

    sealTriangles.querySelectorAll("[data-seal-sector]").forEach((triangle) => {
      const sector = Number(triangle.dataset.sealSector);
      const a = sealVertex(sector);
      const b = sealVertex(sector + 1);
      const bisector = (-60 + sector * 60) * Math.PI / 180;
      const inner = [sealCx + Math.cos(bisector) * apertureRadius, sealCy + Math.sin(bisector) * apertureRadius];
      innerPoints.push(inner);
      triangle.setAttribute("points", `${inner[0].toFixed(2)},${inner[1].toFixed(2)} ${a[0].toFixed(2)},${a[1].toFixed(2)} ${b[0].toFixed(2)},${b[1].toFixed(2)}`);
    });

    sealAperture.setAttribute("points", innerPoints.map(([x, y]) => `${x.toFixed(2)},${y.toFixed(2)}`).join(" "));
    const state = degrees === 0 ? "SEAL / FLAT" : degrees === 45 ? "√i / OPEN" : "OPENING";
    sealOutput.value = `${degrees}° · ${state}`;
    sealGate.innerHTML = `q(${degrees}°) = e<sup>i·${degrees}°</sup>`;
    sealEquation.textContent = degrees === 45
      ? "α = 45° · q(α) = √i = (1 + i) / √2"
      : `α = ${degrees}° · q(α) = cos α + i sin α`;
    sealAperture.style.opacity = String(Math.sin(radians));
  }

  sealInput.addEventListener("input", updateSealGate);
  updateSealGate();

  const dodecaStations = document.querySelector("[data-dodeca-stations]");
  const dodecaRays = document.querySelector("[data-dodeca-rays]");
  const dodecaAddresses = document.querySelector("[data-dodeca-addresses]");
  const dodecaButtons = [...document.querySelectorAll("[data-dodeca-mode]")];
  const dodecaCx = 380;
  const dodecaCy = 345;
  const clockPoint = (hour, radius) => {
    const angle = (hour / 12 * Math.PI * 2) - Math.PI / 2;
    return [dodecaCx + Math.cos(angle) * radius, dodecaCy + Math.sin(angle) * radius];
  };

  for (let hour = 1; hour <= 12; hour += 1) {
    const [outerX, outerY] = clockPoint(hour, 235);
    const [innerX, innerY] = clockPoint(hour, 182);
    const [labelX, labelY] = clockPoint(hour, 267);
    dodecaStations.append(make("line", { x1: innerX, y1: innerY, x2: outerX, y2: outerY, class: "dodeca-station-line" }));
    dodecaStations.append(make("circle", { cx: innerX, cy: innerY, r: 4, class: "dodeca-station-pin" }));
    dodecaStations.append(make("circle", { cx: outerX, cy: outerY, r: 6, class: "dodeca-station-hole" }));
    const label = make("text", { x: labelX, y: labelY + 4, "text-anchor": "middle", class: "dodeca-hour" });
    label.textContent = hour;
    dodecaStations.append(label);
  }

  const dodecaData = [
    { value: 17, hour: 5, radius: 182, kind: "pin", tone: "coral", dx: 18, dy: 3 },
    { value: 29, hour: 5, radius: 235, kind: "hole", tone: "ice", dx: 17, dy: 18 },
    { value: 19, hour: 7, radius: 182, kind: "pin", tone: "gold", dx: -58, dy: 3 },
  ];

  dodecaData.forEach(({ value, hour, radius, kind, tone, dx, dy }) => {
    const [x, y] = clockPoint(hour, radius);
    const ray = make("line", { x1: dodecaCx, y1: dodecaCy, x2: x, y2: y, class: `dodeca-active-ray dodeca-active-ray--${tone}`, "data-dodeca-value": value });
    dodecaRays.append(ray);
    const group = make("g", { class: `dodeca-address dodeca-address--${tone}`, "data-dodeca-value": value });
    group.append(make("circle", { cx: x, cy: y, r: kind === "hole" ? 13 : 10, class: `dodeca-address-marker dodeca-address-marker--${kind}` }));
    const number = make("text", { x: x + dx, y: y + dy, class: "dodeca-address-label" });
    number.textContent = `${value} · ${hour}h`;
    group.append(number);
    dodecaAddresses.append(group);
  });

  function updateDodeca(mode) {
    dodecaButtons.forEach((button) => button.classList.toggle("is-active", button.dataset.dodecaMode === mode));
    document.querySelectorAll("[data-dodeca-value]").forEach((element) => {
      element.classList.toggle("is-muted", mode !== "all" && element.dataset.dodecaValue !== mode);
    });
  }

  dodecaButtons.forEach((button) => button.addEventListener("click", () => updateDodeca(button.dataset.dodecaMode)));
