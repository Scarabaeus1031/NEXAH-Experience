---
import BaseLayout from "@/layouts/BaseLayout.astro";

const rooms = [
  ["01", "One Carrier · Seven Views", "One source can support several declared views."],
  ["02", "Thread Loom", "A translation trace keeps what was carried, transformed and lost visible."],
  ["03", "3+1 Dual Belt", "Inside, outside, direction, seam and return remain distinguishable."],
  ["04", "MIWA · Aperture · Andromeda", "Named frames keep observer position and projection explicit."],
  ["05", "Root Space 8 → 16", "A finite carrier is separated from what its lifted representation introduces."],
  ["06", "Tessarec · Qι Pearl", "Cut, aperture, local address and return close the bounded sequence."],
] as const;
---

<BaseLayout
  title="Rödelheim Observatory — NEXAH Laboratory"
  description="Six source-bound rooms for inspecting view, translation, frame, state lift, aperture and Human Return."
>
  <header class="observatory-hero container">
    <p class="eyebrow">NEXAH Laboratory · Rödelheim Observatory</p>
    <h1>One source.<br />Several views.<br />Explicit return.</h1>
    <p class="lead">A bounded public window into six existing representation instruments. The Observatory compares declared views; it does not turn visual similarity into common identity or scientific proof.</p>
  </header>

  <section class="observatory-rooms container" aria-labelledby="rooms-title">
    <header>
      <p class="eyebrow">Six-room release cut</p>
      <h2 id="rooms-title">A movement through difference.</h2>
    </header>
    <ol>
      {rooms.map(([number, title, description]) => (
        <li>
          <span>{number}</span>
          <h3>{title}</h3>
          <p>{description}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="observatory-instrument container" aria-labelledby="observer-lens-title">
    <div class="observatory-instrument__mark" aria-hidden="true"><span></span><i>Q</i></div>
    <div>
      <p class="eyebrow">Live instrument · source-bound A0 lens</p>
      <h2 id="observer-lens-title">The Observer<br />Lens.</h2>
      <p class="observatory-instrument__lead">Five stations move from source through relation, boundary and fold to Return. Newton, Leibniz and Goethe remain distinct readings inside one declared observation frame.</p>
      <p>Light, shadow, sound and echo form an interactive journey. The instrument is a comparison and orientation surface—not a calibrated optics experiment or a new theory of light.</p>
      <a class="button" href="/laboratory/roedelheim-observatory/observer-lens/">Open the Observer Lens</a>
    </div>
  </section>

  <section class="observatory-extension container" aria-labelledby="extension-title">
    <div>
      <p class="eyebrow">Extended sequence · source-bound lens</p>
      <h2 id="extension-title">The Generation<br />Corner.</h2>
    </div>
    <div>
      <p class="observatory-extension__lead">Follow the local Q° observer axis through cut, relation, intervention, generation, source and court. The grammar returns. The world-state does not.</p>
      <p>This guided sequence composes existing Orientation Demonstrator and Five H material without creating a new scientific identity or completing the incomplete historical series.</p>
      <a class="button" href="/laboratory/roedelheim-observatory/generation-corner/">Follow the Q° axis <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <aside class="observatory-return container">
    <div><p class="eyebrow">Claim ceiling</p><h2>An Observatory is a way of looking—not the object looked at.</h2></div>
    <div>
      <p>The selected rooms are documentary and representational instruments. They make frames, cuts and residuals inspectable. They do not establish an ephemeris, physical coupling, universal operator or literal higher-dimensional object.</p>
      <nav aria-label="Observatory returns">
        <a class="button" href="/how-nexah-works/">Return to the NEXAH method</a>
        <a class="text-link" href="https://www.scarabaeus1033.net/observatory">Visit the Scarabäus studio window ↗</a>
      </nav>
    </div>
  </aside>
</BaseLayout>

<style>
  .observatory-hero{padding-block:clamp(5rem,10vw,11rem)}
  .observatory-hero h1{max-width:12ch;margin:.6rem 0 2rem;font-family:var(--font-display);font-size:clamp(3.6rem,8vw,9rem);font-weight:500;letter-spacing:-.055em;line-height:.87}
  .observatory-hero .lead{max-width:48rem}
  .observatory-rooms{padding-block:clamp(4rem,8vw,8rem);border-block:1px solid var(--color-line)}
  .observatory-rooms h2,.observatory-return h2{max-width:14ch;margin:.4rem 0 0;font-family:var(--font-display);font-size:clamp(2.6rem,5vw,5.6rem);font-weight:500;line-height:.94}
  .observatory-rooms ol{display:grid;grid-template-columns:repeat(3,1fr);margin:3.5rem 0 0;padding:0;list-style:none}
  .observatory-rooms li{min-height:18rem;padding:1.4rem;border:1px solid var(--color-line);margin:-1px 0 0 -1px}
  .observatory-rooms span{font-family:var(--font-mono);font-size:.68rem;letter-spacing:.14em}
  .observatory-rooms h3{margin:5rem 0 .8rem;font-family:var(--font-display);font-size:1.8rem;line-height:1}
  .observatory-rooms p,.observatory-return p{line-height:1.65}
  .observatory-instrument{display:grid;grid-template-columns:minmax(18rem,.85fr) minmax(0,1fr);gap:clamp(2rem,7vw,8rem);align-items:center;padding-block:clamp(5rem,9vw,9rem);border-bottom:1px solid var(--color-line)}
  .observatory-instrument h2{max-width:10ch;margin:.4rem 0 1.5rem;font-family:var(--font-display);font-size:clamp(3rem,6vw,6.4rem);font-weight:500;letter-spacing:-.045em;line-height:.86}
  .observatory-instrument__lead{font-size:clamp(1.15rem,2vw,1.45rem);line-height:1.45}
  .observatory-instrument .button{margin-top:1.25rem}
  .observatory-instrument__mark{position:relative;width:min(26rem,78vw);aspect-ratio:1;justify-self:center;border:2px solid #f15bb5;border-radius:50%}
  .observatory-instrument__mark::before{position:absolute;inset:22%;border:2px solid #42cde2;border-radius:50%;content:""}
  .observatory-instrument__mark span{position:absolute;top:50%;left:8%;width:84%;border-top:2px solid #e9b541;transform:rotate(-22deg)}
  .observatory-instrument__mark i{position:absolute;top:50%;left:50%;display:grid;width:3.2rem;aspect-ratio:1;place-items:center;transform:translate(-50%,-50%);border-radius:50%;background:#071923;color:#fff;font:700 1rem/1 var(--font-mono)}
  .observatory-extension{display:grid;grid-template-columns:minmax(0,1fr) minmax(18rem,.85fr);gap:clamp(2rem,7vw,8rem);padding-block:clamp(5rem,9vw,9rem);border-bottom:1px solid var(--color-line)}
  .observatory-extension h2{max-width:12ch;margin:.4rem 0 0;font-family:var(--font-display);font-size:clamp(3rem,6vw,6.4rem);font-weight:500;letter-spacing:-.045em;line-height:.86}
  .observatory-extension__lead{font-size:clamp(1.15rem,2vw,1.45rem);line-height:1.45}
  .observatory-extension .button{margin-top:1.25rem}
  .observatory-return{display:grid;grid-template-columns:minmax(0,1fr) minmax(18rem,.85fr);gap:clamp(2rem,7vw,8rem);padding-block:clamp(5rem,9vw,9rem)}
  .observatory-return nav{display:flex;flex-wrap:wrap;align-items:center;gap:1.25rem;margin-top:2rem}
  @media(max-width:800px){.observatory-rooms ol{grid-template-columns:1fr 1fr}.observatory-instrument,.observatory-extension,.observatory-return{grid-template-columns:1fr}}
  @media(max-width:520px){.observatory-rooms ol{grid-template-columns:1fr}.observatory-rooms h3{margin-top:3rem}}
</style>
