---
import BaseLayout from "@/layouts/BaseLayout.astro";

const rooms = [
  ["01", "One Carrier · Seven Views", "One source can support several declared views."],
  ["02", "Thread Loom", "A translation trace keeps what was carried, transformed and lost visible."],
  ["03", "3+1 Dual Belt", "Inside, outside, direction, seam and return remain distinguishable."],
  ["04", "MIWA · Aperture · Andromeda", "Named frames keep observer position and projection explicit."],
  ["05", "Root Space 8 → 16", "A finite carrier is separated from what its lifted representation introduces."],
  ["06", "Tessarec · Qι Pearl", "Cut, aperture, local address and return close the bounded sequence."],
] as const;
---

<BaseLayout
  title="Rödelheim Observatory — NEXAH Laboratory"
  description="Six source-bound rooms for inspecting view, translation, frame, state lift, aperture and Human Return."
>
  <header class="observatory-hero container">
    <p class="eyebrow">NEXAH Laboratory · Rödelheim Observatory</p>
    <h1>One source.<br />Several views.<br />Explicit return.</h1>
    <p class="lead">A bounded public window into six existing representation instruments. The Observatory compares declared views; it does not turn visual similarity into common identity or scientific proof.</p>
  </header>

  <section class="observatory-rooms container" aria-labelledby="rooms-title">
    <header>
      <p class="eyebrow">Six-room release cut</p>
      <h2 id="rooms-title">A movement through difference.</h2>
    </header>
    <ol>
      {rooms.map(([number, title, description]) => (
        <li>
          <span>{number}</span>
          <h3>{title}</h3>
          <p>{description}</p>
        </li>
      ))}
    </ol>
  </section>

  <aside class="observatory-return container">
    <div><p class="eyebrow">Claim ceiling</p><h2>An Observatory is a way of looking—not the object looked at.</h2></div>
    <div>
      <p>The selected rooms are documentary and representational instruments. They make frames, cuts and residuals inspectable. They do not establish an ephemeris, physical coupling, universal operator or literal higher-dimensional object.</p>
      <nav aria-label="Observatory returns">
        <a class="button" href="/how-nexah-works/">Return to the NEXAH method</a>
        <a class="text-link" href="https://www.scarabaeus1033.net/observatory">Visit the Scarabäus studio window ↗</a>
      </nav>
    </div>
  </aside>
</BaseLayout>

<style>
  .observatory-hero{padding-block:clamp(5rem,10vw,11rem)}
  .observatory-hero h1{max-width:12ch;margin:.6rem 0 2rem;font-family:var(--font-display);font-size:clamp(3.6rem,8vw,9rem);font-weight:500;letter-spacing:-.055em;line-height:.87}
  .observatory-hero .lead{max-width:48rem}
  .observatory-rooms{padding-block:clamp(4rem,8vw,8rem);border-block:1px solid var(--color-line)}
  .observatory-rooms h2,.observatory-return h2{max-width:14ch;margin:.4rem 0 0;font-family:var(--font-display);font-size:clamp(2.6rem,5vw,5.6rem);font-weight:500;line-height:.94}
  .observatory-rooms ol{display:grid;grid-template-columns:repeat(3,1fr);margin:3.5rem 0 0;padding:0;list-style:none}
  .observatory-rooms li{min-height:18rem;padding:1.4rem;border:1px solid var(--color-line);margin:-1px 0 0 -1px}
  .observatory-rooms span{font-family:var(--font-mono);font-size:.68rem;letter-spacing:.14em}
  .observatory-rooms h3{margin:5rem 0 .8rem;font-family:var(--font-display);font-size:1.8rem;line-height:1}
  .observatory-rooms p,.observatory-return p{line-height:1.65}
  .observatory-return{display:grid;grid-template-columns:minmax(0,1fr) minmax(18rem,.85fr);gap:clamp(2rem,7vw,8rem);padding-block:clamp(5rem,9vw,9rem)}
  .observatory-return nav{display:flex;flex-wrap:wrap;align-items:center;gap:1.25rem;margin-top:2rem}
  @media(max-width:800px){.observatory-rooms ol{grid-template-columns:1fr 1fr}.observatory-return{grid-template-columns:1fr}}
  @media(max-width:520px){.observatory-rooms ol{grid-template-columns:1fr}.observatory-rooms h3{margin-top:3rem}}
</style>
