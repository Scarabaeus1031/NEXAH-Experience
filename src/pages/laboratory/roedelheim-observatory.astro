---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { roedelheimRooms } from "@/data/roedelheim-rooms";
---

<BaseLayout
  title="Rödelheim Observatory — NEXAH Laboratory"
  description="A local window into nested celestial motion, followed by source-bound instruments for view, cut, translation and Human Return."
>
  <header class="observatory-hero">
    <div class="observatory-hero__visual" aria-hidden="true">
      <svg viewBox="0 0 1200 760" role="presentation">
        <defs>
          <radialGradient id="observatory-sky" cx="50%" cy="48%" r="62%">
            <stop offset="0" stop-color="#123243" />
            <stop offset=".56" stop-color="#081b27" />
            <stop offset="1" stop-color="#040d14" />
          </radialGradient>
          <linearGradient id="observatory-horizon" x1="0" x2="1">
            <stop offset="0" stop-color="#42cde2" stop-opacity="0" />
            <stop offset=".5" stop-color="#42cde2" stop-opacity=".84" />
            <stop offset="1" stop-color="#42cde2" stop-opacity="0" />
          </linearGradient>
          <filter id="observatory-glow" x="-40%" y="-40%" width="180%" height="180%">
            <feGaussianBlur stdDeviation="7" />
          </filter>
        </defs>
        <rect width="1200" height="760" fill="url(#observatory-sky)" />
        <g class="observatory-hero__stars" fill="#dce8ee">
          <circle cx="112" cy="132" r="2" /><circle cx="242" cy="211" r="1.5" /><circle cx="358" cy="91" r="2.4" />
          <circle cx="884" cy="119" r="1.7" /><circle cx="1018" cy="206" r="2.2" /><circle cx="1091" cy="92" r="1.4" />
          <circle cx="103" cy="472" r="1.5" /><circle cx="1080" cy="499" r="1.8" /><circle cx="947" cy="342" r="1.4" />
        </g>
        <g class="observatory-hero__clocks" fill="none">
          <ellipse cx="600" cy="385" rx="440" ry="178" stroke="#42cde2" stroke-opacity=".34" />
          <ellipse cx="600" cy="385" rx="357" ry="250" stroke="#f15bb5" stroke-opacity=".44" transform="rotate(-17 600 385)" />
          <ellipse cx="600" cy="385" rx="277" ry="322" stroke="#e9b541" stroke-opacity=".58" transform="rotate(31 600 385)" />
          <ellipse cx="600" cy="385" rx="194" ry="118" stroke="#dce8ee" stroke-opacity=".38" transform="rotate(-38 600 385)" />
          <path d="M600 52V718M162 385H1038" stroke="#dce8ee" stroke-opacity=".1" />
        </g>
        <g class="observatory-hero__window" fill="none" stroke="#dce8ee">
          <path d="M382 124H818V646H382Z" stroke-opacity=".25" />
          <path d="M600 124V646M382 385H818" stroke-opacity=".13" />
        </g>
        <path d="M101 507Q600 298 1099 507" fill="none" stroke="url(#observatory-horizon)" stroke-width="2" />
        <circle cx="600" cy="385" r="9" fill="#e9b541" />
        <circle cx="600" cy="385" r="27" fill="#e9b541" opacity=".16" filter="url(#observatory-glow)" />
      </svg>
    </div>
    <div class="observatory-hero__copy container">
      <p class="eyebrow">NEXAH Laboratory · Rödelheim Observatory</p>
      <h1><span class="lang-copy lang-copy--de">Ein lokales Fenster in verschachtelte Himmelsbewegung.</span><span class="lang-copy lang-copy--en">A local window into nested celestial motion.</span></h1>
      <p class="observatory-hero__score"><span class="lang-copy lang-copy--de">Der Himmel folgt nicht nur einer Uhr.<br />Er ist eine Partitur verschachtelter Uhren.</span><span class="lang-copy lang-copy--en">The sky is not one clock.<br />It is a score of nested clocks.</span></p>
      <p class="observatory-hero__boundary"><span class="lang-copy lang-copy--de">Eine begrenzte Position. Mehrere deklarierte Ansichten. Ein expliziter Return.</span><span class="lang-copy lang-copy--en">One bounded position. Several declared views. An explicit return.</span></p>
      <a class="button observatory-hero__action" href="#observatory-instruments"><span class="lang-copy lang-copy--de">Das Observatorium betreten</span><span class="lang-copy lang-copy--en">Enter the Observatory</span> <span aria-hidden="true">↓</span></a>
    </div>
  </header>

  <section id="observatory-instruments" class="observatory-instruments" aria-labelledby="instruments-title">
    <header class="observatory-instruments__header container">
      <p class="eyebrow"><span class="lang-copy lang-copy--de">Interaktive Instrumente</span><span class="lang-copy lang-copy--en">Live instruments</span></p>
      <h2 id="instruments-title"><span class="lang-copy lang-copy--de">Durch eine deklarierte Ansicht eintreten.</span><span class="lang-copy lang-copy--en">Enter through a declared view.</span></h2>
      <p><span class="lang-copy lang-copy--de">Jedes Instrument legt seinen Rahmen, seinen Schnitt und seinen Rückweg offen. Beginnen Sie mit der zentralen Linse und folgen Sie anschließend der erweiterten Beobachtersequenz.</span><span class="lang-copy lang-copy--en">Each instrument exposes its frame, its cut and its route back. Begin with the principal lens; continue into the extended observer sequence.</span></p>
    </header>

    <article class="observatory-instrument container" aria-labelledby="observer-lens-title">
      <div class="observatory-instrument__mark" aria-hidden="true"><span></span><i>Q</i></div>
      <div>
        <p class="eyebrow"><span class="lang-copy lang-copy--de">01 · Zentrales interaktives Instrument · quellgebundene A0-Linse</span><span class="lang-copy lang-copy--en">01 · Principal live instrument · source-bound A0 lens</span></p>
        <h2 id="observer-lens-title">The Observer<br />Lens.</h2>
        <p class="observatory-instrument__lead"><span class="lang-copy lang-copy--de">Fünf Stationen führen von der Quelle über Relation, Grenze und Faltung zum Return. Newton, Leibniz und Goethe bleiben unterschiedliche Lesarten innerhalb eines deklarierten Beobachtungsrahmens.</span><span class="lang-copy lang-copy--en">Five stations move from source through relation, boundary and fold to Return. Newton, Leibniz and Goethe remain distinct readings inside one declared observation frame.</span></p>
        <p><span class="lang-copy lang-copy--de">Licht, Schatten, Klang und Echo bilden eine interaktive Reise. Das Instrument ist eine Vergleichs- und Orientierungsfläche – kein kalibriertes Optikexperiment und keine neue Theorie des Lichts.</span><span class="lang-copy lang-copy--en">Light, shadow, sound and echo form an interactive journey. The instrument is a comparison and orientation surface—not a calibrated optics experiment or a new theory of light.</span></p>
        <a class="button" href="/laboratory/roedelheim-observatory/observer-lens/"><span class="lang-copy lang-copy--de">Observer Lens öffnen</span><span class="lang-copy lang-copy--en">Open the Observer Lens</span></a>
      </div>
    </article>

    <article class="observatory-extension container" aria-labelledby="extension-title">
      <div>
        <p class="eyebrow"><span class="lang-copy lang-copy--de">02 · Erweiterte Sequenz · quellgebundene Linse</span><span class="lang-copy lang-copy--en">02 · Extended sequence · source-bound lens</span></p>
        <h2 id="extension-title">The Generation<br />Corner.</h2>
      </div>
      <div>
        <p class="observatory-extension__lead"><span class="lang-copy lang-copy--de">Folgen Sie der lokalen Q°-Beobachterachse durch Schnitt, Relation, Eingriff, Erzeugung, Quelle und Court. Die Grammatik kehrt zurück. Der Weltzustand nicht.</span><span class="lang-copy lang-copy--en">Follow the local Q° observer axis through cut, relation, intervention, generation, source and court. The grammar returns. The world-state does not.</span></p>
        <p><span class="lang-copy lang-copy--de">Diese geführte Sequenz verbindet vorhandenes Material aus dem Orientation Demonstrator und Five H, ohne eine neue wissenschaftliche Identität zu erzeugen oder die unvollständige historische Reihe nachträglich zu vervollständigen.</span><span class="lang-copy lang-copy--en">This guided sequence composes existing Orientation Demonstrator and Five H material without creating a new scientific identity or completing the incomplete historical series.</span></p>
        <a class="button button--secondary" href="/laboratory/roedelheim-observatory/generation-corner/"><span class="lang-copy lang-copy--de">Der Q°-Achse folgen</span><span class="lang-copy lang-copy--en">Follow the Q° axis</span> <span aria-hidden="true">→</span></a>
      </div>
    </article>

    <article class="observatory-extension observatory-extension--measurement container" aria-labelledby="measurement-gate-title">
      <div>
        <p class="eyebrow"><span class="lang-copy lang-copy--de">03 · Measurement Gate · quellgebundener lokaler Kandidat</span><span class="lang-copy lang-copy--en">03 · Measurement Gate · source-bound local candidate</span></p>
        <h2 id="measurement-gate-title">The Measurement<br />Gate.</h2>
      </div>
      <div>
        <p class="observatory-extension__lead"><span class="lang-copy lang-copy--de">Quelle, Größentyp, Einheit, Referenz, Schnitt und Return bleiben miteinander verbunden. Ein Wert erscheint nie ohne seine Messadresse.</span><span class="lang-copy lang-copy--en">Source, quantity type, unit, reference, cut and Return remain attached. A value never appears without its measurement address.</span></p>
        <p><span class="lang-copy lang-copy--de">Fünf Fälle führen durch Deklaration, Darstellung und Receipt. ED₁₃₈ bleibt dabei ein quellgebundener Kandidat. Das Fieldbook rekonstruiert die geprüfte Methode des Clockwork-Intake, ohne seine offenen Tafeln zu physikalischen Behauptungen zu machen.</span><span class="lang-copy lang-copy--en">Five cases move through declaration, representation and receipt. ED₁₃₈ remains a source-bound candidate. The fieldbook reconstructs the reviewed method of the Clockwork intake without turning its open plates into physical claims.</span></p>
        <a class="button button--secondary" href="/laboratory/roedelheim-observatory/measurement-gate/"><span class="lang-copy lang-copy--de">Measurement Gate öffnen</span><span class="lang-copy lang-copy--en">Open the Measurement Gate</span> <span aria-hidden="true">→</span></a>
      </div>
    </article>

  </section>

  <section id="observatory-rooms" class="observatory-rooms container" aria-labelledby="rooms-title">
    <header>
      <p class="eyebrow"><span class="lang-copy lang-copy--de">Freigegebener Ausschnitt mit sechs Räumen</span><span class="lang-copy lang-copy--en">Six-room release cut</span></p>
      <h2 id="rooms-title"><span class="lang-copy lang-copy--de">Was die Instrumente unterscheidbar halten.</span><span class="lang-copy lang-copy--en">What the instruments keep distinct.</span></h2>
    </header>
    <article class="observatory-prediction-entry" aria-labelledby="interstellar-lens-title">
      <div>
        <p class="eyebrow"><span class="lang-copy lang-copy--de">Prediction-Modul · quellgebundener Kandidat</span><span class="lang-copy lang-copy--en">Prediction module · source-bound candidate</span></p>
        <h3 id="interstellar-lens-title">Interstellar<br />Entry / Exit Lens.</h3>
      </div>
      <div>
        <p class="observatory-prediction-entry__lead"><span class="lang-copy lang-copy--de">1I, 2I und die temporäre 3I-Lösung werden aus eingefrorenen JPL-Quellen durch zwei unterscheidbare Rechenwege gelesen. Die historische ALGO/OLGO-Regel bleibt als deklarierte Hypothese sichtbar.</span><span class="lang-copy lang-copy--en">1I, 2I and the temporary 3I solution are read from frozen JPL sources through two distinguishable computational views. The historical ALGO/OLGO rule remains visible as a declared hypothesis.</span></p>
        <p><span class="lang-copy lang-copy--de">NEXAHs erste formal vorbereitete Prediction-Linie – noch keine bestätigte oder aktivierte Vorhersage. Phase, Kovarianz, Zielkorridor und Trefferregel müssen vor dem nächsten Ziel eingefroren werden.</span><span class="lang-copy lang-copy--en">NEXAH's first formally prepared prediction line—not yet a confirmed or activated prediction. Phase, covariance, target corridor and scoring rule must be frozen before the next target is inspected.</span></p>
        <div class="observatory-prediction__status"><span>DRAFT PROTOCOL</span><span>NO TARGET</span><span>NO +1 YET</span></div>
        <a class="button button--secondary" href="/laboratory/roedelheim-observatory/measurement-gate/interstellar-entry-exit/"><span class="lang-copy lang-copy--de">Prediction Lens öffnen</span><span class="lang-copy lang-copy--en">Open the Prediction Lens</span></a>
      </div>
    </article>
    <ol>
      {roedelheimRooms.map((room) => (
        <li>
          <a href={`/laboratory/roedelheim-observatory/rooms/${room.slug}/`} aria-label={`Open ${room.title}`}>
            <span class="observatory-room__number">{room.number}</span>
            <h3>{room.title}</h3>
            <p><span class="lang-copy lang-copy--de">{room.descriptionDe}</span><span class="lang-copy lang-copy--en">{room.description}</span></p>
            <strong><span class="lang-copy lang-copy--de">Raum öffnen</span><span class="lang-copy lang-copy--en">Open room</span> <i aria-hidden="true">→</i></strong>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="observatory-book container" aria-labelledby="observatory-book-title">
    <figure>
      <img src="/observatory-assets/roedelheim-observatory-book-cover.png" alt="Cover of Rödelheim Observatory — How a Moving World Leaves a Trace" loading="lazy" />
    </figure>
    <div>
      <p class="eyebrow"><span class="lang-copy lang-copy--de">Observatory Fieldbook · visuelle Sequenz in 73 Teilen</span><span class="lang-copy lang-copy--en">Observatory fieldbook · 73-part visual sequence</span></p>
      <h2 id="observatory-book-title">How a Moving World<br />Leaves a Trace.</h2>
      <p class="observatory-book__lead"><span class="lang-copy lang-copy--de">Ein Fenster, ein Horizont, eine Uhr und ein Beobachter: Das Buch versammelt das Observatorium in einer visuellen Lesesequenz, ohne seine unterschiedlichen Instrumente zu einer einzigen Aussage zu verschmelzen.</span><span class="lang-copy lang-copy--en">A window, a horizon, a clock and an observer: the book gathers the Observatory into one visual reading sequence without collapsing its different instruments into a single claim.</span></p>
      <p><span class="lang-copy lang-copy--de">Die derzeitige öffentliche Lesefläche ist der originale englischsprachige Are.na-Kanal. Ein nativer NEXAH Reader kann später folgen; heute wird er nicht als fertig dargestellt.</span><span class="lang-copy lang-copy--en">The current public reading surface is the original English-language Are.na channel. A native NEXAH reader can follow later; it is not presented as complete today.</span></p>
      <div class="observatory-book__actions">
        <a class="button" href="https://www.are.na/nexah-scarabaeus1031/the-rodelhaeim-observatory" target="_blank" rel="noreferrer"><span class="lang-copy lang-copy--de">Buch auf Are.na öffnen</span><span class="lang-copy lang-copy--en">Open the book on Are.na</span> <span aria-hidden="true">↗</span></a>
        <span><span class="lang-copy lang-copy--de">Nativer Reader · in Vorbereitung</span><span class="lang-copy lang-copy--en">Native reader · in preparation</span></span>
      </div>
    </div>
  </section>

  <aside class="observatory-return container">
    <div><p class="eyebrow"><span class="lang-copy lang-copy--de">Aussagegrenze</span><span class="lang-copy lang-copy--en">Claim ceiling</span></p><h2><span class="lang-copy lang-copy--de">Ein Observatorium ist eine Art zu schauen – nicht das betrachtete Objekt.</span><span class="lang-copy lang-copy--en">An Observatory is a way of looking—not the object looked at.</span></h2></div>
    <div>
      <p><span class="lang-copy lang-copy--de">Die ausgewählten Räume sind dokumentarische und darstellende Instrumente. Sie machen Rahmen, Schnitte und Residuen nachvollziehbar. Sie begründen keine Ephemeride, physische Kopplung, universellen Operatoren oder buchstäblichen höherdimensionalen Objekte.</span><span class="lang-copy lang-copy--en">The selected rooms are documentary and representational instruments. They make frames, cuts and residuals inspectable. They do not establish an ephemeris, physical coupling, universal operator or literal higher-dimensional object.</span></p>
      <nav aria-label="Observatory returns">
        <a class="button" href="/how-nexah-works/"><span class="lang-copy lang-copy--de">Zur NEXAH-Methode zurückkehren</span><span class="lang-copy lang-copy--en">Return to the NEXAH method</span></a>
        <a class="text-link" href="https://www.scarabaeus1033.net/observatory"><span class="lang-copy lang-copy--de">Das Scarabäus-Studiofenster besuchen</span><span class="lang-copy lang-copy--en">Visit the Scarabäus studio window</span> ↗</a>
      </nav>
    </div>
  </aside>
</BaseLayout>

<style>
  .observatory-hero{position:relative;display:grid;min-height:min(82rem,calc(100svh - 4rem));overflow:hidden;background:#040d14;color:#e7f1f4;isolation:isolate}
  .observatory-hero::after{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(4,13,20,.95) 0%,rgba(4,13,20,.76) 42%,rgba(4,13,20,.18) 75%),linear-gradient(0deg,rgba(4,13,20,.72),transparent 42%);content:""}
  .observatory-hero__visual{position:absolute;inset:0;z-index:-2}
  .observatory-hero__visual svg{width:100%;height:100%;object-fit:cover}
  .observatory-hero__copy{display:flex;min-height:inherit;flex-direction:column;align-items:flex-start;justify-content:center;padding-block:clamp(5rem,10vw,9rem)}
  .observatory-hero h1{max-width:10.5ch;margin:.65rem 0 1.75rem;font-family:var(--font-display);font-size:clamp(3.5rem,7.6vw,8.6rem);font-weight:500;letter-spacing:-.055em;line-height:.88}
  .observatory-hero__score{max-width:28rem;margin:0;color:#e9b541;font-family:var(--font-display);font-size:clamp(1.4rem,2.4vw,2.15rem);line-height:1.15}
  .observatory-hero__boundary{max-width:32rem;margin:1.5rem 0 0;color:#9fb6c1;font-size:.82rem;letter-spacing:.08em;text-transform:uppercase}
  .observatory-hero__action{margin-top:2.2rem;border-color:#e9b541;background:#e9b541;color:#071923}
  .observatory-hero__action:hover{background:#f3cb6b}
  .observatory-hero__clocks ellipse{transform-box:fill-box;transform-origin:center}
  .observatory-hero__clocks ellipse:nth-child(2){animation:observatory-orbit 38s linear infinite}
  .observatory-hero__clocks ellipse:nth-child(3){animation:observatory-orbit-reverse 52s linear infinite}
  .observatory-hero__stars{animation:observatory-stars 7s ease-in-out infinite alternate}
  .observatory-instruments{background:linear-gradient(180deg,#f5f0e6 0%,var(--paper) 34%)}
  .observatory-instruments__header{display:grid;grid-template-columns:minmax(0,1fr) minmax(18rem,.8fr);gap:clamp(1.5rem,6vw,7rem);padding-block:clamp(4.5rem,8vw,8rem);border-bottom:1px solid var(--color-line)}
  .observatory-instruments__header .eyebrow{grid-column:1/-1;margin-bottom:-1rem}
  .observatory-instruments__header h2{max-width:12ch;margin:0;font-family:var(--font-display);font-size:clamp(3rem,6vw,6.4rem);font-weight:500;letter-spacing:-.045em;line-height:.9}
  .observatory-instruments__header p:last-child{align-self:end;margin:0;color:var(--ink-soft);font-size:clamp(1rem,1.7vw,1.3rem);line-height:1.55}
  .observatory-rooms{padding-block:clamp(4rem,8vw,8rem);border-block:1px solid var(--color-line)}
  .observatory-rooms h2,.observatory-return h2{max-width:14ch;margin:.4rem 0 0;font-family:var(--font-display);font-size:clamp(2.6rem,5vw,5.6rem);font-weight:500;line-height:.94}
  .observatory-rooms ol{display:grid;grid-template-columns:repeat(3,1fr);margin:3.5rem 0 0;padding:0;list-style:none}
  .observatory-rooms li{min-height:18rem;border:1px solid var(--color-line);margin:-1px 0 0 -1px}
  .observatory-rooms li>a{display:flex;height:100%;min-height:18rem;flex-direction:column;padding:1.4rem;color:inherit;text-decoration:none;transition:background-color .18s ease,color .18s ease,transform .18s ease}
  .observatory-rooms li>a:hover,.observatory-rooms li>a:focus-visible{position:relative;z-index:1;background:#071923;color:#e8f2f4;outline:2px solid #42cde2;outline-offset:-2px;transform:translateY(-.22rem)}
  .observatory-room__number{font-family:var(--font-mono);font-size:.68rem;letter-spacing:.14em}
  .observatory-rooms h3{margin:5rem 0 .8rem;font-family:var(--font-display);font-size:1.8rem;line-height:1}
  .observatory-rooms p,.observatory-return p{line-height:1.65}
  .observatory-rooms strong{display:flex;align-items:center;justify-content:space-between;margin-top:auto;padding-top:2rem;color:#a97900;font:700 .7rem/1 var(--font-mono);letter-spacing:.1em;text-transform:uppercase}
  .observatory-rooms li>a:hover strong,.observatory-rooms li>a:focus-visible strong{color:#e9b541}
  .observatory-rooms strong i{font-size:1rem;font-style:normal}
  .observatory-instrument{display:grid;grid-template-columns:minmax(18rem,.85fr) minmax(0,1fr);gap:clamp(2rem,7vw,8rem);align-items:center;padding-block:clamp(5rem,9vw,9rem);border-bottom:1px solid var(--color-line)}
  .observatory-instrument h2{max-width:10ch;margin:.4rem 0 1.5rem;font-family:var(--font-display);font-size:clamp(3rem,6vw,6.4rem);font-weight:500;letter-spacing:-.045em;line-height:.86}
  .observatory-instrument__lead{font-size:clamp(1.15rem,2vw,1.45rem);line-height:1.45}
  .observatory-instrument .button{margin-top:1.25rem}
  .observatory-instrument__mark{position:relative;width:min(26rem,78vw);aspect-ratio:1;justify-self:center;border:2px solid #f15bb5;border-radius:50%}
  .observatory-instrument__mark::before{position:absolute;inset:22%;border:2px solid #42cde2;border-radius:50%;content:""}
  .observatory-instrument__mark span{position:absolute;top:50%;left:8%;width:84%;border-top:2px solid #e9b541;transform:rotate(-22deg)}
  .observatory-instrument__mark i{position:absolute;top:50%;left:50%;display:grid;width:3.2rem;aspect-ratio:1;place-items:center;transform:translate(-50%,-50%);border-radius:50%;background:#071923;color:#fff;font:700 1rem/1 var(--font-mono)}
  .observatory-extension{display:grid;grid-template-columns:minmax(0,1fr) minmax(18rem,.85fr);gap:clamp(2rem,7vw,8rem);padding-block:clamp(5rem,9vw,9rem);border-bottom:1px solid var(--color-line)}
  .observatory-extension h2{max-width:12ch;margin:.4rem 0 0;font-family:var(--font-display);font-size:clamp(3rem,6vw,6.4rem);font-weight:500;letter-spacing:-.045em;line-height:.86}
  .observatory-extension__lead{font-size:clamp(1.15rem,2vw,1.45rem);line-height:1.45}
  .observatory-extension .button{margin-top:1.25rem}
  .observatory-extension--measurement{background:linear-gradient(135deg,rgba(66,205,226,.06),rgba(241,91,181,.05))}
  .observatory-prediction-entry{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(18rem,.9fr);gap:clamp(2rem,7vw,8rem);margin-top:3.5rem;padding:clamp(2rem,5vw,4rem);overflow:hidden;background:#071923;color:#e8f2f4}.observatory-prediction-entry::before{position:absolute;inset:0;background:radial-gradient(circle at 17% 33%,rgba(66,205,226,.16),transparent 34%),radial-gradient(circle at 86% 70%,rgba(233,181,65,.14),transparent 30%);content:"";pointer-events:none}.observatory-prediction-entry>*{position:relative}.observatory-prediction-entry .eyebrow{color:#e9b541}.observatory-prediction-entry h3{max-width:12ch;margin:.4rem 0 0;font-family:var(--font-display);font-size:clamp(2.7rem,5.5vw,5.8rem);font-weight:500;letter-spacing:-.045em;line-height:.86}.observatory-prediction-entry p{color:#b7c9ce;line-height:1.6}.observatory-prediction-entry__lead{font-size:clamp(1.1rem,1.8vw,1.35rem)}.observatory-prediction__status{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.5rem}.observatory-prediction__status span{padding:.45rem .65rem;border:1px solid #34515b;color:#8ddced;font:700 .7rem/1 var(--font-mono);letter-spacing:.08em}.observatory-prediction-entry .button{margin-top:1.25rem;border-color:#e9b541;color:#e9b541}
