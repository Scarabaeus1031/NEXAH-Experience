---
import LaboratoryNav from "@/components/laboratory/LaboratoryNav.astro";
import PublicationCover from "@/components/library/PublicationCover.astro";
import { featuredLaboratoryPublication } from "@/data/laboratory";
import { researchArchitectureView } from "@/data/research-architecture";
import BaseLayout from "@/layouts/BaseLayout.astro";

const featured = featuredLaboratoryPublication;
const featuredCover = featured.localBook?.cover ?? featured.cover.src;
const featuredCoverAlt = featured.localBook?.coverAlt ?? featured.cover.alt ?? `Cover of ${featured.title}`;
const featuredWidth = featured.localBook ? 1024 : featured.cover.width;
const featuredHeight = featured.localBook ? 1536 : featured.cover.height;
---

<BaseLayout
  title="Laboratory — NEXAH"
  description="The experimental environment within NEXAH where concepts, prototypes, operators and research are developed and validated."
>
  <LaboratoryNav />

  <header class="container laboratory-hero">
    <div>
      <p class="eyebrow">The Laboratory</p>
      <h1>How did this work come into being?</h1>
      <p class="lead">The experimental environment where questions become concepts, prototypes, operators, research and reviewed publications.</p>
    </div>
    <div class="laboratory-hero__note">
      <p>The Laboratory guides visitors to the process, current work, publications and versioned research records. The Repository documents their sources and scientific baselines.</p>
      <a class="button" href="/laboratory/process/">Follow the research process</a>
    </div>
  </header>

  <section class="container laboratory-feature" aria-labelledby="laboratory-feature-title">
    <a class="laboratory-feature__cover" href={`/library/${featured.routeSlug}/`} data-carry-question>
      <PublicationCover
        src={featuredCover}
        alt={featuredCoverAlt}
        width={featuredWidth}
        height={featuredHeight}
        title={featured.title}
        kind={featured.form.replaceAll("_", " ")}
        loading="eager"
        referrerpolicy="no-referrer"
      />
    </a>
    <div>
      <p class="eyebrow">Primary Laboratory reading</p>
      <h2 id="laboratory-feature-title">{featured.localBook?.title ?? featured.title}</h2>
      <p class="laboratory-feature__subtitle">{featured.localBook?.subtitle ?? featured.series}</p>
      <p class="lead">A visitor’s guide to the Repository, its research wings and experimental facilities.</p>
      <p class="publication-availability-note"><strong>Reading Selection available.</strong> The local Reading Space contains selected recorded pages; the Original Publication remains authoritative on Are.na.</p>
      <div class="laboratory-feature__actions">
        <a class="button" href={`/library/${featured.routeSlug}/read/`} data-carry-question>Enter Reading Space</a>
        <a class="button button--secondary" href={`/library/${featured.routeSlug}/`} data-carry-question>Open Publication Record</a>
      </div>
      <p class="laboratory-feature__path">Laboratory → Publication Record → Reading Selection → Original Publication</p>
    </div>
  </section>

  <section class="container laboratory-distinction" aria-labelledby="distinction-title">
    <header>
      <p class="eyebrow">Three different places</p>
      <h2 id="distinction-title">Work, publication and connection remain distinct.</h2>
      <p data-source-section={researchArchitectureView.publicEntrances.laboratory.sourceSection}>
        {researchArchitectureView.publicEntrances.laboratory.text}
        <a class="text-link" href={researchArchitectureView.publicEntrances.laboratory.href}>
          {researchArchitectureView.publicEntrances.laboratory.linkLabel} <span aria-hidden="true">→</span>
        </a>
      </p>
    </header>
    <div>
      <article>
        <small>Laboratory</small>
        <h3>See the process.</h3>
        <p>Understand how research moves from an open question toward a citable work.</p>
      </article>
      <article>
        <small>Library</small>
        <h3>Read the publications.</h3>
        <p>Enter works that have crossed the editorial threshold into the public collection.</p>
        <a class="text-link" href="/library/">Enter the Library</a>
      </article>
      <article>
        <small>Living Atlas</small>
        <h3>Follow declared relationships.</h3>
        <p>Move between publications, concepts and themes through curated connections.</p>
        <a class="text-link" href="/atlas/">Enter the Atlas</a>
      </article>
    </div>
  </section>

  <aside class="container laboratory-continuation">
    <div><p class="eyebrow">Repository and baselines</p><h2>Research records and scientific baselines remain inspectable at their source.</h2></div>
    <a class="button button--secondary" href="/laboratory/repository/">Understand the Repository</a>
  </aside>
</BaseLayout>
