---
import LaboratoryNav from "@/components/laboratory/LaboratoryNav.astro";
import PublicationCover from "@/components/library/PublicationCover.astro";
import { featuredLaboratoryPublication, repositoryDocumentUrl } from "@/data/laboratory";
import BaseLayout from "@/layouts/BaseLayout.astro";

const featured = featuredLaboratoryPublication;
const featuredCover = featured.localBook?.cover ?? featured.cover.src;
const featuredCoverAlt = featured.localBook?.coverAlt ?? featured.cover.alt ?? `Cover of ${featured.title}`;
const featuredWidth = featured.localBook ? 1024 : featured.cover.width;
const featuredHeight = featured.localBook ? 1536 : featured.cover.height;

const researchStatus = [
  ["FORMAL STATUS", "Results available", "Finite, reproducible results with separate evidence classes."],
  ["RESEARCH MATURITY", "R2–R3 · internal", "Definitions, replays and verifiers exist; external gates remain open."],
  ["OPERATING STATE", "Structure Freeze · 0 active", "No Study is active and no scientific publication is authorised."],
  ["NEXT GATE", "External review", "Review SCC-003; assess novelty and Human utility separately."],
] as const;

const researchSignals = [
  ["01", "Formal result", "SCC-003", "The strongest narrow candidate: a bounded, internally reproducible result with a defined external review gate."],
  ["02", "Negative result", "Euler support does not carry.", "A tested route was rejected. The negative result remains visible as a methodological boundary."],
  ["03", "Methodical result", "Return without identity.", "A return can preserve provenance and difference without declaring distinct representations to be the same object."],
  ["04", "Instrumental result", "Operable comparison views.", "Benches, LOOK AGAIN and related instruments make cuts, views and Returns inspectable; Human utility remains open."],
] as const;

const fields = [
  ["01", "Mathematical structures", "Finite relations, symmetries, discrete carriers and explicitly bounded conjectures."],
  ["02", "Dynamics & complex systems", "Transitions, paths, stability, recurrence and the limits of a chosen view."],
  ["03", "Natural-science cases", "Source-bound cases used for comparison—not claims of disciplinary ownership."],
  ["04", "Networks & infrastructure", "Relations, routes, interfaces and the conditions under which coordination remains legible."],
  ["05", "Maps, language & representation", "How symbols, diagrams and projections select, preserve and omit."],
  ["06", "Human orientation", "How a result returns to attention, judgment and possible action without automating either."],
] as const;

const architecture = [
  ["Orientation Language", "describes"],
  ["Kernel & ORION", "executes"],
  ["Reference systems", "test"],
  ["Science Lab", "records"],
  ["Library & Experience", "reveal"],
  ["Human judgment", "returns"],
] as const;

const programmes = [
  {
    marker: "CURRENT PROGRAMME",
    title: "NEXAH Orientation Programme",
    text: "A source-aware reference object for studying what changes between source, operation, representation and Return.",
    href: "/a0/",
    action: "Explore the programme",
    external: false,
  },
  {
    marker: "PUBLIC LANGUAGE",
    title: "Orientation Language 1.0",
    text: "A bounded vocabulary for declaring representations, relations, transitions and conformance.",
    href: repositoryDocumentUrl("ORIENTATION_LANGUAGE/README.md"),
    action: "Read the specification",
    external: true,
  },
  {
    marker: "APPLICATION FIELD",
    title: "Network Orientation",
    text: "A practical field for testing how sources, relations, paths and operational views remain distinguishable.",
    href: repositoryDocumentUrl("APPLICATIONS/network_orientation/README.md"),
    action: "Inspect the source",
    external: true,
  },
] as const;
---

<BaseLayout
  title="NEXAH Science — Public Research Status"
  description="The public NEXAH Science view presents current results, evidence maturity, open validation boundaries and source routes."
  headerVariant="science"
>
  <LaboratoryNav />

  <header class="science-hero">
    <div class="container science-hero__inner">
      <div class="science-hero__copy">
        <p class="eyebrow">NEXAH Science · Public research status</p>
        <h1>What remains<br /><em>when the view changes?</em></h1>
        <p class="lead">NEXAH Science builds source-bound instruments that keep source, cut, operator, view, residual and Return distinguishable. This page publishes what currently carries—and what does not.</p>
        <div class="science-hero__actions">
          <a class="button" href="#research-status">Read the current status <span aria-hidden="true">↓</span></a>
          <a class="text-link" href="/laboratory/process/">Follow the research process</a>
        </div>
      </div>
      <aside class="science-question" aria-label="Core research question">
        <span>CORE QUESTION</span>
        <p>What remains when representation changes?</p>
        <small>Representation ≠ explanation ≠ evidence.</small>
        <div class="science-question__diagram" aria-hidden="true">
          <b>Δ</b>
        </div>
      </aside>
    </div>
  </header>

  <section id="research-status" class="science-status" aria-label="Current public NEXAH Science research status">
    <div class="container">
      <p class="science-status__date">NEXAH SCIENCE · SOURCE STATUS SYNCHRONISED 24 OCTOBER 2026</p>
      <div class="science-status__grid">
        {researchStatus.map(([label, value, text]) => (
          <article>
            <p>{label}</p>
            <strong>{value}</strong>
            <span>{text}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="science-intro section--line" aria-labelledby="science-intro-title">
    <div class="container science-intro__inner">
      <header>
        <p class="eyebrow">The built research object</p>
        <h2 id="science-intro-title">A machine for comparing bounded views.</h2>
      </header>
      <div>
        <p class="lead">NEXAH Science is neither a single graphic nor a universal theory. It is a documented architecture in which a carrier is observed through declared cuts and operators—with visible loss and a testable route back.</p>
        <p>Engineering records arise while instruments are built. A scientific result requires a declared question, controls, replay, classification, a claim boundary and Return.</p>
      </div>
    </div>
  </section>

  <section class="science-signals" aria-label="Current research signals">
    <div class="container science-signals__grid">
      {researchSignals.map(([marker, label, title, text]) => (
        <article>
          <p><span>{marker}</span>{label}</p>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="research-field" class="science-fields section--line" aria-labelledby="science-fields-title">
    <div class="container">
      <header class="science-section-head">
        <div>
          <p class="eyebrow">Research field</p>
          <h2 id="science-fields-title">Six source spaces.<br />No ownership claim.</h2>
        </div>
        <p>The fields provide cases, languages and constraints. A connection is only reported when its source, shared quantity and operation are explicit.</p>
      </header>
      <ol class="science-fields__grid">
        {fields.map(([marker, title, text]) => (
          <li>
            <span>{marker}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="science-architecture" aria-labelledby="science-architecture-title">
    <div class="container science-architecture__inner">
      <header>
        <p class="eyebrow">Research architecture</p>
        <h2 id="science-architecture-title">One inquiry.<br />Clear responsibilities.</h2>
        <p>The parts exchange material without collapsing their roles. This is how a public experience can remain connected to an inspectable research record.</p>
      </header>
      <ol>
        {architecture.map(([name, role], index) => (
          <li>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{name}</strong>
            <em>{role}</em>
          </li>
        ))}
      </ol>
      <p class="science-architecture__boundary"><strong>Boundary:</strong> connected does not mean identical. A model is not a mechanism; a result is not a general theory; a publication is not automatic validation.</p>
    </div>
  </section>

  <section class="science-programmes section--line" aria-labelledby="science-programmes-title">
    <div class="container">
      <header class="science-section-head">
        <div>
          <p class="eyebrow">Programmes & foundations</p>
          <h2 id="science-programmes-title">Follow the work at the right depth.</h2>
        </div>
        <p>This page publishes the current orientation. NEXAH carries the programme; specifications, papers and repositories retain the technical and scientific record.</p>
      </header>
      <div class="science-programmes__grid">
        {programmes.map((programme, index) => (
          <a
            class:list={["science-programme", { "science-programme--primary": index === 0 }]}
            href={programme.href}
            target={programme.external ? "_blank" : undefined}
            rel={programme.external ? "noopener noreferrer" : undefined}
          >
            <span>{programme.marker}</span>
            <h3>{programme.title}</h3>
            <p>{programme.text}</p>
            <b>{programme.action} <span aria-hidden="true">{programme.external ? "↗" : "→"}</span></b>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="container science-reading" aria-labelledby="science-reading-title">
    <a class="science-reading__cover" href={`/library/${featured.routeSlug}/`} data-carry-question>
      <PublicationCover
        src={featuredCover}
        alt={featuredCoverAlt}
        width={featuredWidth}
        height={featuredHeight}
        title={featured.title}
        kind={featured.form.replaceAll("_", " ")}
        loading="lazy"
        referrerpolicy="no-referrer"
      />
    </a>
    <div class="science-reading__copy">
      <p class="eyebrow">Read the research</p>
      <h2 id="science-reading-title">The public work begins with a guided reading.</h2>
      <p class="lead">Books and papers translate selected research into a durable public form. The underlying record, methods and open questions remain available behind them.</p>
      <p><strong>{featured.localBook?.title ?? featured.title}</strong> introduces the Laboratory, its research wings and its experimental facilities without turning the tour into scientific evidence.</p>
      <p class="publication-availability-note"><strong>Reading Selection available.</strong> The local Reading Space contains selected recorded pages; the Original Publication remains authoritative on Are.na.</p>
      <div class="science-reading__actions">
        <a class="button" href={`/library/${featured.routeSlug}/read/`} data-carry-question>Enter Reading Space</a>
        <a class="text-link" href="/library/">Browse the Library</a>
      </div>
    </div>
  </section>

  <section class="science-review section--line" aria-labelledby="science-review-title">
    <div class="container science-review__inner">
      <div>
        <p class="eyebrow">Review & currentness</p>
        <h2 id="science-review-title">Challenge a claim. Test an orientation task.</h2>
      </div>
      <div>
        <p>Novelty, independent replay, Human utility and the Claim Ceiling remain open. Design and interactivity do not replace those scientific gates.</p>
        <div class="science-review__actions">
          <a class="button" href="#research-status">Review the public status</a>
          <a class="button button--secondary" href="/laboratory/repository/">Inspect sources & baselines</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .science-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(circle at 78% 50%, color-mix(in srgb, var(--cyan) 13%, transparent), transparent 24rem),
      linear-gradient(112deg, var(--paper) 0 62%, color-mix(in srgb, var(--cyan) 5%, var(--paper)) 62% 100%);
  }
  .science-hero::after {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(to right, color-mix(in srgb, var(--ink) 5%, transparent) 1px, transparent 1px);
    background-size: 7rem 100%;
    content: "";
    pointer-events: none;
  }
  .science-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(20rem, .65fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
    min-height: min(56rem, 68svh);
    padding-block: clamp(4.5rem, 7vw, 7rem);
  }
  .science-hero h1 {
    max-width: 9ch;
    margin: .3rem 0 1.8rem;
    font-size: clamp(4rem, 7vw, 7.5rem);
    line-height: .86;
    letter-spacing: -.075em;
  }
  .science-hero h1 em { color: var(--cyan-dark); font-weight: inherit; }
  .science-hero__copy .lead { max-width: 35rem; }
  .science-hero__actions,
  .science-reading__actions,
  .science-review__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.4rem;
    align-items: center;
    margin-top: 2rem;
  }
  .science-question {
    position: relative;
    min-height: 22rem;
    padding: 2rem;
    border: 1px solid var(--ink);
    background: color-mix(in srgb, var(--paper) 84%, transparent);
  }
  .science-question > span,
  .science-question > small {
    font-family: var(--font-mono);
    font-size: .69rem;
    font-weight: 700;
    letter-spacing: .14em;
  }
  .science-question > p {
    position: relative;
    z-index: 1;
    max-width: 13ch;
    margin: 1rem 0;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 2.5vw, 2.8rem);
    font-weight: 700;
    line-height: .98;
  }
  .science-question > small { position: absolute; bottom: 1.7rem; left: 2rem; }
  .science-question__diagram {
    position: absolute;
    right: 2rem;
    bottom: 2.2rem;
    width: 8.25rem;
    aspect-ratio: 1;
    border: 1px solid var(--cyan-dark);
    border-radius: 50%;
  }
  .science-question__diagram::before,
  .science-question__diagram::after {
    position: absolute;
    inset: 1.65rem;
    border: 1px solid var(--gold);
    border-radius: 50%;
    content: "";
  }
  .science-question__diagram::after { inset: 2.55rem; border-color: var(--magenta); }
  .science-question__diagram b { position: absolute; inset: 0; display: grid; place-items: center; font: 700 1.5rem/1 var(--font-display); }
  .science-intro__inner,
  .science-review__inner {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    padding-block: clamp(4rem, 6vw, 6rem);
  }
  .science-intro h2,
  .science-section-head h2,
  .science-architecture h2,
  .science-reading h2,
  .science-review h2 {
    margin-top: .5rem;
    font-size: clamp(2.5rem, 4.2vw, 4.6rem);
    line-height: .94;
    letter-spacing: -.045em;
  }
  .science-intro__inner > div { max-width: 44rem; }
  .science-status { padding-block: 2.5rem; background: var(--ink); color: var(--paper); }
  .science-status__date { margin: 0 0 1rem; color: var(--gold); font: 700 .68rem/1.2 var(--font-mono); letter-spacing: .12em; }
  .science-status__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid color-mix(in srgb, var(--paper) 25%, transparent); border-left: 1px solid color-mix(in srgb, var(--paper) 25%, transparent); }
  .science-status article { display: flex; min-height: 11rem; flex-direction: column; gap: .65rem; padding: 1.35rem; border-right: 1px solid color-mix(in srgb, var(--paper) 25%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--paper) 25%, transparent); }
  .science-status article p { margin: 0; color: var(--cyan); font: 700 .65rem/1.2 var(--font-mono); letter-spacing: .1em; }
  .science-status article strong { font-family: var(--font-display); font-size: clamp(1.45rem, 2vw, 2rem); line-height: 1; }
  .science-status article span { margin-top: auto; color: color-mix(in srgb, var(--paper) 72%, transparent); font-size: .85rem; line-height: 1.45; }
  .science-signals { background: var(--ink); color: var(--paper); }
  .science-signals__grid { display: grid; grid-template-columns: repeat(4, 1fr); padding: 0; }
  .science-signals article { min-height: 16rem; padding: 1.75rem; border-right: 1px solid color-mix(in srgb, var(--paper) 22%, transparent); }
  .science-signals article:last-child { border-right: 0; }
  .science-signals article > p:first-child { color: var(--cyan); font: 700 .67rem/1.2 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; }
  .science-signals article > p:first-child span { display: block; margin-bottom: 2.5rem; color: var(--gold); }
  .science-signals h3 { margin-bottom: 1rem; font-size: clamp(1.5rem, 2vw, 2rem); line-height: 1; }
  .science-signals article > p:last-child { color: color-mix(in srgb, var(--paper) 72%, transparent); }
  .science-fields,
  .science-programmes { padding-block: clamp(4rem, 6vw, 6rem); }
  .science-section-head {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, .55fr);
    gap: 3rem;
    align-items: end;
    margin-bottom: 3.5rem;
  }
  .science-section-head > p { max-width: 34rem; }
  .science-fields__grid { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0; padding: 0; border-top: 1px solid var(--line); border-left: 1px solid var(--line); list-style: none; }
  .science-fields__grid li { min-height: 14rem; padding: 1.6rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .science-fields__grid span { color: var(--cyan-dark); font: 700 .7rem/1 var(--font-mono); }
  .science-fields__grid h3 { margin: 2.25rem 0 1rem; font-size: clamp(1.4rem, 2vw, 2rem); line-height: 1; }
  .science-architecture { padding-block: clamp(4rem, 6vw, 6rem); background: #071923; color: #f6f2e9; }
  .science-architecture__inner { display: grid; grid-template-columns: minmax(18rem, .72fr) minmax(0, 1.28fr); gap: clamp(2.5rem, 5vw, 5rem); }
  .science-architecture header > p:last-child { max-width: 37rem; color: #a9bdc7; }
  .science-architecture ol { margin: 0; padding: 0; border-top: 1px solid #315464; list-style: none; }
  .science-architecture li { display: grid; grid-template-columns: 3rem 1fr auto; gap: 1.2rem; align-items: baseline; padding: 1.25rem 0; border-bottom: 1px solid #315464; }
  .science-architecture li span { color: var(--gold); font: 700 .68rem/1 var(--font-mono); }
  .science-architecture li strong { font-family: var(--font-display); font-size: clamp(1.4rem, 2vw, 2rem); }
  .science-architecture li em { color: var(--cyan); font: 700 .66rem/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .science-architecture__boundary { grid-column: 1 / -1; margin: 0; padding-top: 2rem; border-top: 1px solid #315464; color: #a9bdc7; }
  .science-architecture__boundary strong { color: #f6f2e9; }
  .science-programmes__grid { display: grid; grid-template-columns: 1.25fr 1fr 1fr; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .science-programme { display: flex; min-height: 18rem; flex-direction: column; padding: 1.75rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; transition: background-color .2s ease, color .2s ease; }
  .science-programme:hover { background: var(--ink); color: var(--paper); }
  .science-programme--primary { background: color-mix(in srgb, var(--cyan) 9%, var(--paper)); }
  .science-programme > span { color: var(--magenta); font: 700 .66rem/1 var(--font-mono); letter-spacing: .12em; }
  .science-programme h3 { margin: 2.5rem 0 1rem; font-size: clamp(1.8rem, 2.8vw, 2.8rem); line-height: .96; }
  .science-programme p { max-width: 30rem; }
  .science-programme b { margin-top: auto; color: var(--cyan-dark); font: 700 .68rem/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .science-reading { display: grid; grid-template-columns: minmax(16rem, .58fr) minmax(0, 1.42fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: center; padding-block: clamp(4.5rem, 7vw, 7rem); }
  .science-reading__cover { display: block; max-width: 28rem; }
  .science-reading__copy { max-width: 49rem; }
  .science-review { background: color-mix(in srgb, var(--gold) 10%, var(--paper)); }
  @media (max-width: 900px) {
    .science-hero__inner,
    .science-intro__inner,
    .science-section-head,
    .science-architecture__inner,
    .science-reading,
    .science-review__inner { grid-template-columns: 1fr; }
    .science-hero__inner { min-height: auto; padding-block: 3.5rem; }
    .science-hero h1 { font-size: clamp(3.5rem, 12vw, 5.5rem); }
    .science-question { min-height: 20rem; }
    .science-signals__grid { grid-template-columns: repeat(2, 1fr); }
    .science-status__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .science-signals article:nth-child(2) { border-right: 0; }
    .science-signals article:nth-child(-n+2) { border-bottom: 1px solid color-mix(in srgb, var(--paper) 22%, transparent); }
    .science-fields__grid { grid-template-columns: repeat(2, 1fr); }
    .science-programmes__grid { grid-template-columns: 1fr; }
    .science-programme { min-height: 15rem; }
    .science-reading__cover { max-width: 20rem; }
  }
  @media (max-width: 580px) {
    .science-question__diagram { right: 1.5rem; bottom: 3.8rem; width: 9rem; }
    .science-signals__grid,
    .science-fields__grid,
    .science-status__grid { grid-template-columns: 1fr; }
    .science-signals article { min-height: auto; border-right: 0; border-bottom: 1px solid color-mix(in srgb, var(--paper) 22%, transparent); }
    .science-signals article > p:first-child span { margin-bottom: 2rem; }
    .science-fields__grid li { min-height: 12rem; }
    .science-architecture li { grid-template-columns: 2.5rem 1fr; }
    .science-architecture li em { grid-column: 2; }
  }
  @media (prefers-reduced-motion: reduce) {
    .science-programme { transition: none; }
  }
</style>
