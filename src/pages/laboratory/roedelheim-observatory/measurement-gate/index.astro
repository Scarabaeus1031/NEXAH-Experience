---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { measurementGateCases } from "@/data/measurement-gate";
import { measurementGateReaderPages } from "@/data/measurement-gate-reader";

const gateData = JSON.stringify({
  schema: "nexah.measurement-gate.public-candidate.v1",
  status: "LOCAL_CANDIDATE",
  graphEffect: "REUSE_EXISTING_IDENTITIES_ZERO_COUNT_CHANGE",
  cases: measurementGateCases,
  readerPages: measurementGateReaderPages,
});
---

<BaseLayout
  title="The Measurement Gate — Rödelheim Observatory"
  description="A source-bound NEXAH instrument for keeping number, quantity type, reference, cut, trace and return distinguishable."
>
  <header class="measurement-hero">
    <div class="container measurement-hero__grid">
      <div>
        <p class="eyebrow">Rödelheim Observatory · Source → Return</p>
        <h1>The<br /><em>Measurement</em><br />Gate.</h1>
        <p class="measurement-hero__lead"><span class="lang-copy lang-copy--de">Eine Zahl wird erst prüfbar, wenn Typ, Einheit, Referenz, Rahmen und Quelle gebunden bleiben.</span><span class="lang-copy lang-copy--en">A number becomes inspectable only when type, unit, reference, frame and source remain attached.</span></p>
        <p class="measurement-boundary"><strong><span class="lang-copy lang-copy--de">Aussagegrenze:</span><span class="lang-copy lang-copy--en">Claim boundary:</span></strong> <span class="lang-copy lang-copy--de">Dieses Instrument übt Quellen- und Darstellungsdisziplin. Es erzeugt keine Bahn und macht aus einer NEXAH-Lesart keine Physik.</span><span class="lang-copy lang-copy--en">This instrument practices source and representation discipline. It creates no orbit and turns no NEXAH reading into physics.</span></p>
        <a class="button" href="#declare"><span class="lang-copy lang-copy--de">Durch das Gate gehen</span><span class="lang-copy lang-copy--en">Enter the gate</span> <span aria-hidden="true">↓</span></a>
      </div>
      <div class="measurement-hero__mark" role="img" aria-label="Two distinct source loops meet at a typed measurement gate">
        <span class="measurement-loop measurement-loop--source"></span>
        <span class="measurement-loop measurement-loop--view"></span>
        <span class="measurement-axis"></span>
        <b>TYPE</b>
        <small>SOURCE · FRAME · REFERENCE</small>
      </div>
    </div>
  </header>

  <nav class="measurement-chain container" aria-label="Measurement Gate sequence">
    <span>SOURCE</span><span>TYPE</span><span>CUT</span><span>TRACE</span><span>COMPARE</span><span>RETURN</span>
  </nav>

  <section id="declare" class="measurement-room measurement-room--dark">
    <div class="container">
      <header class="measurement-room__head">
        <div><p class="eyebrow">Room A · Declare</p><h2><span class="lang-copy lang-copy--de">Eine Zahl braucht einen Typ.</span><span class="lang-copy lang-copy--en">A number needs a type.</span></h2></div>
        <p><span class="lang-copy lang-copy--de">Wähle einen quellgebundenen Fall und danach eine Größe. Das Interface zeigt keinen nackten Wert ohne seine Messadresse.</span><span class="lang-copy lang-copy--en">Choose a source-bound case and then a quantity. The interface refuses to show a bare value without its measurement address.</span></p>
      </header>
      <div class="measurement-cases" data-measurement-cases role="group" aria-label="Source-bound cases"></div>
      <div class="measurement-declare">
        <aside class="measurement-controls">
          <label for="measurement-quantity"><span class="lang-copy lang-copy--de">Größentyp</span><span class="lang-copy lang-copy--en">Quantity type</span></label>
          <select id="measurement-quantity" data-measurement-quantity></select>
          <dl data-measurement-meta></dl>
        </aside>
        <article class="measurement-value" aria-live="polite">
          <small data-measurement-qualifier></small>
          <strong data-measurement-value>—</strong>
          <b data-measurement-unit>—</b>
          <h3 data-measurement-type>—</h3>
          <p data-measurement-note></p>
          <i>TYPE ≠ VALUE ≠ OBJECT</i>
        </article>
      </div>
    </div>
  </section>

  <section id="cut" class="measurement-room measurement-room--paper">
    <div class="container">
      <header class="measurement-room__head">
        <div><p class="eyebrow">Room B · Cut</p><h2><span class="lang-copy lang-copy--de">Die Ansicht wählt. Die Quelle bleibt.</span><span class="lang-copy lang-copy--en">The view selects. The source remains.</span></h2></div>
        <p><span class="lang-copy lang-copy--de">Jeder Fall besitzt nur seinen deklarierten Operator. Die Zeichnung ist eine Ansicht oder Ableitung – kein Ersatz für den Träger.</span><span class="lang-copy lang-copy--en">Each case permits only its declared operator. The drawing is a view or derivation—not a replacement for the carrier.</span></p>
      </header>
      <div class="measurement-operator" data-measurement-operator></div>
      <div class="measurement-visual" data-measurement-visual aria-live="polite"></div>
      <div class="measurement-trace">
        <article><small><span class="lang-copy lang-copy--de">Quellenrecord</span><span class="lang-copy lang-copy--en">Source record</span></small><h3 data-measurement-source-title>—</h3><p data-measurement-source-copy>—</p></article>
        <article><small><span class="lang-copy lang-copy--de">Erzeugte Spur</span><span class="lang-copy lang-copy--en">Produced trace</span></small><h3 data-measurement-trace-title>—</h3><p data-measurement-trace-copy>—</p></article>
      </div>
    </div>
  </section>

  <section id="return" class="measurement-room measurement-room--dark">
    <div class="container">
      <header class="measurement-room__head">
        <div><p class="eyebrow">Room C · Return</p><h2><span class="lang-copy lang-copy--de">Die Unterscheidung zurückgeben.</span><span class="lang-copy lang-copy--en">Return the distinction.</span></h2></div>
        <p><span class="lang-copy lang-copy--de">Der Receipt nennt, was erhalten blieb, was unterdrückt wurde und was die Darstellung ausdrücklich nicht behauptet.</span><span class="lang-copy lang-copy--en">The receipt names what was preserved, what was suppressed and what the representation explicitly does not claim.</span></p>
      </header>
      <div class="measurement-return">
        <div class="measurement-return__cards" data-measurement-return-cards></div>
        <article class="measurement-receipt">
          <strong data-measurement-status>PASS</strong>
          <pre data-measurement-receipt aria-label="Machine-readable return receipt"></pre>
          <button class="button button--secondary" type="button" data-copy-measurement><span class="lang-copy lang-copy--de">Receipt kopieren</span><span class="lang-copy lang-copy--en">Copy receipt</span></button>
        </article>
      </div>
    </div>
  </section>

  <section class="measurement-fieldbook container" aria-labelledby="measurement-fieldbook-title">
    <header>
      <p class="eyebrow"><span class="lang-copy lang-copy--de">Das visuelle Fieldbook · fünf Tafeln</span><span class="lang-copy lang-copy--en">The visual fieldbook · five plates</span></p>
      <h2 id="measurement-fieldbook-title"><span class="lang-copy lang-copy--de">Die Visuals sind der Reader.</span><span class="lang-copy lang-copy--en">The visuals are the reader.</span></h2>
      <p><span class="lang-copy lang-copy--de">Jede Tafel bleibt an ihre Quelldatei, ihren Prüfstatus und ihre Aussagegrenze gebunden. Orientierung wird gezeigt, aber nicht still als Physik übernommen.</span><span class="lang-copy lang-copy--en">Each plate remains attached to its source file, review status and claim boundary. Orientation is shown without silently becoming physics.</span></p>
    </header>

    <div class="measurement-reader" data-reader-root>
      <div class="measurement-reader__stage">
        <button type="button" class="measurement-reader__image-button" data-reader-open aria-label="Open current plate at full size">
          <img data-reader-image src={measurementGateReaderPages[0].src} width={measurementGateReaderPages[0].width} height={measurementGateReaderPages[0].height} alt={measurementGateReaderPages[0].title} />
          <span><span class="lang-copy lang-copy--de">Tafel vergrößern</span><span class="lang-copy lang-copy--en">Enlarge plate</span> ↗</span>
        </button>
      </div>
      <aside class="measurement-reader__meta" aria-live="polite">
        <div class="measurement-reader__topline"><span data-reader-counter>01 / 05</span><strong data-reader-status>CANONICAL_METHOD_CORE</strong></div>
        <h3 data-reader-title>{measurementGateReaderPages[0].title}</h3>
        <p data-reader-caption>{measurementGateReaderPages[0].caption}</p>
        <div class="measurement-reader__boundary"><b><span class="lang-copy lang-copy--de">Aussagegrenze</span><span class="lang-copy lang-copy--en">Claim boundary</span></b><p data-reader-boundary>{measurementGateReaderPages[0].boundary}</p></div>
        <dl>
          <div><dt><span class="lang-copy lang-copy--de">Quelldatei</span><span class="lang-copy lang-copy--en">Source file</span></dt><dd data-reader-source>{measurementGateReaderPages[0].sourceFile}</dd></div>
          <div><dt>Binding</dt><dd data-reader-binding>SHA-256 · {measurementGateReaderPages[0].assetSha256.slice(0, 16)}…</dd></div>
        </dl>
        <div class="measurement-reader__controls">
          <button type="button" data-reader-prev disabled>← <span class="lang-copy lang-copy--de">Zurück</span><span class="lang-copy lang-copy--en">Previous</span></button>
          <button type="button" data-reader-next><span class="lang-copy lang-copy--de">Weiter</span><span class="lang-copy lang-copy--en">Next</span> →</button>
        </div>
      </aside>
    </div>

    <div class="measurement-reader__thumbs" data-reader-thumbs aria-label="Visual fieldbook plates">
      {measurementGateReaderPages.map((page, index) => (
        <button type="button" data-reader-index={index} aria-pressed={index === 0 ? "true" : "false"}>
          <img src={page.src} width={page.width} height={page.height} alt="" loading="lazy" />
          <span>{String(page.sequence).padStart(2, "0")}</span>
          <b>{page.title}</b>
        </button>
      ))}
    </div>

    <dialog class="measurement-reader__dialog" data-reader-dialog aria-labelledby="reader-dialog-title">
      <button type="button" data-reader-close aria-label="Close visual reader">×</button>
      <h3 id="reader-dialog-title" data-reader-dialog-title>{measurementGateReaderPages[0].title}</h3>
      <img data-reader-dialog-image src={measurementGateReaderPages[0].src} width={measurementGateReaderPages[0].width} height={measurementGateReaderPages[0].height} alt={measurementGateReaderPages[0].title} />
    </dialog>

    <div class="measurement-method-index">
      <p class="eyebrow"><span class="lang-copy lang-copy--de">Methodenindex</span><span class="lang-copy lang-copy--en">Method index</span></p>
      <ol>
      <li><span>01</span><h3>Relation</h3><p><span class="lang-copy lang-copy--de">Zyklen können verglichen werden, sobald Referenz und Rhythmus benannt sind.</span><span class="lang-copy lang-copy--en">Cycles become comparable once reference and rhythm are named.</span></p></li>
      <li><span>02</span><h3>Type</h3><p><span class="lang-copy lang-copy--de">Durchmesser, Radius, Halbachse und Separation bleiben verschiedene Größen.</span><span class="lang-copy lang-copy--en">Diameter, radius, semi-major axis and separation remain different quantities.</span></p></li>
      <li><span>03</span><h3>Carrier</h3><p><span class="lang-copy lang-copy--de">Ein Objekt, ein Datensatz oder ein materieller Record trägt die Spur.</span><span class="lang-copy lang-copy--en">An object, dataset or material record carries the trace.</span></p></li>
      <li><span>04</span><h3>Cut</h3><p><span class="lang-copy lang-copy--de">Der Schnitt macht etwas sichtbar und hält anderes zurück.</span><span class="lang-copy lang-copy--en">The cut makes something visible and withholds something else.</span></p></li>
      <li><span>05</span><h3>Trace</h3><p><span class="lang-copy lang-copy--de">Die Spur erinnert an den Schnitt, ohne den Träger vollständig zu enthalten.</span><span class="lang-copy lang-copy--en">The trace remembers the cut without containing the whole carrier.</span></p></li>
      <li><span>06</span><h3>Compare</h3><p><span class="lang-copy lang-copy--de">Nur typgleiche, referenzierte Felder dürfen direkt verglichen werden.</span><span class="lang-copy lang-copy--en">Only type-compatible, referenced fields may be directly compared.</span></p></li>
      <li><span>07</span><h3>Return</h3><p><span class="lang-copy lang-copy--de">Relation kann zurückkehren, bevor Zustand zurückkehrt.</span><span class="lang-copy lang-copy--en">Relation may return before state returns.</span></p></li>
      </ol>
    </div>
  </section>

  <section class="measurement-instrument" aria-labelledby="measurement-instrument-title">
    <div class="container">
      <header class="measurement-instrument__head">
        <div>
          <p class="eyebrow"><span class="lang-copy lang-copy--de">Von der Tafel zum Instrument</span><span class="lang-copy lang-copy--en">From plate to instrument</span></p>
          <h2 id="measurement-instrument-title">Saturn–Titan<br /><em>QRT Record.</em></h2>
        </div>
        <div>
          <p><span class="lang-copy lang-copy--de">Die beiden Fieldbook-Tafeln sind Ansichten dieses erhaltenen HTML-Instruments. Hier lässt sich der Schnitt tatsächlich wechseln: ein Träger, verschiedene Cuts, vergleichbare Spuren.</span><span class="lang-copy lang-copy--en">The two fieldbook plates are views of this preserved HTML instrument. Here the cut can actually be changed: one carrier, different cuts, comparable traces.</span></p>
          <p class="measurement-instrument__boundary"><strong><span class="lang-copy lang-copy--de">Grenze:</span><span class="lang-copy lang-copy--en">Boundary:</span></strong> <span class="lang-copy lang-copy--de">Anwendungsdemonstrator und Orientierungsanalogie — keine gemessene planetare Übertragungsfunktion.</span><span class="lang-copy lang-copy--en">Application demonstrator and orientation analogy—not a measured planetary transfer function.</span></p>
        </div>
      </header>
      <div class="measurement-instrument__frame">
        <iframe src="/review-assets/measurement-gate/saturn-titan-qrt-record.html" title="Saturn–Titan QRT Record interactive source" loading="lazy" sandbox="allow-scripts" referrerpolicy="no-referrer"></iframe>
      </div>
      <div class="measurement-instrument__source">
        <span>ART:HTML:CAAEAD5F19ED · SHA-256 d95993f32cd1e828…</span>
        <a class="button button--secondary" href="/review-assets/measurement-gate/saturn-titan-qrt-record.html" target="_blank" rel="noreferrer"><span class="lang-copy lang-copy--de">Instrument einzeln öffnen</span><span class="lang-copy lang-copy--en">Open instrument standalone</span> ↗</a>
      </div>
    </div>
  </section>

  <section class="measurement-connections container" aria-labelledby="measurement-connections-title">
    <header class="measurement-connections__head">
      <div>
        <p class="eyebrow"><span class="lang-copy lang-copy--de">Verbundene Instrumente · getrennte Schichten</span><span class="lang-copy lang-copy--en">Connected instruments · distinct layers</span></p>
        <h2 id="measurement-connections-title"><span class="lang-copy lang-copy--de">Was gehört wohin?</span><span class="lang-copy lang-copy--en">What belongs where?</span></h2>
      </div>
      <p><span class="lang-copy lang-copy--de">A0 liefert Orientierung und gemeinsame Begriffe. Experience macht ausgewählte Relationen erfahrbar. Runtime hält Cuts und Receipts transportierbar. Evidenz bleibt eine eigene, strengere Schicht.</span><span class="lang-copy lang-copy--en">A0 supplies orientation and shared terms. Experience makes selected relations inspectable. Runtime keeps cuts and receipts transportable. Evidence remains its own, stricter layer.</span></p>
    </header>
    <div class="measurement-connections__grid">
      <article>
        <small>SOURCE-BOUND DEEP DIVE · LOCAL CANDIDATE</small><h3>Interstellar Entry / Exit Lens</h3>
        <p><span class="lang-copy lang-copy--de">1I, 2I und die temporäre 3I-Lösung: gefrorene JPL-Quellen, Zweikörper-Asymptoten und entfernte Horizons-Vektoren bleiben vergleichbar, ohne daraus eine Vorhersage zu erfinden.</span><span class="lang-copy lang-copy--en">1I, 2I and the temporary 3I solution: frozen JPL sources, two-body asymptotes and distant Horizons vectors remain comparable without inventing a prediction.</span></p>
        <a href="/laboratory/roedelheim-observatory/measurement-gate/interstellar-entry-exit/"><span class="lang-copy lang-copy--de">Source Lens öffnen</span><span class="lang-copy lang-copy--en">Open source lens</span></a>
        <span class="measurement-connections__status">SOURCE LOCKED · RETURN UNRESOLVED · NO +1</span>
      </article>
      <article>
        <small>EXPERIENCE · EXISTING</small><h3>Five H · One Q°</h3>
        <p><span class="lang-copy lang-copy--de">Fünf reale Perioden, ein gemeinsamer Beobachtungszeitpunkt. Bereits in der Generation Corner eingebunden; keine zweite Kopie nötig.</span><span class="lang-copy lang-copy--en">Five real periods, one shared observation time. Already bound in Generation Corner; no second copy is needed.</span></p>
        <a href="/laboratory/roedelheim-observatory/generation-corner/#five-h"><span class="lang-copy lang-copy--de">Bestehendes Instrument öffnen</span><span class="lang-copy lang-copy--en">Open existing instrument</span> →</a>
      </article>
      <article>
        <small>RUNTIME · VALIDATED INFRASTRUCTURE</small><h3>Common Runtime Adapter</h3>
        <p><span class="lang-copy lang-copy--de">ART:RUNTIME:ADAPTER hält Profile, zwei Cuts, Residual und Receipt zusammen. Die interne Master-Version wird hier nicht still als öffentliches Instrument ausgegeben.</span><span class="lang-copy lang-copy--en">ART:RUNTIME:ADAPTER keeps profiles, two cuts, residual and receipt together. Its internal master is not silently presented here as a public instrument.</span></p>
        <span class="measurement-connections__status"><span class="lang-copy lang-copy--de">Nächster Schritt: reduzierte Public-View</span><span class="lang-copy lang-copy--en">Next step: reduced public view</span></span>
      </article>
      <article>
        <small>CONCEPT · NOT IMPLEMENTED</small><h3>Relations Through T</h3>
        <p><span class="lang-copy lang-copy--de">Eine dokumentierte Challenge für erhaltene und neu gesetzte Relationen durch T. Noch kein HTML-Instrument, keine Ausführung und keine Evidenzpromotion.</span><span class="lang-copy lang-copy--en">A documented challenge for preserved and newly introduced relations through T. Not yet an HTML instrument, an execution or an evidence promotion.</span></p>
        <span class="measurement-connections__status">IMPLEMENTATION: NO · EXECUTION: NO</span>
      </article>
      <article>
        <small>E2 · DESCRIPTIVE SUPPLEMENT</small><h3>HZ/FZ Contrast Compass</h3>
        <p><span class="lang-copy lang-copy--de">Reale externe Beobachtungen, aber nur ein deskriptiver E2-Zusatz. Die 0,5-Hz-Struktur ist ein inkonklusiver Kandidat; Achsenrotation erzeugt keine neue Evidenz.</span><span class="lang-copy lang-copy--en">Real external observations, but only a descriptive E2 supplement. The 0.5 Hz structure is an inconclusive candidate; rotating axes creates no new evidence.</span></p>
        <span class="measurement-connections__status">NO PROFILE ACTIVATION · REPLICATION REQUIRED</span>
      </article>
    </div>
    <p class="measurement-connections__a0"><strong>A0 / Zeta Timegear:</strong> <span class="lang-copy lang-copy--de">gemeinsames Zyklus-Lineal und Orientierungsmodell; verwandt mit diesem Gate, aber nicht dessen Messresultat.</span><span class="lang-copy lang-copy--en">a shared cycle ruler and orientation model; related to this gate, but not its measurement result.</span></p>
  </section>

  <section class="measurement-miwa" aria-labelledby="measurement-miwa-title">
    <div class="container measurement-miwa__grid">
      <div class="measurement-miwa__mark" aria-hidden="true"><span></span><span></span><b>Q</b></div>
      <div>
        <p class="eyebrow">Next instrument · MIWA</p>
        <h2 id="measurement-miwa-title"><span class="lang-copy lang-copy--de">Wenn die Messadresse steht, beginnt der Framevergleich.</span><span class="lang-copy lang-copy--en">Once the measurement address is declared, frame comparison begins.</span></h2>
        <p><span class="lang-copy lang-copy--de">MIWA übernimmt keinen nackten Wert. Es übernimmt einen quellgebundenen Record und hält Milky-Way-, Aperture- und Andromeda-Frame unterscheidbar. Eine spätere Erweiterung kann Measurement-Gate-Receipts als Eingabe lesen, ohne das historische Instrument still zu überschreiben.</span><span class="lang-copy lang-copy--en">MIWA receives no bare value. It receives a source-bound record and keeps Milky Way, Aperture and Andromeda frames distinguishable. A later extension can read Measurement Gate receipts without silently overwriting the historical instrument.</span></p>
        <a class="button" href="/laboratory/roedelheim-observatory/rooms/miwa-aperture-andromeda/"><span class="lang-copy lang-copy--de">Bestehendes MIWA öffnen</span><span class="lang-copy lang-copy--en">Open existing MIWA</span> <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <aside id="source-boundaries" class="measurement-source-boundary container">
    <p class="eyebrow"><span class="lang-copy lang-copy--de">Quellen- und Versionsgrenze</span><span class="lang-copy lang-copy--en">Source and version boundary</span></p>
    <p><span class="lang-copy lang-copy--de">Kandidat vom 19. November 2026. Fünf quellgebundene Fälle; ED₁₃₈ ist als vorläufiger TNO- und Resonanzrand-Kandidat gekennzeichnet. Keine neue Navigator-Identität, kein bestätigtes Forschungsergebnis und keine aktivierte Preregistrierung.</span><span class="lang-copy lang-copy--en">Candidate dated 19 November 2026. Five source-bound cases; ED₁₃₈ is marked as a provisional TNO and resonance-edge candidate. No new Navigator identity, confirmed research result or activated preregistration.</span></p>
  </aside>

  <script is:inline type="application/json" id="measurement-gate-data" set:html={gateData}></script>
</BaseLayout>

<script>
  type Language = "de" | "en";
  type GateCase = (typeof import("@/data/measurement-gate").measurementGateCases)[number];
  type ReaderPage = (typeof import("@/data/measurement-gate-reader").measurementGateReaderPages)[number];
  const dataNode = document.querySelector<HTMLScriptElement>("#measurement-gate-data");
  const data = dataNode ? JSON.parse(dataNode.textContent || "{}") as { cases: GateCase[]; readerPages: ReaderPage[] } : { cases: [], readerPages: [] };
  let caseId: string | undefined = data.cases[0]?.id;
  let quantityId: string | undefined = data.cases[0]?.quantities[0]?.id;
  let readerIndex = 0;
  const one = <T extends Element>(selector: string) => document.querySelector<T>(selector);
  const language = (): Language => document.documentElement.dataset.siteLanguage === "de" ? "de" : "en";
  const currentCase = () => data.cases.find((entry) => entry.id === caseId) ?? data.cases[0];
  const currentQuantity = () => currentCase()?.quantities.find((entry) => entry.id === quantityId) ?? currentCase()?.quantities[0];
  const escape = (value: unknown) => String(value).replace(/[&<>"']/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[character] ?? character);
  const local = (entry: Record<string, unknown>, key: string) => String(language() === "de" ? entry[`${key}De`] ?? entry[key] : entry[key]);

  function drawConic(entry: GateCase, quantity: GateCase["quantities"][number]) {
    const hyperbolic = entry.return.class === "HYPERBOLIC";
    const orbit = hyperbolic
      ? '<path class="gate-pink" d="M520 330C570 215 665 155 830 130"/><path class="gate-pink gate-thin" d="M520 330C570 445 665 505 830 530"/>'
      : '<ellipse class="gate-cyan" cx="455" cy="330" rx="280" ry="145"/><path class="gate-cyan gate-thin" d="M190 330l-20-10m20 10l-20 10"/>';
    return `<svg viewBox="0 0 900 600" role="img" aria-label="${escape(entry.return.class)}"><path class="gate-grid" d="M60 330H850M520 70V550"/><circle cx="520" cy="330" r="31" class="gate-sun"/>${orbit}<text x="60" y="75">Q° PORT · CONIC GATE</text><text class="gate-small" x="60" y="105">typed classification · schematic · not to scale</text><text x="60" y="535">${escape(entry.return.class)}</text><text class="gate-small" x="60" y="565">${escape(quantity.symbol)} = ${escape(quantity.display)} ${escape(quantity.unit)}</text></svg>`;
  }

  function drawResonance(quantity: GateCase["quantities"][number]) {
    const rows = [["4:1",2.065],["3:1",2.501],["5:2",2.825],["7:3",2.958],["2:1",3.278],["3:2",3.971],["1:1",5.203]] as const;
    return `<svg viewBox="0 0 900 600" role="img" aria-label="Jupiter resonance coordinates"><text x="55" y="65">JUPITER · RESONANCE COORDINATES</text><text class="gate-small" x="55" y="95">a = aJ · (q/p)^(2/3) · aJ = 5.203 au</text><line class="gate-axis-line" x1="90" y1="430" x2="820" y2="430"/>${rows.map(([id,value]) => { const x = 90 + (value - 2) / 3.203 * 730; const active = id === quantity.id; return `<line x1="${x}" y1="${active ? 150 : 235}" x2="${x}" y2="430" class="${active ? "gate-pink" : "gate-cyan gate-thin"}"/><circle cx="${x}" cy="430" r="${active ? 9 : 5}" class="gate-point"/><text class="gate-small" x="${x-15}" y="${active ? 130 : 215}">${id}</text><text class="gate-small" x="${x-24}" y="${active ? 108 : 193}">${value}</text>`; }).join("")}<circle cx="820" cy="430" r="34" class="gate-jupiter"/><text class="gate-small" x="55" y="555">COORDINATE ≠ OUTCOME · CONDITIONS REMAIN REQUIRED</text></svg>`;
  }

  function drawRecord(quantity: GateCase["quantities"][number]) {
    const rings = quantity.id === "ep45" ? 3 : quantity.id === "lp33" ? 6 : 9;
    return `<svg viewBox="0 0 900 600" role="img" aria-label="Record carrier cut and trace analogy"><text x="55" y="65">SATURN–TITAN · QRT RECORD</text><text class="gate-small" x="55" y="95">one carrier · selected cut · comparable trace</text><path class="gate-cyan" d="M55 300C120 245 165 355 245 300"/>${Array.from({length:rings},(_,index) => `<ellipse cx="430" cy="300" rx="${120+index*14}" ry="${52+index*7}" class="${index===rings-1 ? "gate-pink" : "gate-gold gate-thin"}"/>`).join("")}<circle cx="430" cy="300" r="72" class="gate-saturn"/><line x1="430" y1="300" x2="650" y2="195" class="gate-green"/><circle cx="650" cy="195" r="17" class="gate-green-fill"/><path d="M690 225A76 76 0 0 1 690 375Z" class="gate-mask-light"/><path d="M690 225A76 76 0 0 0 690 375Z" class="gate-mask-dark"/><line x1="690" y1="215" x2="690" y2="385" class="gate-pink"/><path class="gate-gold" d="M780 300h18l8-48 13 95 14-80 16 64 16-31h20"/><text class="gate-small" x="55" y="530">${escape(quantity.display)} ${escape(quantity.unit)}</text><text class="gate-small" x="55" y="560">ANALOGY ONLY · NO MEASURED PLANETARY TRANSFER FUNCTION</text></svg>`;
  }

  function drawOrbitComparator(quantity: GateCase["quantities"][number]) {
    return `<svg viewBox="0 0 900 600" role="img" aria-label="2026 ED138 and Eris orbit comparison"><text x="55" y="65">2026 ED₁₃₈ · ERIS — SAME NEIGHBORHOOD, DIFFERENT ORBITS</text><text class="gate-small" x="55" y="95">barycentric orientation comparison · reference paths are schematic</text><circle cx="450" cy="315" r="18" class="gate-sun"/><ellipse cx="450" cy="315" rx="285" ry="275" class="gate-pink gate-thin"/><ellipse cx="450" cy="315" rx="400" ry="155" class="gate-cyan"/><circle cx="708" cy="222" r="10" class="gate-point"/><circle cx="812" cy="315" r="10" class="gate-green-fill"/><text class="gate-small" x="625" y="180">ED₁₃₈ · a 43.09 au · e 0.139 · i 24.4°</text><text class="gate-small" x="510" y="520">ERIS REFERENCE · a ≈ 68 au · e ≈ 0.44 · i ≈ 44°</text><line x1="450" y1="315" x2="690" y2="315" class="gate-gold gate-thin"/><text class="gate-small" x="500" y="300">q ED₁₃₈ = 37.113 au</text><text class="gate-small" x="55" y="555">${escape(quantity.symbol)} = ${escape(quantity.display)} ${escape(quantity.unit)} · COMPARISON ≠ IDENTITY</text></svg>`;
  }

  function render() {
    const entry = currentCase();
    const quantity = currentQuantity();
    if (!entry || !quantity) return;
    const lang = language();
    const cases = one<HTMLElement>("[data-measurement-cases]");
    if (cases) {
      cases.innerHTML = data.cases.map((item, index) => `<button type="button" data-case="${escape(item.id)}" aria-pressed="${item.id === entry.id}"><small>CASE ${String(index + 1).padStart(2,"0")}</small><strong>${escape(item.label)}</strong><span>${escape(local(item as unknown as Record<string, unknown>, "subtitle"))}</span></button>`).join("");
      cases.querySelectorAll<HTMLButtonElement>("button").forEach((button) => button.addEventListener("click", () => { caseId = button.dataset.case; quantityId = currentCase().quantities[0].id; render(); }));
    }
    const select = one<HTMLSelectElement>("[data-measurement-quantity]");
    if (select) select.innerHTML = entry.quantities.map((item) => `<option value="${escape(item.id)}" ${item.id === quantity.id ? "selected" : ""}>${escape(local(item as unknown as Record<string, unknown>, "type"))} · ${escape(item.symbol)}</option>`).join("");
    const meta = one<HTMLElement>("[data-measurement-meta]");
    if (meta) meta.innerHTML = [[lang === "de" ? "Träger" : "Carrier",entry.carrier.object],[lang === "de" ? "Rahmen" : "Frame",local(entry.carrier as unknown as Record<string, unknown>,"frame")],[lang === "de" ? "Autorität" : "Authority",entry.source.authority],[lang === "de" ? "Version" : "Version",entry.source.version],[lang === "de" ? "Epoche" : "Epoch",entry.source.epoch]].map(([key,value]) => `<div><dt>${escape(key)}</dt><dd>${escape(value)}</dd></div>`).join("");
    const put = (selector: string, value: string) => { const node = one<HTMLElement>(selector); if (node) node.textContent = value; };
    put("[data-measurement-qualifier]", `${quantity.symbol} · ${local(quantity as unknown as Record<string, unknown>, "qualifier")}`);
    put("[data-measurement-value]", quantity.display); put("[data-measurement-unit]", quantity.unit);
    put("[data-measurement-type]", local(quantity as unknown as Record<string, unknown>, "type"));
    put("[data-measurement-note]", local(quantity as unknown as Record<string, unknown>, "note"));
    const operator = one<HTMLElement>("[data-measurement-operator]");
    if (operator) operator.innerHTML = `<span>${escape(entry.operator.replaceAll("_", " "))}</span><b>${entry.analogy ? (lang === "de" ? "ANALOGIE" : "ANALOGY") : (lang === "de" ? "KLASSIFIKATION / ABLEITUNG" : "CLASSIFICATION / DERIVATION")}</b>`;
    const visual = one<HTMLElement>("[data-measurement-visual]");
    if (visual) visual.innerHTML = entry.operator === "CONIC_GATE" ? drawConic(entry, quantity) : entry.operator === "ORBIT_COMPARATOR" ? drawOrbitComparator(quantity) : entry.operator === "RESONANCE_SORTER" ? drawResonance(quantity) : drawRecord(quantity);
    put("[data-measurement-source-title]", entry.carrier.object);
    put("[data-measurement-source-copy]", `${local(quantity as unknown as Record<string, unknown>, "type")}: ${quantity.display} ${quantity.unit}. ${local(quantity as unknown as Record<string, unknown>, "qualifier")}.`);
    put("[data-measurement-trace-title]", local(entry.trace as unknown as Record<string, unknown>, "title"));
    put("[data-measurement-trace-copy]", local(entry.trace as unknown as Record<string, unknown>, "text"));
    const cards = one<HTMLElement>("[data-measurement-return-cards]");
    const sourceReferences = "references" in entry.source ? entry.source.references : [];
    const sourceLinks = [`<a href="${escape(entry.source.url)}">${escape(entry.source.authority)} · ${escape(entry.source.title)}</a>`, ...sourceReferences.map((reference) => `<a href="${escape(reference.url)}">${escape(reference.authority)} · ${escape(reference.title)}</a>`)].join("<br />");
    const groups = [
      [lang === "de" ? "Quellen" : "Sources", sourceLinks],
      [lang === "de" ? "Erhalten" : "Preserved", escape((lang === "de" ? entry.return.preservesDe : entry.return.preserves).join(" · "))],
      [lang === "de" ? "Unterdrückt" : "Suppressed", escape((lang === "de" ? entry.return.suppressesDe : entry.return.suppresses).join(" · "))],
      [lang === "de" ? "Behauptet nicht" : "Does not claim", escape((lang === "de" ? entry.return.nonclaimsDe : entry.return.nonclaims).join(" · "))],
    ];
    if (cards) cards.innerHTML = groups.map(([title,copy]) => `<article><small>${title}</small><p>${copy}</p></article>`).join("");
    put("[data-measurement-status]", entry.return.status);
    const receipt = { schema: "nexah.measurement-gate.receipt.v1", generated_from: "pinned local data", case_id: entry.id, source: entry.source, carrier: entry.carrier, selected_quantity: { type: quantity.type, symbol: quantity.symbol, value: quantity.display, unit: quantity.unit, qualifier: quantity.qualifier }, operator: entry.operator, return: entry.return, claim_ceiling: entry.analogy ? "orientation analogy only" : "typed classification or declared derivation; no new physical law" };
    put("[data-measurement-receipt]", JSON.stringify(receipt, null, 2));
  }

  function renderReader() {
    const page = data.readerPages[readerIndex];
    if (!page) return;
    const lang = language();
    const title = lang === "de" ? page.titleDe : page.title;
    const caption = lang === "de" ? page.captionDe : page.caption;
    const boundary = lang === "de" ? page.boundaryDe : page.boundary;
    const put = (selector: string, value: string) => { const node = one<HTMLElement>(selector); if (node) node.textContent = value; };
    const image = one<HTMLImageElement>("[data-reader-image]");
    const dialogImage = one<HTMLImageElement>("[data-reader-dialog-image]");
    for (const node of [image, dialogImage]) {
      if (!node) continue;
      node.src = page.src;
      node.alt = title;
      node.width = page.width;
      node.height = page.height;
    }
    put("[data-reader-counter]", `${String(page.sequence).padStart(2, "0")} / ${String(data.readerPages.length).padStart(2, "0")}`);
    put("[data-reader-status]", page.status);
    put("[data-reader-title]", title);
    put("[data-reader-dialog-title]", title);
    put("[data-reader-caption]", caption);
    put("[data-reader-boundary]", boundary);
    put("[data-reader-source]", page.sourceFile);
    put("[data-reader-binding]", `${page.artifactId ? `${page.artifactId} · ` : ""}SHA-256 · ${page.assetSha256.slice(0, 16)}…`);
    const previous = one<HTMLButtonElement>("[data-reader-prev]");
    const next = one<HTMLButtonElement>("[data-reader-next]");
    if (previous) previous.disabled = readerIndex === 0;
    if (next) next.disabled = readerIndex === data.readerPages.length - 1;
    document.querySelectorAll<HTMLButtonElement>("[data-reader-index]").forEach((button) => {
      button.setAttribute("aria-pressed", String(Number(button.dataset.readerIndex) === readerIndex));
    });
  }

  one<HTMLSelectElement>("[data-measurement-quantity]")?.addEventListener("change", (event) => { quantityId = (event.currentTarget as HTMLSelectElement).value; render(); });
  one<HTMLButtonElement>("[data-copy-measurement]")?.addEventListener("click", async (event) => { const button = event.currentTarget as HTMLButtonElement; const receipt = one<HTMLElement>("[data-measurement-receipt]")?.textContent ?? ""; try { await navigator.clipboard.writeText(receipt); button.dataset.copied = "true"; setTimeout(() => delete button.dataset.copied, 1500); } catch { button.dataset.copied = "false"; } });
  one<HTMLButtonElement>("[data-reader-prev]")?.addEventListener("click", () => { if (readerIndex > 0) { readerIndex -= 1; renderReader(); } });
  one<HTMLButtonElement>("[data-reader-next]")?.addEventListener("click", () => { if (readerIndex < data.readerPages.length - 1) { readerIndex += 1; renderReader(); } });
  document.querySelectorAll<HTMLButtonElement>("[data-reader-index]").forEach((button) => button.addEventListener("click", () => { readerIndex = Number(button.dataset.readerIndex ?? 0); renderReader(); one<HTMLElement>("[data-reader-root]")?.scrollIntoView({ behavior: "smooth", block: "center" }); }));
  const readerDialog = one<HTMLDialogElement>("[data-reader-dialog]");
  one<HTMLButtonElement>("[data-reader-open]")?.addEventListener("click", () => readerDialog?.showModal());
  one<HTMLButtonElement>("[data-reader-close]")?.addEventListener("click", () => readerDialog?.close());
  readerDialog?.addEventListener("click", (event) => { if (event.target === readerDialog) readerDialog.close(); });
  window.addEventListener("nexah:language-changed", () => { render(); renderReader(); });
  render();
  renderReader();
</script>

