---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildSCC003Stage, projectNode } from "@/lib/scc003-quotient-construction.mjs";

const polarWeb = buildSCC003Stage(6);
const polarWebPoints = new Map(
  polarWeb.nodes.map((node) => [node.id, projectNode(node, polarWeb.index, 760, 620)]),
);
const polarWebRings = Array.from({ length: 6 }, (_, index) => {
  const radius = (index + 1) * 42;
  return Array.from({ length: 5 }, (_, face) => {
    const angle = -Math.PI / 2 + face * ((Math.PI * 2) / 5);
    return `${380 + Math.cos(angle) * radius},${318 + Math.sin(angle) * radius}`;
  }).join(" ");
});
const polarMarkerPosition = (radius: number) => {
  const angle = -Math.PI / 2 + Math.PI / 5;
  return [380 + Math.cos(angle) * radius, 318 + Math.sin(angle) * radius];
};
const polarMarkerIn = polarMarkerPosition(84);
const polarMarkerOut = polarMarkerPosition(252);

const chapters = [
  {
    number: "01",
    label: "Cut",
    title: "A world becomes a record.",
    body: "A living event is never carried whole. Selection decides what may enter; projection decides how it can appear. The record is a held cut—not the event itself.",
    equation: "Oᵅ,ᵝ = P(A(Sₜ))",
    color: "sky",
  },
  {
    number: "02",
    label: "Relation",
    title: "Two cuts produce a difference.",
    body: "A and B do not disclose an absolute view. Their declared selections and projections make a difference ΔAB inspectable. C observes that relation with a cut of its own.",
    equation: "A(B) ≠ B(A)",
    color: "orange",
  },
  {
    number: "03",
    label: "Intervention",
    title: "Observation enters the history.",
    body: "Comparison can lead to an intervention. The field becomes S′(t), and every later observer encounters a world that already carries the trace of what happened.",
    equation: "C @ Sₜ → S′ₜ₊₁",
    color: "sage",
  },
  {
    number: "04",
    label: "Generation",
    title: "The architecture returns. The state does not.",
    body: "New perspectives D, E and F bind a new relation G around S′. The grammar repeats, but it operates on another world-state. A cycle closes a function, never the history.",
    equation: "D / E / F → G → S″",
    color: "violet",
  },
  {
    number: "05",
    label: "Court",
    title: "A cut becomes the next source.",
    body: "Q₁ unfolds a court H₁. A bounded expression of that court can become Q₂, the source of a further court. Source and court alternate roles without becoming identical.",
    equation: "Q₁ → H₁ → Q₂ → H₂",
    color: "pink",
  },
  {
    number: "06",
    label: "Branch",
    title: "One court can open several futures.",
    body: "H₁ may yield Q₂ᵃ, Q₂ᵇ and Q₂ᶜ. Forward movement branches; the return remains genealogical. It can reconstruct provenance, not restore an earlier state.",
    equation: "H₁ → { Q₂ᵃ, Q₂ᵇ, Q₂ᶜ }",
    color: "gold",
  },
] as const;

const prologue = [
  ["01", "The hinge", "A phase changes with relation, light and the local observer."],
  ["02", "The trace", "A moving state leaves a record only through declared coordinates and time."],
  ["03", "The cut", "A frame selects visible segments and retains the history of its gaps."],
] as const;
---

<BaseLayout
  title="The Generation Corner — Rödelheim Observatory"
  description="A source-bound visual reading of cut, relation, generation, source, court and genealogical return along the local Q° observer axis."
  lang="en"
>
  <article class="corner">
    <header class="corner-hero">
      <div class="corner-hero__copy container">
        <a class="corner-back" href="/laboratory/roedelheim-observatory/">← Rödelheim Observatory</a>
        <p class="corner-kicker">A local Q° reading · source-bound editorial lens</p>
        <h1>The Generation<br /><em>Corner.</em></h1>
        <p class="corner-deck">Source becomes court. A cut becomes a source. The architecture returns—while the world moves on.</p>
        <nav aria-label="Generation Corner chapters">
          <a href="#prologue">Three plates</a>
          <a href="#axis-story">Follow Q°</a>
          <a href="#held-instruments">Held instruments</a>
          <a href="#polar-web">Polar web</a>
          <a href="#source-ledger">Source boundary</a>
        </nav>
      </div>

      <div class="corner-hero__field" aria-hidden="true">
        <svg viewBox="0 0 1200 760">
          <defs>
            <radialGradient id="heroGlow" cx="50%" cy="50%" r="50%">
              <stop offset="0" stop-color="#43cae7" stop-opacity=".2" />
              <stop offset=".5" stop-color="#e548b5" stop-opacity=".08" />
              <stop offset="1" stop-color="#07131e" stop-opacity="0" />
            </radialGradient>
            <marker id="heroArrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
            </marker>
          </defs>
          <circle cx="600" cy="380" r="330" fill="url(#heroGlow)" />
          <path class="hero-orbit hero-orbit--a" d="M175 380 C315 90 885 90 1025 380 C885 670 315 670 175 380Z" />
          <path class="hero-orbit hero-orbit--b" d="M260 175 C535 230 680 610 930 550 C790 315 475 240 260 175Z" />
          <path class="hero-return" d="M930 550 C790 715 360 700 230 485" marker-end="url(#heroArrow)" />
          <line class="hero-axis" x1="600" y1="40" x2="600" y2="720" />
          <circle class="hero-q" cx="600" cy="380" r="47" />
          <circle class="hero-node hero-node--source" cx="270" cy="250" r="62" />
          <circle class="hero-node hero-node--court" cx="850" cy="230" r="94" />
          <circle class="hero-node hero-node--source-two" cx="850" cy="555" r="55" />
          <text class="hero-label" x="600" y="390" text-anchor="middle">Q°</text>
          <text class="hero-label" x="270" y="258" text-anchor="middle">Q₁</text>
          <text class="hero-label" x="850" y="239" text-anchor="middle">H₁</text>
          <text class="hero-label" x="850" y="564" text-anchor="middle">Q₂</text>
          <text class="hero-axis-label" x="620" y="80">LOCAL OBSERVER AXIS</text>
          <text class="hero-small" x="270" y="335" text-anchor="middle">SOURCE</text>
          <text class="hero-small" x="850" y="345" text-anchor="middle">COURT / RELATION FIELD</text>
          <text class="hero-small" x="850" y="635" text-anchor="middle">NEXT SOURCE</text>
        </svg>
      </div>
    </header>

    <section id="prologue" class="prologue" aria-labelledby="prologue-title">
      <div class="container">
        <header class="prologue__header">
          <p class="corner-kicker">Prologue · three ways a world becomes visible</p>
          <h2 id="prologue-title">Before generation,<br />there is a cut.</h2>
          <p>The first three plates establish the reading grammar: appearance, retained trace and missing record are not the same thing.</p>
        </header>
        <ol class="prologue__grid">
          {prologue.map(([number, title, body], index) => (
            <li>
              <div class={`plate plate--${index + 1}`} aria-hidden="true">
                {index === 0 && <><span class="plate-sun"></span><span class="plate-moon"></span><span class="plate-earth">Q°</span><i></i></>}
                {index === 1 && <><span class="trace trace--one"></span><span class="trace trace--two"></span><span class="trace trace--three"></span><b>t₀</b><b>t₁</b><b>t₂</b></>}
                {index === 2 && <><span class="cut-path"></span><span class="cut-mask"></span><span class="cut-gap"></span></>}
              </div>
              <span class="prologue__number">{number}</span>
              <h3>{title}</h3>
              <p>{body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="axis-story" class="axis-story" aria-labelledby="axis-title">
      <header class="axis-story__intro container">
        <p class="corner-kicker">The transversal</p>
        <h2 id="axis-title">Q° does not become<br />another generation.</h2>
        <p>It is the declared local axis through which each generation is selected, projected and returned as a record.</p>
      </header>

      <div class="axis-story__body container">
        <aside class="q-axis" aria-label="Q degree observer axis">
          <div class="q-axis__head"><span>Q°</span><small>Rödelheim<br />local observer</small></div>
          <div class="q-axis__line"><i></i></div>
          <ol>
            {chapters.map((chapter) => <li data-axis-step={chapter.number}><span>{chapter.number}</span>{chapter.label}</li>)}
          </ol>
        </aside>

        <div class="chapters">
          {chapters.map((chapter, index) => (
            <section class={`chapter chapter--${chapter.color}`} data-chapter={chapter.number} aria-labelledby={`chapter-${chapter.number}`}>
              <div class="chapter__copy">
                <p class="chapter__index">{chapter.number} · {chapter.label}</p>
                <h3 id={`chapter-${chapter.number}`}>{chapter.title}</h3>
                <p>{chapter.body}</p>
                <code>{chapter.equation}</code>
              </div>

              <div class={`chapter__diagram diagram diagram--${index + 1}`} aria-hidden="true">
                {index === 0 && <>
                  <span class="shape shape--world">S(t)</span><i></i><span class="shape shape--select">A</span><i></i><span class="shape shape--project">P</span><i></i><span class="shape shape--record">O</span>
                </>}
                {index === 1 && <>
                  <span class="shape shape--a">A</span><span class="shape shape--b">B</span><i></i><span class="shape shape--delta">ΔAB</span><span class="shape shape--c">C</span>
                </>}
                {index === 2 && <>
                  <span class="shape shape--field">S(t)</span><span class="shape shape--observer">C</span><i></i><span class="shape shape--field-next">S′(t)</span><b>INTERVENTION</b>
                </>}
                {index === 3 && <>
                  <span class="shape shape--d">D</span><span class="shape shape--e">E</span><span class="shape shape--f">F</span><span class="shape shape--g">G</span><span class="shape shape--state-two">S″</span><i></i>
                </>}
                {index === 4 && <>
                  <span class="shape shape--q1">Q₁</span><span class="shape shape--h1"><b>H₁</b><small>court</small></span><span class="shape shape--q2">Q₂</span><span class="shape shape--h2">H₂</span><i></i><i></i><i></i>
                </>}
                {index === 5 && <>
                  <span class="shape shape--branch-h">H₁</span><span class="shape shape--qa">Q₂ᵃ</span><span class="shape shape--qb">Q₂ᵇ</span><span class="shape shape--qc">Q₂ᶜ</span><span class="shape shape--return">↶</span><i></i><i></i><i></i>
                </>}
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section id="held-instruments" class="held-instruments" aria-labelledby="instruments-title">
      <header class="held-instruments__header container">
        <p class="corner-kicker">Three held instruments · one reading sequence</p>
        <h2 id="instruments-title">The grammar becomes<br />inspectable.</h2>
        <p>Two existing read-only instruments and one exact SCC-003 projection are held inside the same editorial path. The third adds a two-state marker without changing the quotient.</p>
      </header>

      <article id="five-h" class="held-instrument held-instrument--five-h">
        <div class="held-instrument__copy container">
          <div>
            <p class="corner-kicker">Instrument I · Five H · One Q°</p>
            <h3>Q° holds the cut.</h3>
          </div>
          <div>
            <p>The phase-and-gate instrument makes the operational chain explicit: carrier, local cut, projection, trace, mask and held record.</p>
            <code>Hⱼ → Q° → ΠQ → TRACE → MASK → T³(q)</code>
            <p class="held-instrument__boundary">Reuses <code>ART:FIVE_H:ONE_Q_CUT</code>. It is a reading grammar, not an identity claim about SCC-003.</p>
          </div>
        </div>
        <iframe
          title="Five H · One Q degree canonical read-only instrument"
          src="/review-assets/scc-003-r1/demonstrators/five-h-one-q-cut.html"
          loading="lazy"
          referrerpolicy="no-referrer"
        ></iframe>
        <footer class="container held-instrument__footer">
          <span>CANONICAL READ-ONLY PROJECTION</span>
          <a href="/scc-003-r1/five-h-binding/">Open technical provenance record ↗</a>
        </footer>
      </article>

      <article id="complex-fold" class="held-instrument held-instrument--fold">
        <div class="held-instrument__copy container">
          <div>
            <p class="corner-kicker">Instrument II · Complex Fold · 101 / A0 return</p>
            <h3>The record carries its address.</h3>
          </div>
          <div>
            <p>The fold demonstrator keeps the 101-carrier, O/Cube pivot, A0 return, Root 432 and Keystone 2501 as typed views inside the existing SCC-003 documentation surface.</p>
            <code>101 → O/CUBE → A0 → ROOT 432 → RETURN</code>
            <p class="held-instrument__boundary">The selected capsule is an address projection. It creates no new Family, mechanism, Navigator identity or Source-Graph relation.</p>
          </div>
        </div>
        <iframe
          title="Complex Fold Root 432 and Keystone 2501 documentary instrument"
          src="/review-assets/scc-003-r1/demonstrators/complex-fold-18x23.html?rev=crt-fold-address-20261110#root432-keystone-capsule"
          loading="lazy"
          sandbox="allow-scripts allow-same-origin"
        ></iframe>
        <footer class="container held-instrument__footer">
          <span>EXISTING SCC-003 / A0 DOCUMENTARY SURFACE</span>
          <a href="/scc-003-r1/generation-study/#root-gap-demonstrators-title">Return to the Red Balloon notebook ↗</a>
        </footer>
      </article>

      <article id="polar-web" class="held-instrument polar-web" data-polar-state="in">
        <div class="held-instrument__copy container">
          <div>
            <p class="corner-kicker">Instrument III · Polar Web · Red Balloon</p>
            <h3>The marker goes in.<br />And out.</h3>
          </div>
          <div>
            <p>The exact closed SCC-003 quotient is projected across five angular faces and seven depth levels. A red display marker moves between an inner and an outer address band inside the selected face F0.</p>
            <code>s ∈ &#123;IN, OUT&#125; · τ(IN)=OUT · τ(OUT)=IN · τ²=id</code>
            <p class="held-instrument__boundary">The marker is not a quotient vertex. F0 is the selected face; A is the common apex. The toggle adds no state to the 106-class proof object.</p>
          </div>
        </div>

        <div class="container polar-web__instrument">
          <div class="polar-web__controls" aria-label="Red Balloon display state">
            <div>
              <button type="button" data-polar-state-button="in" aria-pressed="true">IN · inner band</button>
              <button type="button" data-polar-state-button="out" aria-pressed="false">OUT · outer band</button>
              <button type="button" data-polar-toggle>Toggle τ</button>
            </div>
            <p aria-live="polite"><span>Display state</span><strong data-polar-readout>IN · level 2 / 6</strong></p>
          </div>

          <figure class="polar-web__figure">
            <svg viewBox="0 0 760 620" role="img" aria-labelledby="polar-web-title polar-web-desc">
              <title id="polar-web-title">SCC-003 quotient in a polar web projection with a two-state red marker</title>
              <desc id="polar-web-desc">The exact graph has 106 quotient classes and 180 directed edges. Five face sectors and seven depth levels form the projection scaffold. A separate red marker can move between inner and outer bands of face F0.</desc>
              <defs>
                <filter id="polarBalloonGlow" x="-150%" y="-150%" width="400%" height="400%">
                  <feGaussianBlur stdDeviation="7" result="blur" />
                  <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
                </filter>
                <marker id="polarArrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto">
                  <path d="M0 0 L10 5 L0 10Z" />
                </marker>
              </defs>

              <g class="polar-web__guides" aria-hidden="true">
                {polarWebRings.map((points, index) => <polygon points={points} data-level={index + 1} />)}
                {Array.from({ length: 5 }, (_, face) => {
                  const angle = -Math.PI / 2 + face * ((Math.PI * 2) / 5);
                  const x = 380 + Math.cos(angle) * 276;
                  const y = 318 + Math.sin(angle) * 276;
                  return <line x1="380" y1="318" x2={x} y2={y} />;
                })}
              </g>

              <g class="polar-web__edges" aria-hidden="true">
                {polarWeb.edges.map(([source, target]) => {
                  const [x1, y1] = polarWebPoints.get(source)!;
                  const [x2, y2] = polarWebPoints.get(target)!;
                  return <line x1={x1} y1={y1} x2={x2} y2={y2} marker-end="url(#polarArrow)" />;
                })}
              </g>

              <g class="polar-web__nodes" aria-hidden="true">
                {polarWeb.nodes.map((node) => {
                  const [cx, cy] = polarWebPoints.get(node.id)!;
                  return <circle cx={cx} cy={cy} r={node.id === "A" ? 7 : node.seam ? 4.2 : 3.1} class:list={{ "is-apex": node.id === "A", "is-seam": node.seam }} />;
                })}
              </g>

              <path class="polar-web__state-path" d={`M${polarMarkerIn[0]} ${polarMarkerIn[1]} L${polarMarkerOut[0]} ${polarMarkerOut[1]}`} aria-hidden="true" />
              <g class="polar-web__marker" data-polar-marker style={`--polar-in-x:${polarMarkerIn[0]}px;--polar-in-y:${polarMarkerIn[1]}px;--polar-out-x:${polarMarkerOut[0]}px;--polar-out-y:${polarMarkerOut[1]}px`} aria-hidden="true">
                <circle r="13" />
                <path d="M0 13 C-3 21 5 24 1 31" />
              </g>

              <text x="380" y="324" class="polar-web__apex-label">A</text>
              <text x="505" y="135" class="polar-web__face-label polar-web__face-label--active">F0</text>
              <text x="635" y="350" class="polar-web__face-label">F1</text>
              <text x="455" y="585" class="polar-web__face-label">F2</text>
              <text x="270" y="585" class="polar-web__face-label">F3</text>
              <text x="105" y="350" class="polar-web__face-label">F4</text>
            </svg>
            <figcaption>Exact finite graph projection: every pale point is one quotient class and every arrow one of the deduplicated directed recurrence edges. The pentagonal web is a deterministic display coordinate—not a force, metric, planar embedding or spider-web mechanics model.</figcaption>
          </figure>

          <dl class="polar-web__ledger">
            <div><dt>Quotient classes</dt><dd>{polarWeb.nodes.length}</dd></div>
            <div><dt>Directed edges</dt><dd>{polarWeb.edges.length}</dd></div>
            <div><dt>Angular faces</dt><dd>5 · F0…F4</dd></div>
            <div><dt>Depth levels</dt><dd>7 · n=0…6</dd></div>
            <div><dt>Marker states</dt><dd>2 · display only</dd></div>
          </dl>
        </div>

        <footer class="container held-instrument__footer">
          <span>SAME SCC-003 IDENTITY · NO GRAPH DELTA</span>
          <a href="/scc-003-r1/proof/">Inspect the frozen Proof Capsule ↗</a>
        </footer>
      </article>
    </section>

    <section class="return-field" aria-labelledby="return-title">
      <div class="return-field__sky" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
      <div class="container return-field__copy">
        <p class="corner-kicker">Human return · Rödelheim</p>
        <h2 id="return-title">The axis returns<br />to a place.</h2>
        <p>Q° is not a view from nowhere. It is a local now: one window, one horizon, one observer, one declared cut through nested motion.</p>
        <p class="return-field__line">The source can be revisited. The earlier world-state cannot.</p>
      </div>
    </section>

    <section id="source-ledger" class="source-ledger" aria-labelledby="ledger-title">
      <div class="container source-ledger__grid">
        <header>
          <p class="corner-kicker">Source boundary</p>
          <h2 id="ledger-title">A reading lens.<br />No new identity.</h2>
        </header>
        <div>
          <p class="source-ledger__lead">This page composes existing documentary sources. It does not complete the historical series, activate research, or turn a visual relation into a scientific equivalence.</p>
          <dl>
            <div><dt>Reused module</dt><dd><code>MOD:ORIENTATION_DEMONSTRATORS</code></dd></div>
            <div><dt>Reused instrument</dt><dd><code>ART:FIVE_H:ONE_Q_CUT</code></dd></div>
            <div><dt>Reused SCC identity</dt><dd><code>A0OE:PASCAL_PENTAGON_D5_TEST</code></dd></div>
            <div><dt>Polar overlay</dt><dd>Two-state display marker · no added vertex, edge or relation</dd></div>
            <div><dt>Documented sequence</dt><dd>13 intended · 9 executable sources present · 4 source HTMLs absent</dd></div>
            <div><dt>Return</dt><dd>Genealogical provenance · not restoration of a former state</dd></div>
            <div><dt>Authority effect</dt><dd>None · editorial Experience projection only</dd></div>
          </dl>
          <nav aria-label="Generation Corner returns">
            <a class="button" href="/laboratory/roedelheim-observatory/">Return to the Observatory</a>
            <a class="text-link" href="/scc-003-r1/generation-study/">Open the Red Balloon notebook</a>
          </nav>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<script>
  const chapters = [...document.querySelectorAll<HTMLElement>("[data-chapter]")];
  const steps = [...document.querySelectorAll<HTMLElement>("[data-axis-step]")];
  const marker = document.querySelector<HTMLElement>(".q-axis__line i");

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver((entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (!visible) return;
      const number = (visible.target as HTMLElement).dataset.chapter;
      const index = chapters.findIndex((chapter) => chapter.dataset.chapter === number);
      steps.forEach((step) => step.toggleAttribute("data-active", step.dataset.axisStep === number));
      if (marker && index >= 0) marker.style.setProperty("--axis-progress", `${index / (chapters.length - 1)}`);
    }, { rootMargin: "-28% 0px -42%", threshold: [0.2, 0.45, 0.7] });
    chapters.forEach((chapter) => observer.observe(chapter));
  }

  const polarWeb = document.querySelector<HTMLElement>("[data-polar-state]");
  const polarButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-polar-state-button]")];
  const polarToggle = document.querySelector<HTMLButtonElement>("[data-polar-toggle]");
  const polarReadout = document.querySelector<HTMLElement>("[data-polar-readout]");

  const setPolarState = (state: "in" | "out") => {
    if (!polarWeb) return;
    polarWeb.dataset.polarState = state;
    polarButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.polarStateButton === state)));
    if (polarReadout) polarReadout.textContent = state === "in" ? "IN · level 2 / 6" : "OUT · level 6 / 6";
  };

  polarButtons.forEach((button) => button.addEventListener("click", () => setPolarState(button.dataset.polarStateButton === "out" ? "out" : "in")));
  polarToggle?.addEventListener("click", () => setPolarState(polarWeb?.dataset.polarState === "out" ? "in" : "out"));
</script>

<style>
  .corner{--corner-night:#07131e;--corner-panel:#0b1c29;--corner-line:#294252;--corner-text:#e9f1f4;--corner-soft:#9fb0ba;background:var(--corner-night);color:var(--corner-text)}
  .corner :global(.corner-kicker){margin:0 0 1rem;color:var(--gold);font-size:.72rem;font-weight:800;letter-spacing:.2em;text-transform:uppercase}
  .corner-hero{position:relative;min-height:calc(100svh - 5rem);overflow:hidden;border-bottom:1px solid var(--corner-line);background:radial-gradient(circle at 70% 45%,rgba(67,202,231,.09),transparent 34rem),var(--corner-night)}
