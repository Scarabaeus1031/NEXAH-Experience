---
import BaseLayout from "@/layouts/BaseLayout.astro";

const observerLensSource = import.meta.env.DEV
  ? "http://127.0.0.1:8765/A0_NEWTON_GOETHE_OBSERVER_LENS.html"
  : "/A0_NEWTON_GOETHE_OBSERVER_LENS.html";
---

<BaseLayout
  title="The Observer Lens — Rödelheim Observatory"
  description="A source-bound journey through light, shadow, sound, echo and Human Return."
  hideFooter={true}
  hideSessionQuestion={true}
>
  <section class="observer-lens-frame" aria-label="The Observer Lens">
    <iframe
      src={`${observerLensSource}?projection=nexah-observer-lens`}
      data-observer-lens-source={observerLensSource}
      title="Newton, Leibniz and Goethe Observer Lens"
      loading="eager"
      allow="autoplay"
    ></iframe>
  </section>
</BaseLayout>

<script>
  const frame = document.querySelector<HTMLIFrameElement>("[data-observer-lens-source]");

  const syncObserverLensLanguage = (language?: string) => {
    if (!frame?.dataset.observerLensSource) return;
    const source = new URL(frame.dataset.observerLensSource, window.location.origin);
    source.searchParams.set("projection", "nexah-observer-lens");
    source.searchParams.set("lang", language === "en" ? "en" : "de");
    const nextSource = source.toString();
    if (frame.src !== nextSource) frame.src = nextSource;
  };

  syncObserverLensLanguage(document.documentElement.dataset.siteLanguage);
  window.addEventListener("nexah:language-changed", (event) => {
    syncObserverLensLanguage((event as CustomEvent<string>).detail);
  });
</script>

<style>
  :global(body){display:flex;min-height:100svh;flex-direction:column;overflow:hidden;background:#05070c}
  :global(body > .site-header){flex:none}
  :global(body > main){display:flex;min-height:0;flex:1;flex-direction:column}
  .observer-lens-frame{display:flex;min-height:0;flex:1;flex-direction:column}
  .observer-lens-frame iframe{display:block;width:100%;min-height:0;flex:1;border:0;background:#05070c}
</style>
