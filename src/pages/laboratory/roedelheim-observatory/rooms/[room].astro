---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { roedelheimRooms, type RoedelheimRoom } from "@/data/roedelheim-rooms";

export function getStaticPaths() {
  return roedelheimRooms.map((room) => ({ params: { room: room.slug }, props: { room } }));
}

const { room } = Astro.props as { room: RoedelheimRoom };
const instrumentSource = import.meta.env.DEV
  ? `http://127.0.0.1:8765/${room.sourcePath}`
  : `/observatory-rooms/${room.slug}/index.html`;
---

<BaseLayout
  title={`${room.title} — Rödelheim Observatory`}
  description={`${room.question} A source-bound Rödelheim Observatory instrument.`}
  hideFooter={true}
  hideSessionQuestion={true}
>
  <header class="room-header">
    <a href="/laboratory/roedelheim-observatory/#observatory-rooms"><span class="lang-copy lang-copy--de">← Observatorium</span><span class="lang-copy lang-copy--en">← Observatory</span></a>
    <div>
      <p><span class="room-number">{room.number}</span> · <span class="lang-copy lang-copy--de">Quellgebundener Raum</span><span class="lang-copy lang-copy--en">Source-bound room</span> · {room.id}</p>
      <h1>{room.title}</h1>
    </div>
    <details>
      <summary><span class="lang-copy lang-copy--de">Lesegrenze</span><span class="lang-copy lang-copy--en">Reading boundary</span></summary>
      <p class="lang-copy lang-copy--de"><strong>{room.questionDe}</strong><br />{room.claimBoundaryDe}<br /><em>Das eingebettete Original-Instrument ist derzeit englischsprachig.</em></p>
      <p class="lang-copy lang-copy--en"><strong>{room.question}</strong><br />{room.claimBoundary}</p>
    </details>
  </header>
  <section class="room-frame" aria-label={room.title}>
    <iframe src={instrumentSource} title={room.title} loading="eager"></iframe>
  </section>
</BaseLayout>

<style>
  :global(body){display:flex;min-height:100svh;flex-direction:column;overflow:hidden;background:#071923}
  :global(body > .site-header){flex:none}
  :global(body > main){display:flex;min-height:0;flex:1;flex-direction:column}
  .room-header{display:grid;grid-template-columns:auto minmax(0,1fr) minmax(13rem,22rem);gap:clamp(1rem,3vw,3rem);align-items:center;padding:1rem clamp(1rem,3vw,2.5rem);border-bottom:1px solid #244452;background:#071923;color:#e8f2f4}
  .room-header>a{color:#68d7e7;font:700 .72rem/1.2 var(--font-mono);letter-spacing:.08em;text-decoration:none;text-transform:uppercase}
  .room-header p{margin:0;color:#9cb7c1;font:500 .66rem/1.4 var(--font-mono);letter-spacing:.08em;text-transform:uppercase}
  .room-header p .room-number{color:#e9b541}
  .room-header h1{margin:.25rem 0 0;font-family:var(--font-display);font-size:clamp(1.35rem,2.4vw,2.25rem);font-weight:500;line-height:1}
  .room-header details{justify-self:stretch;color:#c8d9df;font-size:.8rem}
  .room-header summary{cursor:pointer;color:#f15bb5;font:700 .68rem/1.2 var(--font-mono);letter-spacing:.08em;text-transform:uppercase}
  .room-header details p{margin:.65rem 0 0;color:#c8d9df;font-family:inherit;font-size:.76rem;letter-spacing:0;text-transform:none}
  .room-frame{display:flex;min-height:0;flex:1;flex-direction:column}
  .room-frame iframe{display:block;width:100%;min-height:0;flex:1;border:0;background:#fff}
  @media(max-width:760px){.room-header{grid-template-columns:1fr auto}.room-header>a{grid-column:1}.room-header>div{grid-column:1/-1;grid-row:2}.room-header details{grid-column:2;grid-row:1}.room-frame iframe{min-height:72svh}}
</style>
