---
import BaseLayout from "@/layouts/BaseLayout.astro";

const orientationDimensions = [
  ["Position", "Where are we?"],
  ["Perspective", "Which representation are we using?"],
  ["Relation", "What does it reveal and omit?"],
  ["Possible direction", "Which paths remain available?"],
] as const;

const layers = [
  {
    number: "01",
    eyebrow: "Human & culture",
    title: "Experience before system.",
    description: "Books and visual journeys about attention, clarity, belonging and the lived need for orientation.",
    href: "/explore/journeys/",
    action: "Enter through Human experience",
  },
  {
    number: "02",
    eyebrow: "Design & instruments",
    title: "Make the frame inspectable.",
    description: "Languages, records and interfaces that expose selection, relation, change and unresolved difference.",
    href: "/library/visitors-guide/",
    action: "Learn how the work is organized",
  },
  {
    number: "03",
    eyebrow: "Research & laboratory",
    title: "Test only what can be bounded.",
    description: "Methods, experiments and claim reviews kept separate from metaphor, intuition and Human meaning.",
    href: "/laboratory/",
    action: "Inspect the Laboratory",
  },
] as const;
---

<BaseLayout
  title="About NEXAH — A Human Project for Orientation"
  description="NEXAH is a Human, cultural and design project for remaining oriented amid abundant information, powerful systems and changing representations."
>
  <header class="container about-position-hero">
    <div class="about-position-hero__copy">
      <p class="eyebrow">About NEXAH</p>
      <h1>Designing Orientation for Human life.</h1>
      <p class="lead">We live with more information, more representations and more machine-made answers than any person can fully oversee. NEXAH asks how people can remain aware, capable and responsible within that abundance.</p>
      <p>It makes selection, perspective, change and uncertainty more visible—so that useful systems can serve Human life without silently becoming its authority.</p>
    </div>
    <aside class="about-position-thesis" aria-label="The position of NEXAH">
      <div class="about-position-thesis__landscape" aria-hidden="true"></div>
      <span class="about-position-thesis__mark" aria-hidden="true">⌖</span>
      <p class="eyebrow">The mission</p>
      <strong>Capability should serve life.</strong>
      <span>Meaning, judgment and responsibility remain with the Human.</span>
    </aside>
  </header>

  <div class="about-manifesto">
    <section class="about-manifesto-section section--line" aria-labelledby="why-orientation-title">
      <div class="container">
        <header class="about-section-heading">
          <p class="eyebrow">Why Orientation</p>
          <h2 id="why-orientation-title">The world does not lack information.<br />It lacks orientation.</h2>
        </header>
        <div class="about-representation-field">
          <div>
            <p class="lead">Artificial intelligence, media and institutions are powerful and useful. But every answer they provide is made through a selection: sources, variables, frames, categories and sequences.</p>
            <p>When those choices disappear from view, a partial representation can begin to feel like the whole. Orientation restores the missing relation between what we see, how it was formed and what remains outside.</p>
          </div>
          <ul aria-label="Examples of bounded representations">
            <li><span>01</span><strong>An answer</strong><small>selects sources</small></li>
            <li><span>02</span><strong>A model</strong><small>selects variables</small></li>
            <li><span>03</span><strong>An image</strong><small>selects a frame</small></li>
            <li><span>04</span><strong>A story</strong><small>selects a sequence</small></li>
          </ul>
        </div>
      </div>
    </section>

    <section class="container section orientation-definition" aria-labelledby="orientation-definition-title">
      <header class="about-section-heading about-section-heading--split">
        <div><p class="eyebrow">What Orientation Means</p><h2 id="orientation-definition-title">A situated capacity—not a final result.</h2></div>
        <p>Orientation arises between an observer, a representation, a purpose, a context and the alternatives held in view.</p>
      </header>
      <blockquote>Orientation is the situated capacity to understand where we are, which representation we are using, what it reveals and omits, how it relates to other representations, and which paths remain possible.</blockquote>
      <div class="orientation-dimensions orientation-dimensions--concise">
        {orientationDimensions.map(([name, question], index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{name}</h3>
            <strong>{question}</strong>
          </article>
        ))}
      </div>
      <p class="orientation-definition__boundary">Orientation supports understanding. It does not decide, recommend or authorize action.</p>
    </section>

    <section id="orientation-practice" class="about-practice-section section--line" aria-labelledby="orientation-practice-title">
      <div class="container">
        <header class="about-section-heading about-section-heading--split">
          <div>
            <p class="eyebrow">How NEXAH works</p>
            <h2 id="orientation-practice-title">A Human practice before it becomes a system.</h2>
          </div>
          <p>NEXAH begins with ordinary acts of attention and makes them explicit enough to inspect together.</p>
        </header>
        <p class="about-practice-line" aria-label="The NEXAH orientation practice">
          <span>Observe</span><i>→</i><span>Select</span><i>→</i><span>Cut</span><i>→</i><span>Record</span><i>→</i><span>Compare</span><i>→</i><span>Return</span>
        </p>
        <p class="about-practice-boundary"><strong>Return</strong> means bringing a result back to context, memory, revision and Human judgment. It closes a test cycle; it does not close the world.</p>
      </div>
    </section>

    <section class="about-layers section--line" aria-labelledby="about-layers-title">
      <div class="container">
        <header class="about-section-heading about-section-heading--split">
          <div>
            <p class="eyebrow">One mission, three layers</p>
            <h2 id="about-layers-title">Not every work makes the same kind of claim.</h2>
          </div>
          <p>Human experience, design instruments and scientific tests belong together, but they must remain distinguishable. That separation is part of the integrity of NEXAH.</p>
        </header>
        <ol class="about-layer-grid">
          {layers.map((layer) => (
            <li>
              <a href={layer.href}>
                <span>{layer.number} · {layer.eyebrow}</span>
                <h3>{layer.title}</h3>
                <p>{layer.description}</p>
                <strong>{layer.action} <b aria-hidden="true">→</b></strong>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="about-invitation section--line" aria-labelledby="open-invitation-title">
      <div class="container about-invitation__inner">
        <div>
          <p class="eyebrow">A work larger than one person</p>
          <h2 id="open-invitation-title">Independent, Human and open to challenge.</h2>
          <p>NEXAH was initiated by Thomas K. R. Hofmann as a Human, cultural and design project for Orientation. The Science Lab tests selected questions where evidence and boundaries can be made explicit.</p>
          <p>Readers, designers, artists, educators, engineers and researchers are invited to experience the work, challenge it and help develop better ways of remaining oriented.</p>
        </div>
        <aside>
          <blockquote>Capability should serve life.<br />Orientation keeps the Human in the relation.</blockquote>
          <nav aria-label="Continue from About">
            <a class="button" href="/explore/journeys/">Begin with experience <span aria-hidden="true">→</span></a>
            <a class="button button--secondary" href="/library/">Explore the Library</a>
            <a class="button button--secondary" href="/laboratory/">Inspect the Research</a>
            <a class="text-link" href="/contact/">Contact · Join the conversation</a>
          </nav>
        </aside>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-practice-line {
    display: grid;
    grid-template-columns: repeat(11, auto);
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin: var(--space-6) 0 var(--space-4);
    padding: var(--space-5);
    border-block: 1px solid var(--rule);
  }

  .about-practice-line span {
    font-family: var(--serif);
    font-size: var(--step-1);
  }

  .about-practice-line i {
    color: var(--gold);
    font-style: normal;
  }

  .about-practice-boundary {
    max-width: 52rem;
    margin-left: auto;
    padding-bottom: var(--space-6);
  }

  .about-layer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: var(--space-6) 0 0;
    padding: 0 0 var(--space-7);
    list-style: none;
  }

  .about-layer-grid li {
    display: flex;
  }

  .about-layer-grid a {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 21rem;
    padding: var(--space-5);
    border: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
  }

  .about-layer-grid li + li a {
    border-left: 0;
  }

  .about-layer-grid span,
  .about-layer-grid strong {
    color: var(--gold);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .about-layer-grid h3 {
    margin: var(--space-5) 0 var(--space-3);
    font-family: var(--serif);
    font-size: var(--step-2);
    font-weight: 400;
    line-height: 1.1;
  }

  .about-layer-grid strong {
    margin-top: auto;
    padding-top: var(--space-5);
  }

  .about-layer-grid b {
    display: inline-block;
    transition: transform 160ms ease;
  }

  .about-layer-grid a:hover b,
  .about-layer-grid a:focus-visible b {
    transform: translateX(0.25rem);
  }

  @media (max-width: 800px) {
    .about-practice-line {
      grid-template-columns: 1fr;
      justify-items: start;
    }

    .about-practice-line i {
      transform: rotate(90deg);
    }

    .about-layer-grid { grid-template-columns: 1fr; }
    .about-layer-grid a { min-height: 15rem; }
    .about-layer-grid li + li a { border-top: 0; border-left: 1px solid var(--rule); }
  }
</style>
