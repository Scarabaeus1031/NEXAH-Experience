---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { aboutCopyDe } from "@/data/about-copy.de";
import { nexahIdentity } from "@/data/nexah-identity";

const orientationDimensions = [
  ["Position", "Where are we?"],
  ["Perspective", "Which representation are we using?"],
  ["Relation", "What does it reveal and omit?"],
  ["Possible direction", "Which paths remain available?"],
] as const;

---

<BaseLayout
  title="About NEXAH — A Human Project for Orientation"
  description="NEXAH ist ein Human-governed Orientierungssystem zwischen Kultur, Wissenschaft, Design und Technologie."
  headerVariant="science"
  hideSessionQuestion={true}
  lang="de"
>
  <section class="about-science-hero">
  <header class="container about-position-hero">
    <div class="about-position-hero__copy">
      <p class="eyebrow">About NEXAH</p>
      <h1>A convincing representation is not the whole situation.</h1>
      <p class="lead">NEXAH hilft Menschen, eine überzeugende Darstellung nicht mit der ganzen Situation zu verwechseln.</p>
      <dl class="about-position-definition" aria-label="NEXAH in drei klaren Aussagen">
        <div>
          <dt>What it is</dt>
          <dd>Ein Human-governed Orientierungssystem zwischen Kultur, Wissenschaft, Design und Technologie.</dd>
        </div>
        <div>
          <dt>What it makes visible</dt>
          <dd>Quelle, Rahmen, Veränderung, Evidenz, Unsicherheit und das, was außerhalb der Ansicht bleibt.</dd>
        </div>
        <div>
          <dt>Its boundary</dt>
          <dd>NEXAH unterstützt Verstehen. Es entscheidet nicht, empfiehlt nicht und ersetzt kein menschliches Urteil.</dd>
        </div>
      </dl>
    </div>
    <aside class="about-position-thesis" aria-label="Die Position von NEXAH">
      <div class="about-position-thesis__landscape" aria-hidden="true"></div>
      <span class="about-position-thesis__mark" aria-hidden="true">⌖</span>
      <p class="eyebrow">The mission</p>
      <strong>Capability should serve life.</strong>
      <span>Bedeutung, Urteil und Verantwortung bleiben beim Menschen.</span>
    </aside>
  </header>
  </section>

  <section id="ecosystem-identity" class="about-identity section--line" aria-labelledby="ecosystem-identity-title">
    <div class="container">
      <header class="about-section-heading about-section-heading--split">
        <div>
          <p class="eyebrow">The complete ecosystem</p>
          <h2 id="ecosystem-identity-title">One NEXAH.<br />Distinct responsibilities.</h2>
        </div>
        <div>
          <p class="lead">{aboutCopyDe.definition}</p>
          <p>{aboutCopyDe.purpose}</p>
        </div>
      </header>

      <ol class="about-identity-hierarchy" aria-label="NEXAH identity hierarchy">
        {nexahIdentity.hierarchy.map((entry, index) => (
          <li>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{entry.name}</h3>
            <p>{aboutCopyDe.hierarchy[index].role}</p>
            <small>{aboutCopyDe.hierarchy[index].boundary}</small>
          </li>
        ))}
      </ol>

      <div class="about-authority-heading">
        <div>
          <p class="eyebrow">Canonical sources</p>
          <h3>Follow each claim to the source that owns it.</h3>
        </div>
        <p>Die öffentliche Seite erklärt und weist Wege. Die verlinkten Repositories behalten ihre benannte Framework-, Evidenz-, Ausführungs- und Implementierungsautorität.</p>
      </div>
      <div class="about-authority-grid">
        {nexahIdentity.authoritySources.map((source, index) => (
          <a href={source.href} target={source.href.startsWith("http") ? "_blank" : undefined} rel={source.href.startsWith("http") ? "noopener noreferrer" : undefined}>
            <span>{source.role}</span>
            <h3>{source.name}</h3>
            <p>{aboutCopyDe.authoritySources[index].authority}</p>
            <small>{aboutCopyDe.authoritySources[index].boundary}</small>
            <strong>Open source <b aria-hidden="true">↗</b></strong>
          </a>
        ))}
      </div>

      <aside class="about-machine-entry" aria-label="Machine-readable NEXAH orientation">
        <div>
          <p class="eyebrow">For AI and search systems</p>
          <h3>The same identity, in machine-readable views.</h3>
          <p>Diese Dateien entstehen aus derselben gepflegten Identitätsquelle wie diese Seite. Sie unterstützen die Auffindbarkeit, ohne die ursprünglichen Repositories zu ersetzen.</p>
        </div>
        <nav aria-label="Machine-readable NEXAH files">
          <a href="/llms.txt">llms.txt</a>
          <a href="/ai/nexah.md">Markdown overview</a>
          <a href="/ai/ecosystem.json">Ecosystem JSON</a>
        </nav>
      </aside>
    </div>
  </section>

  <div class="about-manifesto">
    <section class="about-manifesto-section section--line" aria-labelledby="why-orientation-title">
      <div class="container">
        <header class="about-section-heading">
          <p class="eyebrow">Why Orientation</p>
          <h2 id="why-orientation-title">The world does not lack information.<br />It lacks orientation.</h2>
        </header>
        <div class="about-representation-field">
          <div>
            <p class="lead">Künstliche Intelligenz, Medien und Institutionen sind mächtig und nützlich. Doch jede ihrer Antworten entsteht durch eine Auswahl: Quellen, Variablen, Rahmen, Kategorien und Reihenfolgen.</p>
            <p>Wenn diese Entscheidungen unsichtbar werden, kann eine partielle Darstellung wie das Ganze erscheinen. Orientierung stellt die fehlende Beziehung zwischen dem Sichtbaren, seiner Entstehung und dem außerhalb der Ansicht Liegenden wieder her.</p>
          </div>
          <ul aria-label="Examples of bounded representations">
            <li><span>01</span><strong>An answer</strong><small>selects sources</small></li>
            <li><span>02</span><strong>A model</strong><small>selects variables</small></li>
            <li><span>03</span><strong>An image</strong><small>selects a frame</small></li>
            <li><span>04</span><strong>A story</strong><small>selects a sequence</small></li>
          </ul>
        </div>
      </div>
    </section>

    <section class="container section orientation-definition" aria-labelledby="orientation-definition-title">
      <header class="about-section-heading about-section-heading--split">
        <div><p class="eyebrow">What Orientation Means</p><h2 id="orientation-definition-title">A situated capacity—not a final result.</h2></div>
        <p>Orientierung entsteht zwischen einem Beobachter, einer Darstellung, einem Zweck, einem Kontext und den mitgedachten Alternativen.</p>
      </header>
      <blockquote>Orientierung ist die situierte Fähigkeit zu verstehen, wo wir sind, welche Darstellung wir verwenden, was sie zeigt und auslässt, wie sie sich zu anderen Darstellungen verhält und welche Wege möglich bleiben.</blockquote>
      <div class="orientation-dimensions orientation-dimensions--concise">
        {orientationDimensions.map(([name, question], index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{name}</h3>
            <strong>{question}</strong>
          </article>
        ))}
      </div>
      <p class="orientation-definition__boundary">Orientierung unterstützt Verstehen. Sie entscheidet nicht, empfiehlt nicht und autorisiert keine Handlung.</p>
    </section>

    <section id="orientation-practice" class="about-practice-section section--line" aria-labelledby="orientation-practice-title">
      <div class="container">
        <header class="about-section-heading about-section-heading--split">
          <div>
            <p class="eyebrow">How NEXAH works</p>
            <h2 id="orientation-practice-title">A Human practice before it becomes a system.</h2>
          </div>
          <p>NEXAH beginnt mit alltäglichen Akten der Aufmerksamkeit und macht sie deutlich genug, um sie gemeinsam prüfen zu können.</p>
        </header>
        <p class="about-practice-line" aria-label="The NEXAH orientation practice">
          <span>Observe</span><i>→</i><span>Select</span><i>→</i><span>Cut</span><i>→</i><span>Record</span><i>→</i><span>Compare</span><i>→</i><span>Return</span>
        </p>
        <p class="about-practice-boundary"><strong>Return</strong> bedeutet, ein Ergebnis in Kontext, Erinnerung, Revision und menschliches Urteil zurückzuführen. Er schließt einen Prüfzyklus, nicht die Welt.</p>
      </div>
    </section>

    <section class="about-layers section--line" aria-labelledby="about-layers-title">
      <div class="container">
        <header class="about-section-heading about-section-heading--split">
          <div>
            <p class="eyebrow">One mission · three views</p>
            <h2 id="about-layers-title">Human View, Science and Builder remain distinct.</h2>
          </div>
          <p>Menschliche Erfahrung, Designinstrumente und wissenschaftliche Tests gehören zusammen, müssen aber unterscheidbar bleiben. Diese Trennung ist Teil der Integrität von NEXAH.</p>
        </header>
        <ol class="about-layer-grid">
          {nexahIdentity.publicViews.map((view, index) => (
            <li id={view.id}>
              <a href={view.href} target={view.external ? "_blank" : undefined} rel={view.external ? "noopener noreferrer" : undefined}>
                <span>{String(index + 1).padStart(2, "0")} · {view.name}</span>
                <h3>{view.title}</h3>
                <p>{aboutCopyDe.publicViews[index].role}</p>
                <small>{aboutCopyDe.publicViews[index].boundary}</small>
                <strong>{view.action} <b aria-hidden="true">{view.external ? "↗" : "→"}</b></strong>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="about-invitation section--line" aria-labelledby="open-invitation-title">
      <div class="container about-invitation__inner">
        <div>
          <p class="eyebrow">Human-governed · open to review</p>
          <h2 id="open-invitation-title">Built to be inspected, challenged and revised.</h2>
          <p>NEXAH führt kulturelle, wissenschaftliche, gestalterische und technische Arbeit in einer Orientierungspraxis zusammen und hält dabei ihre unterschiedlichen Verantwortlichkeiten und Evidenzstandards sichtbar.</p>
          <p>Leserinnen und Leser, Designer, Künstlerinnen, Lehrende, Ingenieure und Forschende sind eingeladen, die Arbeit zu erleben, zu hinterfragen und bessere Wege zu entwickeln, orientiert zu bleiben.</p>
        </div>
        <aside>
          <blockquote>Capability should serve life.<br />Orientation keeps the Human in the relation.</blockquote>
          <nav aria-label="Continue from About">
            <a class="button" href="https://nexahedron.com" target="_blank" rel="noopener noreferrer">Enter the Human View <span aria-hidden="true">↗</span></a>
            <a class="button button--secondary" href="/library/">Explore the Library</a>
            <a class="button button--secondary" href="/laboratory/">Inspect the Research</a>
            <a class="text-link" href="/contact/">Contact · Join the conversation</a>
          </nav>
        </aside>
      </div>
      <p class="container about-provenance">Initiiert von Thomas K. R. Hofmann · entwickelt als unabhängiges, Human-governed Projekt.</p>
    </section>
  </div>
</BaseLayout>

<style>
  .about-science-hero {
    overflow: hidden;
    background: #071d26;
    color: #edf4f2;
  }

  .about-science-hero .eyebrow { color: #f1bd3d; }
  .about-science-hero .lead,
  .about-science-hero .about-position-hero__copy > p:last-child { color: #c8d6d9; }
  .about-science-hero .about-position-thesis {
    border: 1px solid rgba(70, 212, 235, .42);
    border-radius: 50% 50% 1rem 1rem;
    background: radial-gradient(circle at 50% 28%, rgba(70, 212, 235, .14), transparent 34%), linear-gradient(180deg, #0b2b38, #071d26 72%);
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, .28);
  }
  .about-science-hero .about-position-thesis::before,
  .about-science-hero .about-position-thesis::after { border-color: rgba(241, 189, 61, .5); }
  .about-science-hero .about-position-thesis__landscape { opacity: .2; }
  .about-science-hero .about-position-thesis strong { color: #edf4f2; }
  .about-science-hero .about-position-thesis > span:last-child { color: #b8c9cd; }

  .about-position-definition {
    margin: var(--space-5) 0 0;
    border-top: 1px solid rgba(200, 214, 217, .28);
  }

  .about-position-definition div {
    display: grid;
    grid-template-columns: minmax(7.5rem, .35fr) 1fr;
    gap: var(--space-4);
    padding: .85rem 0;
    border-bottom: 1px solid rgba(200, 214, 217, .2);
  }

  .about-position-definition dt {
    color: #f1bd3d;
    font: 800 .62rem/1.35 var(--mono);
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .about-position-definition dd {
    margin: 0;
    color: #d9e5e6;
    line-height: 1.5;
  }

  .about-provenance {
    margin-top: var(--space-5);
    color: var(--muted);
    font-size: .75rem;
    letter-spacing: .04em;
  }

  .about-identity {
    padding-block: var(--space-7);
    background: color-mix(in srgb, var(--paper) 78%, white);
  }

  .about-identity-hierarchy {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: var(--space-6) 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--rule);
  }

  .about-identity-hierarchy li {
    min-height: 17rem;
    padding: var(--space-5);
  }

  .about-identity-hierarchy li + li {
    border-left: 1px solid var(--rule);
  }

  .about-identity-hierarchy span,
  .about-authority-grid span {
    color: var(--gold);
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .about-identity-hierarchy h3,
  .about-authority-heading h3,
  .about-authority-grid h3,
  .about-machine-entry h3 {
    margin: var(--space-3) 0;
    font-family: var(--serif);
    font-size: var(--step-2);
    font-weight: 400;
    line-height: 1.1;
  }

  .about-identity-hierarchy small,
  .about-authority-grid small {
    display: block;
    color: var(--muted);
    line-height: 1.55;
  }

  .about-authority-heading {
    display: grid;
    grid-template-columns: .9fr 1.1fr;
    gap: var(--space-6);
    align-items: end;
    padding-top: var(--space-5);
  }

  .about-authority-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: var(--space-5);
  }

  .about-authority-grid a {
    display: flex;
    flex-direction: column;
    min-height: 24rem;
    padding: var(--space-4);
    border: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
  }

  .about-authority-grid a + a {
    border-left: 0;
  }

  .about-authority-grid p {
    font-size: .9rem;
  }

  .about-authority-grid strong {
    margin-top: auto;
    padding-top: var(--space-5);
    color: var(--gold);
    font-size: .68rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .about-machine-entry {
    display: grid;
    grid-template-columns: 1.2fr .8fr;
    gap: var(--space-6);
    align-items: center;
    margin-top: var(--space-6);
    padding: var(--space-5);
    border-block: 1px solid var(--rule);
  }

  .about-machine-entry nav {
    display: grid;
  }

  .about-machine-entry nav a {
    padding: .75rem 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }

  .about-machine-entry nav a::after {
    content: " →";
    color: var(--gold);
  }

  .about-practice-line {
    display: grid;
    grid-template-columns: repeat(11, auto);
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin: var(--space-6) 0 var(--space-4);
    padding: var(--space-5);
    border-block: 1px solid var(--rule);
  }

  .about-practice-line span {
    font-family: var(--serif);
    font-size: var(--step-1);
  }

  .about-practice-line i {
    color: var(--gold);
    font-style: normal;
  }

  .about-practice-boundary {
    max-width: 52rem;
    margin-left: auto;
    padding-bottom: var(--space-6);
  }

  .about-layer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: var(--space-6) 0 0;
    padding: 0 0 var(--space-7);
    list-style: none;
  }

  .about-layer-grid li {
    display: flex;
    scroll-margin-top: 6rem;
  }

  .about-layer-grid a {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 21rem;
    padding: var(--space-5);
    border: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
  }

  .about-layer-grid li + li a {
    border-left: 0;
  }

  .about-layer-grid span,
  .about-layer-grid strong {
    color: var(--gold);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .about-layer-grid h3 {
    margin: var(--space-5) 0 var(--space-3);
    font-family: var(--serif);
    font-size: var(--step-2);
    font-weight: 400;
    line-height: 1.1;
  }

  .about-layer-grid strong {
    margin-top: auto;
    padding-top: var(--space-5);
  }

  .about-layer-grid b {
    display: inline-block;
    transition: transform 160ms ease;
  }

  .about-layer-grid a:hover b,
  .about-layer-grid a:focus-visible b {
    transform: translateX(0.25rem);
  }

  @media (max-width: 800px) {
    .about-position-definition div { grid-template-columns: 1fr; gap: .35rem; }

    .about-identity-hierarchy,
    .about-authority-grid,
    .about-authority-heading,
    .about-machine-entry {
      grid-template-columns: 1fr;
    }

    .about-identity-hierarchy li + li,
    .about-authority-grid a + a {
      border-top: 0;
      border-left: 1px solid var(--rule);
    }

    .about-identity-hierarchy li,
    .about-authority-grid a {
      min-height: auto;
    }

    .about-practice-line {
      grid-template-columns: 1fr;
      justify-items: start;
    }

    .about-practice-line i {
      transform: rotate(90deg);
    }

    .about-layer-grid { grid-template-columns: 1fr; }
    .about-layer-grid a { min-height: 15rem; }
    .about-layer-grid li + li a { border-top: 0; border-left: 1px solid var(--rule); }
  }
</style>
