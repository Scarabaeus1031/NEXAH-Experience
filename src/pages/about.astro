---
import OrientationScienceEntry from "@/components/navigation/OrientationScienceEntry.astro";
import { repositoryDocumentUrl } from "@/data/laboratory";
import { researchArchitectureView } from "@/data/research-architecture";
import BaseLayout from "@/layouts/BaseLayout.astro";

const orientationDimensions = [
  ["Position", "Where are we?", "Locate the observer, situation and present conditions."],
  ["Perspective", "Which representation are we using?", "Name the map, model, image, story or disciplinary frame in view."],
  ["Relation", "What does it reveal, omit and connect?", "Keep evidence, limits, differences and relationships visible."],
  ["Possible direction", "Which paths remain available?", "See alternatives without turning them into a recommendation."],
] as const;

const movement = [
  ["Observe", "Attend to what is present before naming it."],
  ["Represent", "Make a bounded view explicit."],
  ["Map", "Place relations, limits and possible transitions in view."],
  ["Compare", "Hold representations together without conflating them."],
  ["Reflect", "Examine tension, uncertainty and what remains outside the frame."],
  ["Orient", "Understand the situated field and the paths that remain possible."],
] as const;

const principles = [
  "Reality is richer than any single representation.",
  "Every map reveals and omits.",
  "Difference must remain visible.",
  "Evidence and interpretation remain distinct.",
  "Orientation supports judgment; it does not replace it.",
  "Where evidence ends, the claim must end.",
] as const;

const invitedPractices = [
  "Researchers",
  "Designers",
  "Engineers",
  "Artists",
  "Librarians and educators",
  "System thinkers",
  "Curious readers",
] as const;
---

<BaseLayout
  title="About NEXAH — Developing Orientation as a Discipline"
  description="NEXAH is developing Orientation as a discipline for navigating complex systems while preserving evidence, difference and Human judgment."
>
  <header class="container about-position-hero">
    <div class="about-position-hero__copy">
      <p class="eyebrow">About NEXAH</p>
      <h1>Developing Orientation as a discipline.</h1>
      <p class="lead">Orientation is the central subject of NEXAH. The laboratory investigates how people and systems can recognize position, perspective and possible next paths within complex situations.</p>
      <p>NEXAH develops ways to hold different representations in relation without collapsing them into a single explanation. It creates conditions for understanding before action—not an automatic answer or decision.</p>
    </div>
    <aside class="about-position-thesis" aria-label="The position of NEXAH">
      <div class="about-position-thesis__landscape" aria-hidden="true"></div>
      <span class="about-position-thesis__mark" aria-hidden="true">⌖</span>
      <p class="eyebrow">The position</p>
      <strong>Orientation is the discipline in development.</strong>
      <span>NEXAH is the laboratory developing it.</span>
    </aside>
  </header>

  <div class="about-manifesto">
    <section class="about-manifesto-section section--line" aria-labelledby="why-orientation-title">
      <div class="container">
        <header class="about-section-heading">
          <p class="eyebrow">Why Orientation</p>
          <h2 id="why-orientation-title">The world does not lack information.<br />It lacks orientation between representations.</h2>
        </header>
        <div class="about-representation-field">
          <div>
            <p class="lead">Disciplines, models, maps, images and stories reveal different structures. Each is made from a position, for a purpose, with particular evidence—and each leaves something outside its frame.</p>
            <p>No single representation contains the whole. Moving responsibly between different descriptions of a situation is therefore a research and design problem in its own right.</p>
          </div>
          <ul aria-label="Examples of bounded representations">
            <li><span>01</span><strong>A model</strong><small>selects variables</small></li>
            <li><span>02</span><strong>A map</strong><small>selects relations</small></li>
            <li><span>03</span><strong>An image</strong><small>selects a frame</small></li>
            <li><span>04</span><strong>A story</strong><small>selects a sequence</small></li>
          </ul>
        </div>
      </div>
    </section>

    <section class="container section orientation-definition" aria-labelledby="orientation-definition-title">
      <header class="about-section-heading about-section-heading--split">
        <div><p class="eyebrow">What Orientation Means</p><h2 id="orientation-definition-title">A situated capacity—not a final result.</h2></div>
        <p>Orientation remains relational: it emerges between an observer, a bounded representation, a purpose, a context and the alternatives held in view.</p>
      </header>
      <blockquote>Orientation is the situated capacity to understand where we are, which representation we are using, what it reveals and omits, how it relates to other representations, and which paths remain possible.</blockquote>
      <div class="orientation-dimensions">
        {orientationDimensions.map(([name, question, note], index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{name}</h3>
            <strong>{question}</strong>
            <p>{note}</p>
          </article>
        ))}
      </div>
      <p class="orientation-definition__boundary">Orientation is neither an automatic decision nor a guarantee of what should happen next.</p>
    </section>

    <section class="container section about-science-section" aria-label="Orientation Science">
      <OrientationScienceEntry context="about" />
    </section>

    <section class="about-movement-section section--line" aria-labelledby="movement-title">
      <div class="container">
        <header class="about-section-heading about-section-heading--split">
          <div><p class="eyebrow">The NEXAH Movement</p><h2 id="movement-title">Observe. Represent. Map. Compare. Reflect. Orient.</h2></div>
          <div class="about-section-heading__aside">
            <p>This movement creates conditions for Human orientation. It does not perform understanding, replace judgment or authorize action.</p>
            <a class="editorial-path-link" href="/laboratory/process/">
              <span>Follow the research process</span>
              <b aria-hidden="true">→</b>
            </a>
          </div>
        </header>
        <ol class="orientation-movement">
          {movement.map(([name, note], index) => (
            <li><span>{String(index + 1).padStart(2, "0")}</span><strong>{name}</strong><p>{note}</p></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="container section" aria-labelledby="manifesto-principles-title">
      <div class="manifesto-principles">
        <header>
          <p class="eyebrow">Manifesto Principles</p>
          <h2 id="manifesto-principles-title">One field. Many representations. Open transitions.</h2>
          <a
            class="editorial-path-link manifesto-principles__link"
            href={repositoryDocumentUrl("MANIFESTO.md")}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>Read the complete Manifesto</span>
            <b aria-hidden="true">↗</b>
          </a>
        </header>
        <ol>
          {principles.map((principle, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><strong>{principle}</strong></li>)}
        </ol>
      </div>
    </section>

    <section
      class="about-practice-section about-architecture-teaser section--line"
      aria-labelledby="practice-title"
      data-source-section={researchArchitectureView.publicEntrances.about.sourceSection}
    >
      <div class="container">
        <header class="about-section-heading about-section-heading--split">
          <div>
            <p class="eyebrow">{researchArchitectureView.publicEntrances.about.eyebrow}</p>
            <h2 id="practice-title">{researchArchitectureView.publicEntrances.about.headline}</h2>
          </div>
          <p>{researchArchitectureView.publicEntrances.about.text}</p>
        </header>
        <ul aria-label="Six coordinated responsibilities">
          {researchArchitectureView.orientationSpace.responsibilities.map((responsibility) => (
            <li>{responsibility.name}</li>
          ))}
        </ul>
        <a class="editorial-path-link" href={researchArchitectureView.publicEntrances.about.href}>
          <span>{researchArchitectureView.publicEntrances.about.linkLabel}</span>
          <b aria-hidden="true">→</b>
        </a>
      </div>
    </section>

    <section class="container section about-authority" aria-labelledby="human-authority-title">
      <header class="about-section-heading">
        <p class="eyebrow">Human Authority and Boundaries</p>
        <h2 id="human-authority-title">Navigability is not truth.</h2>
      </header>
      <div class="about-authority__statement" aria-label="The NEXAH authority boundary">
        <span>representation</span><b aria-hidden="true">→</b><span>orientation</span><b aria-hidden="true">≠</b><span>recommendation</span><b aria-hidden="true">≠</b><span>authorization</span><b aria-hidden="true">≠</b><span>execution</span>
      </div>
      <div class="about-authority__copy">
        <p>NEXAH can organize evidence, connect representations, trace relationships and explain why a path was presented. It does not produce universal truth, infer authority from fluency or decide which uncertainty may be ignored.</p>
        <p>Meaning, judgment and responsibility remain with the Human. Where evidence ends, the claim must end.</p>
      </div>
    </section>

    <section class="about-invitation section--line" aria-labelledby="open-invitation-title">
      <div class="container about-invitation__inner">
        <div>
          <p class="eyebrow">Founder and Open Invitation</p>
          <h2 id="open-invitation-title">An independent laboratory, open to other ways of seeing.</h2>
          <p>NEXAH was initiated by Thomas K. R. Hofmann as an independent research and design laboratory.</p>
          <p>Researchers, designers, engineers, artists, librarians and educators, system thinkers and curious readers are invited to inspect the work, challenge its categories, identify counterexamples and propose better maps.</p>
          <div class="invited-practices" aria-label="People invited to take part">
            {invitedPractices.map((practice) => <span>{practice}</span>)}
          </div>
        </div>
        <aside>
          <blockquote>We are not looking for agreement.<br />We are looking for better orientation.</blockquote>
          <nav aria-label="Continue from About">
            <a class="button" href="/atlas/">Start Here <span aria-hidden="true">→</span></a>
            <a class="button button--secondary" href="/library/">Explore the Library</a>
            <a class="button button--secondary" href="/laboratory/">Inspect the Research</a>
            <a class="text-link" href="/contact/">Contact · Join the conversation</a>
          </nav>
        </aside>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .editorial-path-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: min(100%, 25rem);
    margin-top: 1.25rem;
    padding: 0.85rem 0 0.65rem;
    border-top: 1px solid var(--gold);
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    line-height: 1.4;
    text-decoration: none;
    text-transform: uppercase;
  }

  .editorial-path-link b {
    flex: 0 0 auto;
    color: var(--gold);
    font-size: 1.05rem;
    line-height: 1;
    transition: transform 160ms ease;
  }

  .editorial-path-link:hover,
  .editorial-path-link:focus-visible {
    border-top-color: var(--ink);
    color: var(--gold);
  }

  .editorial-path-link:hover b,
  .editorial-path-link:focus-visible b {
    transform: translateX(0.25rem);
  }

  .editorial-path-link:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 0.35rem;
  }

  .about-architecture-teaser ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin: 0 0 var(--space-5);
    padding: 0;
    list-style: none;
  }

  .about-architecture-teaser li {
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 250, 238, 0.52);
    color: var(--ink-soft);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
</style>
