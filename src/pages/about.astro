---
import { scientificBaselines } from "@/data/laboratory";
import PublicationCover from "@/components/library/PublicationCover.astro";
import { publicationByRouteSlug } from "@/data/catalog";
import BaseLayout from "@/layouts/BaseLayout.astro";

const baseline = scientificBaselines[0];

const orientationDimensions = [
  ["Position", "Where are we?"],
  ["Perspective", "Which representation are we using?"],
  ["Relation", "What does it reveal and omit?"],
  ["Possible direction", "Which paths remain available?"],
] as const;

const researchRecord = [
  ["orientation-atlas-vol-i", "Volume I", "Research landscape"],
  ["orientation-design-vol-ii", "Volume II", "Research practice"],
  ["orientation-theory-vol-iii", "Volume III", "Conceptual foundations"],
  ["the-architecture-of-orientation-vol-iv", "Volume IV", "Connected architecture"],
].map(([slug, volume, role]) => ({
  volume,
  role,
  publication: publicationByRouteSlug.get(slug),
})).filter((entry) => entry.publication !== undefined);
---

<BaseLayout
  title="About NEXAH — Developing Orientation as a Discipline"
  description="NEXAH is an independent research and design laboratory developing Orientation as a discipline for navigating complex systems."
>
  <header class="container about-position-hero">
    <div class="about-position-hero__copy">
      <p class="eyebrow">About NEXAH</p>
      <h1>Developing Orientation as a discipline.</h1>
      <p class="lead">NEXAH is an independent research and design laboratory studying how people and systems find position, perspective and possible direction within complex situations.</p>
      <p>It develops ways to compare bounded representations without collapsing their differences, overstating their evidence or replacing Human judgment.</p>
    </div>
    <aside class="about-position-thesis" aria-label="The position of NEXAH">
      <div class="about-position-thesis__landscape" aria-hidden="true"></div>
      <span class="about-position-thesis__mark" aria-hidden="true">⌖</span>
      <p class="eyebrow">The position</p>
      <strong>Orientation is the discipline in development.</strong>
      <span>NEXAH is the laboratory developing it.</span>
    </aside>
  </header>

  <div class="about-manifesto">
    <section class="about-manifesto-section section--line" aria-labelledby="why-orientation-title">
      <div class="container">
        <header class="about-section-heading">
          <p class="eyebrow">Why Orientation</p>
          <h2 id="why-orientation-title">The world does not lack information.<br />It lacks orientation between representations.</h2>
        </header>
        <div class="about-representation-field">
          <div>
            <p class="lead">Models, maps, images and stories reveal different structures. Each has a purpose, an evidential basis and a boundary.</p>
            <p>No single representation contains the whole. Moving responsibly between descriptions is therefore a scientific and design problem in its own right.</p>
          </div>
          <ul aria-label="Examples of bounded representations">
            <li><span>01</span><strong>A model</strong><small>selects variables</small></li>
            <li><span>02</span><strong>A map</strong><small>selects relations</small></li>
            <li><span>03</span><strong>An image</strong><small>selects a frame</small></li>
            <li><span>04</span><strong>A story</strong><small>selects a sequence</small></li>
          </ul>
        </div>
      </div>
    </section>

    <section class="container section orientation-definition" aria-labelledby="orientation-definition-title">
      <header class="about-section-heading about-section-heading--split">
        <div><p class="eyebrow">What Orientation Means</p><h2 id="orientation-definition-title">A situated capacity—not a final result.</h2></div>
        <p>Orientation arises between an observer, a representation, a purpose, a context and the alternatives held in view.</p>
      </header>
      <blockquote>Orientation is the situated capacity to understand where we are, which representation we are using, what it reveals and omits, how it relates to other representations, and which paths remain possible.</blockquote>
      <div class="orientation-dimensions orientation-dimensions--concise">
        {orientationDimensions.map(([name, question], index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{name}</h3>
            <strong>{question}</strong>
          </article>
        ))}
      </div>
      <p class="orientation-definition__boundary">Orientation supports understanding. It does not decide, recommend or authorize action.</p>
    </section>

    <section class="about-practice-section section--line" aria-labelledby="scientific-foundation-title">
      <div class="container">
        <header class="about-section-heading about-section-heading--split">
          <div>
            <p class="eyebrow">Scientific foundation</p>
            <h2 id="scientific-foundation-title">A versioned foundation—not a final theory.</h2>
          </div>
          <p>The Scientific Constitution defines the enduring methodological direction. The first NEXAH Science Lab baseline preserves that foundation together with the research environment and its explicit claim boundaries.</p>
        </header>
        <nav class="about-foundation-links" aria-label="Scientific foundation documents">
          <a class="editorial-path-link" href="/laboratory/repository/#scientific-baselines"><span>View the scientific baseline</span><b aria-hidden="true">→</b></a>
          <a class="editorial-path-link" href={baseline.links.constitution} target="_blank" rel="noopener noreferrer"><span>Read the Scientific Constitution</span><b aria-hidden="true">↗</b></a>
          <a class="editorial-path-link" href="/explore/foundations/"><span>Explore Orientation Science</span><b aria-hidden="true">→</b></a>
        </nav>
      </div>
    </section>

    <section class="about-research-record section--line" aria-labelledby="research-record-title">
      <div class="container">
        <div class="orientation-series orientation-series--record">
          <header class="orientation-series__heading">
            <div>
              <p class="eyebrow">Research Record</p>
              <h2 id="research-record-title">A developing field, documented across connected volumes.</h2>
            </div>
            <p>Four connected volumes record the programme’s continuity.</p>
          </header>
          <ol class="orientation-series__grid" aria-label="The four-volume Orientation Architecture series">
            {researchRecord.map((entry) => {
              const publication = entry.publication!;
              const cover = publication.localBook?.cover ?? publication.cover.src;
              const coverAlt = publication.localBook?.coverAlt ?? publication.cover.alt ?? `Cover of ${publication.title}`;
              const width = publication.localBook ? 1024 : publication.cover.width;
              const height = publication.localBook ? 1536 : publication.cover.height;
              return (
                <li>
                  <a class="orientation-series__cover" href={`/library/${publication.routeSlug}/`} aria-label={`Open ${publication.title}`}>
                    <PublicationCover
                      src={cover}
                      alt={coverAlt}
                      width={width}
                      height={height}
                      title={publication.title}
                      kind={publication.form.replaceAll("_", " ")}
                      loading="lazy"
                      referrerpolicy="no-referrer"
                    />
                  </a>
                  <div class="orientation-series__copy">
                    <span>{entry.volume}</span>
                    <h3>{publication.title.replace(/\s+—\s+VOLUME\s+[IVX]+$/i, "")}</h3>
                    <strong>{entry.role}</strong>
                  </div>
                </li>
              );
            })}
          </ol>
          <a class="text-link orientation-series__entry" href="/library/">View the complete publication record</a>
        </div>
      </div>
    </section>

    <section class="about-invitation section--line" aria-labelledby="open-invitation-title">
      <div class="container about-invitation__inner">
        <div>
          <p class="eyebrow">Institution and open invitation</p>
          <h2 id="open-invitation-title">Independent, inspectable and open to challenge.</h2>
          <p>NEXAH was initiated by Thomas K. R. Hofmann as an independent research and design laboratory.</p>
          <p>Researchers, designers, engineers, artists, educators and curious readers are invited to inspect the work, identify counterexamples and propose better maps.</p>
        </div>
        <aside>
          <blockquote>We are not looking for agreement.<br />We are looking for better orientation.</blockquote>
          <nav aria-label="Continue from About">
            <a class="button" href="/atlas/">Start Here <span aria-hidden="true">→</span></a>
            <a class="button button--secondary" href="/library/">Explore the Library</a>
            <a class="button button--secondary" href="/laboratory/">Inspect the Research</a>
            <a class="text-link" href="/contact/">Contact · Join the conversation</a>
          </nav>
        </aside>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .editorial-path-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: min(100%, 25rem);
    padding: 0.85rem 0 0.65rem;
    border-top: 1px solid var(--gold);
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    line-height: 1.4;
    text-decoration: none;
    text-transform: uppercase;
  }

  .editorial-path-link b {
    flex: 0 0 auto;
    color: var(--gold);
    font-size: 1.05rem;
    line-height: 1;
    transition: transform 160ms ease;
  }

  .editorial-path-link:hover,
  .editorial-path-link:focus-visible {
    border-top-color: var(--ink);
    color: var(--gold);
  }

  .editorial-path-link:hover b,
  .editorial-path-link:focus-visible b {
    transform: translateX(0.25rem);
  }

  .editorial-path-link:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 0.35rem;
  }

  .about-foundation-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .about-foundation-links .editorial-path-link {
    width: 100%;
  }

  .orientation-series--record {
    margin-top: 0;
  }

  .orientation-series--record .orientation-series__heading h2 {
    max-width: 22ch;
    margin: 0;
    font-family: var(--serif);
    font-size: var(--step-2);
    font-weight: 400;
    line-height: 1.15;
  }

  .orientation-series--record .orientation-series__copy h3 {
    margin: 0;
    font-family: var(--serif);
    font-size: var(--step-0);
    font-weight: 400;
    line-height: 1.15;
  }

  @media (max-width: 760px) {
    .about-foundation-links { grid-template-columns: 1fr; }
    .orientation-series--record .orientation-series__heading h2 { font-size: var(--step-1); }
    .orientation-series--record .orientation-series__copy h3 { font-size: .95rem; }
  }
</style>
