---
import ConceptBadge from "@/components/atlas/ConceptBadge.astro";
import OperatorBadge from "@/components/atlas/OperatorBadge.astro";
import ThemeBadge from "@/components/atlas/ThemeBadge.astro";
import VisualCollectionCard from "@/components/atlas/VisualCollectionCard.astro";
import { atlasCounts, concepts, operators, themes, visualCollections } from "@/data/atlas";
import { books } from "@/data/library";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="The Living Atlas — NEXAH" description="A curated editorial map of relationships between NEXAH publications, concepts, operators, themes and visual collections.">
  <header class="container living-atlas-hero">
    <div>
      <p class="eyebrow">The Living Atlas</p>
      <h1>What would you like to connect?</h1>
      <p class="lead">A Library stores works. An Atlas reveals the curated paths between them.</p>
    </div>
    <div class="atlas-compass" aria-hidden="true">✦</div>
    <dl class="atlas-counts">
      <div><dt>Publications</dt><dd>{atlasCounts.books}</dd></div>
      <div><dt>Concepts</dt><dd>{atlasCounts.concepts}</dd></div>
      <div><dt>Operators</dt><dd>{atlasCounts.operators}</dd></div>
      <div><dt>Themes</dt><dd>{atlasCounts.themes}</dd></div>
      <div><dt>Relations</dt><dd>{atlasCounts.relations}</dd></div>
    </dl>
  </header>

  <div class="container atlas-landscape">
    <section class="atlas-route" aria-labelledby="route-title">
      <header><p class="eyebrow">One explicit path</p><h2 id="route-title">Walk from one book into another</h2></header>
      <ol>
        <li><small>Book</small><a href="/library/wonder-operator/">The Wonder Operator</a></li>
        <li><small>Concept</small><a href="/atlas/concepts/transition/">Transition</a></li>
        <li><small>Operator</small><a href="/atlas/operators/transform/">Transform</a></li>
        <li><small>Theme</small><a href="/atlas/themes/transformation/">Transformation</a></li>
        <li><small>Book</small><a href="/library/language-book/">The Language Book</a></li>
      </ol>
      <p>Each step above is a registered editorial relationship. No similarity engine constructed this route.</p>
    </section>

    <section class="atlas-registry atlas-registry--invitation" id="visuals" aria-labelledby="visuals-title">
      <div class="section-heading"><div><p class="eyebrow">Enter through a collection</p><h2 id="visuals-title">Visual collections</h2><p>Existing visual material assigned through explicit registry relations.</p></div><span class="collection-count">{visualCollections.length} collections</span></div>
      <div class="visual-collection-grid visual-collection-grid--atlas">
        {visualCollections.map((visual) => <VisualCollectionCard visual={visual} />)}
      </div>
    </section>

    <section class="atlas-registry" id="concepts" aria-labelledby="concepts-title">
      <div class="section-heading"><div><h2 id="concepts-title">Concepts</h2><p>Ideas that recur across the publication landscape.</p></div><span class="collection-count">{concepts.length} entries</span></div>
      <div class="atlas-entry-grid">
        {concepts.map((concept) => (
          <article class="atlas-entry-card atlas-entry-card--concept">
            <ConceptBadge concept={concept} />
            <p>{concept.summary}</p>
            <a class="text-link" href={`/atlas/concepts/${concept.id}/`}>Enter concept</a>
          </article>
        ))}
      </div>
    </section>

    <section class="atlas-registry" id="operators" aria-labelledby="operators-title">
      <div class="section-heading"><div><h2 id="operators-title">Editorial operators</h2><p>Named gestures for moving through the Atlas. They are not executable ORION operators.</p></div><span class="collection-count">{operators.length} entries</span></div>
      <div class="atlas-entry-grid atlas-entry-grid--operators">
        {operators.map((operator) => (
          <article class="atlas-entry-card atlas-entry-card--operator">
            <OperatorBadge operator={operator} />
            <p>{operator.summary}</p>
            <small>{operator.gesture}</small>
          </article>
        ))}
      </div>
    </section>

    <section class="atlas-registry" id="themes" aria-labelledby="themes-title">
      <div class="section-heading"><div><h2 id="themes-title">Themes</h2><p>Recurring editorial fields that connect works without classifying evidence.</p></div><span class="collection-count">{themes.length} entries</span></div>
      <div class="theme-cloud">
        {themes.map((theme) => <ThemeBadge theme={theme} />)}
      </div>
    </section>

    <section class="atlas-registry" id="publications" aria-labelledby="atlas-books-title">
      <div class="section-heading"><div><h2 id="atlas-books-title">Publications in the landscape</h2><p>The Library owns the works. The Atlas owns only their declared relationships.</p></div></div>
      <ol class="atlas-publication-list">
        {books.map((book, index) => (
          <li><span>{String(index + 1).padStart(2, "0")}</span><a href={`/library/${book.slug}/`}>{book.title}</a><small>{book.subtitle}</small></li>
        ))}
      </ol>
    </section>

    <aside class="atlas-authority">
      <p class="eyebrow">What the Atlas does not do</p>
      <h2>It reveals declared relationships. It does not discover hidden ones.</h2>
      <p>No AI, semantic matching, graph database, ORION execution or evidence inference participates in this map.</p>
    </aside>
  </div>
</BaseLayout>
