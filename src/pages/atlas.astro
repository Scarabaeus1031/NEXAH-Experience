---
import ConceptBadge from "@/components/atlas/ConceptBadge.astro";
import OperatorBadge from "@/components/atlas/OperatorBadge.astro";
import ThemeBadge from "@/components/atlas/ThemeBadge.astro";
import VisualCollectionCard from "@/components/atlas/VisualCollectionCard.astro";
import { atlasRef, concepts, getConnectedEntities, operators, themes, visualCollections } from "@/data/atlas";
import { bookBySlug, books } from "@/data/library";
import { readerByBookSlug } from "@/data/reader";
import BaseLayout from "@/layouts/BaseLayout.astro";

const startHereOptions = [
  {
    intention: "I am new to NEXAH",
    slug: "visitors-guide",
    invitation: "Begin with why NEXAH exists and what orientation means. Read the guide or enter through its visual prologue.",
  },
  {
    intention: "I want to recover curiosity",
    slug: "wonder-operator",
    invitation: "Enter through attention, wonder, play, reflection and belonging.",
  },
  {
    intention: "I want a language for change",
    slug: "language-book",
    invitation: "Learn to notice relations, transitions, context and composition.",
  },
] as const;

const requireBook = (slug: string) => {
  const book = bookBySlug.get(slug);
  if (!book) throw new Error(`Living Atlas work does not resolve: ${slug}`);
  return book;
};

const startingWorks = startHereOptions.map((option) => {
  const book = requireBook(option.slug);
  return { ...option, book, readerAvailable: readerByBookSlug.has(option.slug) };
});

const wonderBook = requireBook("wonder-operator");
const languageBook = requireBook("language-book");

const visualEntrances = visualCollections.map((visual) => {
  const connectedBooks = getConnectedEntities(atlasRef("visual", visual.id), "book");
  if (connectedBooks.length !== 1 || !connectedBooks[0].href) {
    throw new Error(`Visual collection must resolve to one registered work: ${visual.id}`);
  }
  return { visual, href: connectedBooks[0].href };
});
---

<BaseLayout title="Start Here — The Living Atlas — NEXAH" description="Choose a concrete first NEXAH work, then explore its curated relationships to concepts, operators, themes and visual collections.">
  <header class="container living-atlas-hero">
    <div>
      <p class="eyebrow">Start Here · The Living Atlas</p>
      <h1>What would you like to understand?</h1>
      <p class="lead">Choose an intention and begin with one existing work. From there, the Living Atlas reveals only curated relationships.</p>
    </div>
    <div class="atlas-compass" aria-hidden="true">✦</div>
  </header>

  <div class="container atlas-landscape">
    <section class="start-here-choices" aria-labelledby="start-here-choices-title">
      <header>
        <p class="eyebrow">Choose by intention</p>
        <h2 id="start-here-choices-title">Three concrete places to begin.</h2>
        <p>No recommendation engine is involved. These are fixed editorial entrances into existing works.</p>
      </header>
      <div class="start-here-grid">
        {startingWorks.map(({ intention, invitation, book, readerAvailable }, index) => (
          <article class="start-here-card">
            <div class="start-here-card__cover-wrap">
              <a class="start-here-card__cover" href={`/library/${book.slug}/read/`} aria-label={`Begin reading ${book.title}`}>
                <img src={book.cover} alt={book.coverAlt} width="1024" height="1536" loading="eager" />
              </a>
              {book.slug === "visitors-guide" && (
                <a class="start-here-card__film-badge" href="/visitor-guide/#film-title">
                  Film · 2:48 <span aria-hidden="true">▶</span>
                </a>
              )}
            </div>
            <div class="start-here-card__copy">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <p class="eyebrow">{intention}</p>
              <h3><a href={`/library/${book.slug}/`}>{book.title}</a></h3>
              <p>{invitation}</p>
              <div class="start-here-card__actions">
                {readerAvailable && <a class="button" href={`/library/${book.slug}/read/`}>Begin reading <span aria-hidden="true">→</span></a>}
                {book.slug === "visitors-guide" && (
                  <a class="button button--film" href="/visitor-guide/#film-title">
                    Watch the film · 2:48 <span aria-hidden="true">▶</span>
                  </a>
                )}
                <a class="text-link" href={`/library/${book.slug}/`}>View work</a>
              </div>
              {readerAvailable && <span class="reader-signal">Reading Space available</span>}
            </div>
          </article>
        ))}
      </div>
      <aside class="start-here-visual">
        <div><p class="eyebrow">Prefer a visual entrance?</p><h3>The Atlas of Atlases</h3></div>
        <p>A conceptual map of relationships between knowledge systems, representations and reference spaces.</p>
        <a class="button button--secondary" href="/atlas-of-atlases/">Explore visually <span aria-hidden="true">→</span></a>
      </aside>
    </section>

    <section class="atlas-route" aria-labelledby="route-title">
      <header><p class="eyebrow">One curated path</p><h2 id="route-title">Walk from one work into another</h2></header>
      <ol>
        <li class="atlas-route__book"><small>Book</small><a href="/library/wonder-operator/"><img src={wonderBook.cover} alt="" width="1024" height="1536" loading="lazy" /><span>The Wonder Operator</span></a></li>
        <li><small>Concept</small><a href="/atlas/concepts/transition/">Transition</a></li>
        <li><small>Operator</small><a href="/atlas/operators/transform/">Transform</a></li>
        <li><small>Theme</small><a href="/atlas/themes/transformation/">Transformation</a></li>
        <li class="atlas-route__book"><small>Book</small><a href="/library/language-book/"><img src={languageBook.cover} alt="" width="1024" height="1536" loading="lazy" /><span>The Language Book</span></a></li>
      </ol>
      <p>Each step above is a registered editorial relationship. No similarity engine constructed this route.</p>
    </section>

    <section class="atlas-registry atlas-registry--guided atlas-registry--concepts" id="concepts" aria-labelledby="concepts-title">
      <header class="atlas-registry__intro">
        <span class="atlas-registry__number" aria-hidden="true">01</span>
        <div><p class="eyebrow">Explore ideas</p><h2 id="concepts-title">Concepts</h2><p>Choose an idea to see where it appears across the publication landscape.</p></div>
        <span class="collection-count">{concepts.length} paths</span>
      </header>
      <div class="atlas-entry-grid">
        {concepts.map((concept) => (
          <article class="atlas-entry-card atlas-entry-card--concept">
            <ConceptBadge concept={concept} />
            <p>{concept.summary}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="atlas-registry atlas-registry--guided atlas-registry--operators" id="operators" aria-labelledby="operators-title">
      <header class="atlas-registry__intro">
        <span class="atlas-registry__number" aria-hidden="true">02</span>
        <div><p class="eyebrow">Choose a gesture</p><h2 id="operators-title">Editorial operators</h2><p>Ways of looking and moving through the Atlas: observe, connect, navigate, transform or reflect.</p></div>
        <span class="collection-count">{operators.length} gestures</span>
      </header>
      <div class="atlas-entry-grid atlas-entry-grid--operators">
        {operators.map((operator) => (
          <article class="atlas-entry-card atlas-entry-card--operator">
            <OperatorBadge operator={operator} />
            <p>{operator.summary}</p>
            <small>{operator.gesture}</small>
          </article>
        ))}
      </div>
    </section>

    <section class="atlas-registry atlas-registry--invitation" id="visuals" aria-labelledby="visuals-title">
      <div class="section-heading"><div><p class="eyebrow">Enter through a collection</p><h2 id="visuals-title">Visual collections</h2><p>Existing visual material assigned through explicit registry relations.</p></div><span class="collection-count">{visualCollections.length} collections</span></div>
      <div class="visual-collection-grid visual-collection-grid--atlas">
        {visualEntrances.map(({ visual, href }) => <VisualCollectionCard visual={visual} href={href} />)}
      </div>
    </section>

    <section class="atlas-registry" id="themes" aria-labelledby="themes-title">
      <div class="section-heading"><div><h2 id="themes-title">Themes</h2><p>Recurring editorial fields that connect works without classifying evidence.</p></div><span class="collection-count">{themes.length} entries</span></div>
      <div class="theme-cloud">
        {themes.map((theme) => <ThemeBadge theme={theme} />)}
      </div>
    </section>

    <section class="atlas-registry" id="publications" aria-labelledby="atlas-books-title">
      <div class="section-heading"><div><h2 id="atlas-books-title">Publications in the landscape</h2><p>The Library owns the works. The Atlas owns only their declared relationships.</p></div></div>
      <ol class="atlas-publication-list">
        {books.map((book, index) => (
          <li><span>{String(index + 1).padStart(2, "0")}</span><a href={`/library/${book.slug}/`}>{book.title}</a><small>{book.subtitle}</small></li>
        ))}
      </ol>
    </section>

    <aside class="atlas-authority">
      <p class="eyebrow">What the Atlas does not do</p>
      <h2>It reveals declared relationships. It does not discover hidden ones.</h2>
      <p>No AI, semantic matching, graph database, ORION execution or evidence inference participates in this map.</p>
    </aside>
  </div>
</BaseLayout>
