---
import ConceptBadge from "@/components/atlas/ConceptBadge.astro";
import OperatorBadge from "@/components/atlas/OperatorBadge.astro";
import ThemeBadge from "@/components/atlas/ThemeBadge.astro";
import { concepts, operators, themes } from "@/data/atlas";
import { bookBySlug } from "@/data/library";
import BaseLayout from "@/layouts/BaseLayout.astro";

const elevators = [
  {
    number: "01",
    label: "Understand the method",
    title: "How does a view become a record?",
    description: "Begin with source, position, selection, boundary and Human Return—the public language behind A0.",
    href: "/about/",
    action: "Enter the method",
  },
  {
    number: "02",
    label: "Enter one case",
    title: "See several maps hold one world.",
    description: "Use the Atlas of Atlases as one visual case. Comparison reveals difference without turning relation into identity.",
    href: "/atlas-of-atlases/",
    action: "Open the visual case",
  },
  {
    number: "03",
    label: "Follow the evidence",
    title: "Inspect sources, methods and limits.",
    description: "Move into the Laboratory when you want provenance, declared boundaries and the status of the underlying work.",
    href: "/laboratory/",
    action: "Enter the Laboratory",
  },
] as const;

const requireBook = (slug: string) => {
  const book = bookBySlug.get(slug);
  if (!book) throw new Error(`Living Atlas work does not resolve: ${slug}`);
  return book;
};

const wonderBook = requireBook("wonder-operator");
const languageBook = requireBook("language-book");
---

<BaseLayout title="Start Here — The Living Labyrinth — NEXAH" description="Choose one clear entrance into the NEXAH method, a visual case or its evidence, then explore the curated Living Atlas beneath it.">
  <header class="container living-atlas-hero">
    <div>
      <p class="eyebrow">Start Here · The Living Labyrinth</p>
      <h1>What would you like to understand?</h1>
      <p class="lead">Many routes exist, but only one needs to open at a time. Choose an elevator; the deeper Atlas remains available when you want it.</p>
    </div>
    <div class="atlas-compass" aria-hidden="true">✦</div>
  </header>

  <div class="container atlas-landscape">
    <nav class="atlas-depth" aria-label="Current reading depth">
      <strong><span>00</span> Overview</strong>
      <span><i>01</i> Choose a door</span>
      <span><i>02</i> Enter depth</span>
      <span><i>↩</i> Return</span>
    </nav>

    <section class="atlas-elevators" aria-labelledby="atlas-elevators-title">
      <header>
        <p class="eyebrow">Three A0 elevators</p>
        <h2 id="atlas-elevators-title">Choose your depth.</h2>
        <p>No recommendation engine is involved. These are fixed public entrances; each opens a different layer and keeps a visible route back.</p>
      </header>
      <div class="atlas-elevator-grid">
        {elevators.map((elevator) => (
          <a class="atlas-elevator" href={elevator.href}>
            <span class="atlas-elevator__number">{elevator.number}</span>
            <p class="eyebrow">{elevator.label}</p>
            <h3>{elevator.title}</h3>
            <p>{elevator.description}</p>
            <strong>{elevator.action} <span aria-hidden="true">→</span></strong>
          </a>
        ))}
      </div>
    </section>

    <section class="atlas-route" aria-labelledby="route-title">
      <header><p class="eyebrow">One curated path</p><h2 id="route-title">Walk from one work into another</h2></header>
      <ol>
        <li class="atlas-route__book"><small>Book</small><a href="/library/wonder-operator/"><img src={wonderBook.cover} alt="" width="1024" height="1536" loading="lazy" /><span>The Wonder Operator</span></a></li>
        <li><small>Concept</small><a href="/atlas/concepts/transition/">Transition</a></li>
        <li><small>Operator</small><a href="/atlas/operators/transform/">Transform</a></li>
        <li><small>Theme</small><a href="/atlas/themes/transformation/">Transformation</a></li>
        <li class="atlas-route__book"><small>Book</small><a href="/library/language-book/"><img src={languageBook.cover} alt="" width="1024" height="1536" loading="lazy" /><span>The Language Book</span></a></li>
      </ol>
      <p>Each step above is a registered editorial relationship. No similarity engine constructed this route.</p>
    </section>

    <details class="atlas-exploration-disclosure">
      <summary>
        <span><small>Continue into the Living Atlas</small><strong>Explore concepts, operators and themes</strong></span>
        <b aria-hidden="true">+</b>
      </summary>
      <div class="atlas-exploration-disclosure__content">
        <section class="atlas-registry atlas-registry--guided atlas-registry--concepts" id="concepts" aria-labelledby="concepts-title">
          <header class="atlas-registry__intro">
            <span class="atlas-registry__number" aria-hidden="true">01</span>
            <div><p class="eyebrow">Explore ideas</p><h2 id="concepts-title">Concepts</h2><p>Choose an idea to see where it appears across the publication landscape.</p></div>
            <span class="collection-count">{concepts.length} paths</span>
          </header>
          <div class="atlas-entry-grid">
            {concepts.map((concept) => (
              <article class="atlas-entry-card atlas-entry-card--concept">
                <ConceptBadge concept={concept} />
                <p>{concept.summary}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="atlas-registry atlas-registry--guided atlas-registry--operators" id="operators" aria-labelledby="operators-title">
          <header class="atlas-registry__intro">
            <span class="atlas-registry__number" aria-hidden="true">02</span>
            <div><p class="eyebrow">Choose a gesture</p><h2 id="operators-title">Editorial operators</h2><p>Ways of looking and moving through the Atlas: observe, connect, navigate, transform or reflect.</p></div>
            <span class="collection-count">{operators.length} gestures</span>
          </header>
          <div class="atlas-entry-grid atlas-entry-grid--operators">
            {operators.map((operator) => (
              <article class="atlas-entry-card atlas-entry-card--operator">
                <OperatorBadge operator={operator} />
                <p>{operator.summary}</p>
                <small>{operator.gesture}</small>
              </article>
            ))}
          </div>
        </section>

        <section class="atlas-registry" id="themes" aria-labelledby="themes-title">
          <div class="section-heading"><div><h2 id="themes-title">Themes</h2><p>Recurring editorial fields that connect works without classifying evidence.</p></div><span class="collection-count">{themes.length} entries</span></div>
          <div class="theme-cloud">
            {themes.map((theme) => <ThemeBadge theme={theme} />)}
          </div>
        </section>
      </div>
    </details>

    <aside class="atlas-authority">
      <p class="eyebrow">What the Atlas does not do</p>
      <h2>It reveals declared relationships. It does not discover hidden ones.</h2>
      <p>No AI, semantic matching, graph database, ORION execution or evidence inference participates in this map.</p>
    </aside>
  </div>
</BaseLayout>

<style>
  .living-atlas-hero { padding-block: var(--space-6) var(--space-4); }
  .atlas-landscape { gap: var(--space-5); }

  .atlas-depth {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-block: 1px solid var(--line);
    color: var(--ink-faint);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .atlas-depth > * { padding: 0.9rem 1rem; border-right: 1px solid var(--line); }
  .atlas-depth > *:last-child { border-right: 0; }
  .atlas-depth strong { color: var(--ink); }
  .atlas-depth span span,
  .atlas-depth i { margin-right: 0.45rem; color: var(--gold); font-style: normal; }

  .atlas-elevators { padding-block: var(--space-4) var(--space-5); }
  .atlas-elevators > header { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: var(--space-6); align-items: end; margin-bottom: var(--space-5); }
  .atlas-elevators > header h2 { margin: 0; font-size: var(--step-3); }
  .atlas-elevators > header > p:last-child { max-width: 38rem; margin: 0; color: var(--ink-soft); }
  .atlas-elevator-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .atlas-elevator {
    position: relative;
    display: grid;
    min-height: 23rem;
    grid-template-rows: auto auto auto 1fr auto;
    padding: var(--space-5);
    border: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }
  .atlas-elevator + .atlas-elevator { border-left: 0; }
  .atlas-elevator:hover,
  .atlas-elevator:focus-visible { z-index: 1; border-color: var(--gold-soft); background: rgba(255,255,255,.5); transform: translateY(-3px); }
  .atlas-elevator__number { justify-self: end; color: var(--gold); font-family: var(--serif); font-size: var(--step-2); }
  .atlas-elevator .eyebrow { margin: var(--space-5) 0 var(--space-3); }
  .atlas-elevator h3 { margin-bottom: var(--space-3); font-size: var(--step-2); }
  .atlas-elevator > p:not(.eyebrow) { color: var(--ink-soft); }
  .atlas-elevator strong { align-self: end; color: var(--gold); font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; }

  .atlas-exploration-disclosure {
    padding-block: var(--space-5);
    border-block: 1px solid var(--line);
  }

  .atlas-exploration-disclosure > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    cursor: pointer;
    list-style: none;
  }

  .atlas-exploration-disclosure > summary::-webkit-details-marker { display: none; }
  .atlas-exploration-disclosure > summary span { display: grid; gap: 0.35rem; }
  .atlas-exploration-disclosure > summary small { color: var(--gold); font-size: 0.64rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
  .atlas-exploration-disclosure > summary strong { font-family: var(--serif); font-size: var(--step-2); font-weight: 400; }
  .atlas-exploration-disclosure > summary b { color: var(--gold); font-family: var(--serif); font-size: var(--step-2); font-weight: 400; transition: transform 160ms ease; }
  .atlas-exploration-disclosure[open] > summary b { transform: rotate(45deg); }
  .atlas-exploration-disclosure__content { display: grid; gap: var(--space-6); padding-top: var(--space-6); }

  @media (max-width: 700px) {
    .atlas-depth { grid-template-columns: 1fr 1fr; }
    .atlas-depth > *:nth-child(2) { border-right: 0; }
    .atlas-depth > *:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
    .atlas-elevators > header,
    .atlas-elevator-grid { grid-template-columns: 1fr; }
    .atlas-elevator { min-height: 18rem; }
    .atlas-elevator + .atlas-elevator { border-top: 0; border-left: 1px solid var(--line); }
  }
</style>
