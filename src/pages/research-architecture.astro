---
import ResearchArchitectureView from "@/components/about/ResearchArchitectureView.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Research Architecture — NEXAH"
  description="The adopted cross-repository NEXAH Research & Ecosystem Architecture: research questions, coordinated responsibilities, Human authority, public interfaces and provenance."
>
  <ResearchArchitectureView headingLevel="h1" />

  <nav class="container research-architecture-continuation" aria-label="Continue from the Research Architecture">
    <a class="text-link" href="/about/">Return to About NEXAH</a>
    <a class="text-link" href="/laboratory/">Continue into the Laboratory</a>
  </nav>
</BaseLayout>

<style>
  .research-architecture-continuation {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-6);
  }

  @media (max-width: 680px) {
    .research-architecture-continuation {
      display: grid;
    }
  }
</style>
