---
import BaseLayout from "@/layouts/BaseLayout.astro";

const a0SourceUrl = import.meta.env.DEV
  ? "http://127.0.0.1:3001/a0-human/start/index.html?projection=nexah-a0#a0-home"
  : "https://nexahedron.com/a0-human/start/index.html?projection=nexah-a0#a0-home";

const internalDesks = import.meta.env.DEV ? [
  {
    code: "01 · SCIENCE",
    title: "Science Desk",
    role: "Prüfen · begrenzen · Evidenz zurückgeben",
    href: "file:///Users/tho2020/Documents/NEXAH%20ECOSYSTEM/30%20SCIENCE%20LAB/NEXAH-Science-Lab/RESEARCH_PROGRAM_B_MATHEMATICAL_FOUNDATIONS/AXIOM0_QMODE_ORIENTATION_TO_MEASUREMENT_FOUNDATION_PACKAGE_2026-10-01/A0_BOOK/A0_RESEARCH_DESK.html#desk-cabinet",
    tone: "science",
  },
  {
    code: "02 · BUILD",
    title: "Builder Desk",
    role: "Bauen · testen · benutzbar machen",
    href: "file:///Users/tho2020/Documents/NEXAH%20ECOSYSTEM/10%20NEXAH%20CORE/NEXAH/BUILDER/B0_BUILDER_DECK/index.html",
    tone: "builder",
  },
  {
    code: "03 · CONTROL",
    title: "Mission Control",
    role: "Lage · Priorität · Auftrag · Return",
    href: "file:///Users/tho2020/Documents/NEXAH%20ECOSYSTEM/00%20EXECUTIVE/NEXAH-Mission-Control/INTERNAL_NAVIGATOR/index.html",
    tone: "control",
  },
] as const : [];
---

<BaseLayout
  title="A0 — The NEXAH Reference Object"
  description="A0 makes visible how representations are formed, what they preserve and where Human judgment returns."
  hideFooter={true}
  hideSessionQuestion={true}
  lang="de"
>
  {internalDesks.length > 0 && (
    <aside class="a0-workbar" aria-label="A0 interne Arbeitsoberfläche">
      <div class="a0-workbar__identity">
        <small>A0 · INTERNAL WORK SURFACE</small>
        <strong>One field. Three desks.</strong>
      </div>
      <nav aria-label="Science Desk, Builder Desk und Mission Control">
        {internalDesks.map((desk) => (
          <a class={`a0-desk a0-desk--${desk.tone}`} href={desk.href} target="_blank" rel="noopener noreferrer">
            <small>{desk.code}</small>
            <strong>{desk.title}</strong>
            <span>{desk.role}</span>
          </a>
        ))}
      </nav>
      <p>Gemeinsame Arbeitsplatte · getrennte Zuständigkeiten · sichtbarer Return</p>
    </aside>
  )}
  <section class="a0-reference" aria-label="A0 · NEXAH Reference Object">
    <iframe
      src={a0SourceUrl}
      title="A0 — Ein Bild zeigt etwas. Und lässt etwas weg."
      loading="eager"
    ></iframe>
  </section>
</BaseLayout>

<style>
  :global(body) {
    display: flex;
    min-height: 100svh;
    flex-direction: column;
    overflow: hidden;
  }

  :global(body > .site-header) {
    flex: none;
  }

  :global(body > main) {
    display: flex;
    flex-direction: column;
    min-height: 0;
    flex: 1;
  }

  .a0-reference {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 0;
    flex: 1;
  }

  .a0-workbar {
    display: grid;
    grid-template-columns: minmax(170px, .52fr) minmax(0, 1.48fr);
    gap: .65rem 1rem;
    padding: .72rem clamp(.75rem, 2vw, 1.5rem) .62rem;
    color: #edf6f7;
    border-bottom: 1px solid rgba(224, 177, 89, .42);
    background:
      linear-gradient(90deg, rgba(31, 198, 207, .075), transparent 34%, transparent 70%, rgba(225, 73, 156, .07)),
      #06131a;
    box-shadow: 0 .7rem 2.2rem rgba(0, 0, 0, .24);
  }

  .a0-workbar__identity {
    display: grid;
    align-content: center;
    gap: .18rem;
  }

  .a0-workbar small,
  .a0-workbar p {
    margin: 0;
    font: 750 .58rem/1.35 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .a0-workbar__identity small { color: #e0b159; }
  .a0-workbar__identity strong { font: 700 1.08rem/1.08 Georgia, "Times New Roman", serif; }
  .a0-workbar nav { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .42rem; }

  .a0-desk {
    display: grid;
    gap: .12rem;
    padding: .55rem .68rem;
    color: #edf6f7;
    border: 1px solid rgba(160, 190, 198, .25);
    background: rgba(8, 24, 31, .88);
    text-decoration: none;
    transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease;
  }

  .a0-desk:hover {
    transform: translateY(-1px);
    border-color: currentColor;
    box-shadow: 0 0 1.2rem color-mix(in srgb, currentColor 22%, transparent);
  }

  .a0-desk small { color: currentColor; opacity: .78; }
  .a0-desk strong { font-size: .78rem; line-height: 1.15; }
  .a0-desk span { color: #8fa7af; font: .57rem/1.3 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .a0-desk--science { color: #55dce3; }
  .a0-desk--builder { color: #9fe28c; }
  .a0-desk--control { color: #f0c66f; }
  .a0-workbar > p { grid-column: 1 / -1; color: #637b84; text-align: right; }

  .a0-reference iframe {
    display: block;
    width: 100%;
    min-height: 0;
    flex: 1;
    border: 0;
    background: #f6f2e9;
  }

  @media (max-width: 760px) {
    .a0-workbar { grid-template-columns: 1fr; }
    .a0-workbar nav { display: flex; overflow-x: auto; }
    .a0-desk { min-width: 12rem; }
    .a0-workbar > p { text-align: left; }
  }
</style>
