---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  lang="de"
  title="Impressum — NEXAH"
  description="Anbieterkennzeichnung und redaktionelle Verantwortlichkeit für die öffentlichen NEXAH-Webangebote."
>
  <article class="legal-page">
    <header class="container legal-hero">
      <p class="eyebrow">Öffentliche Information</p>
      <h1>Impressum</h1>
      <p class="lead">Anbieterkennzeichnung für nexah.de und die öffentliche NEXAHEDRON-Referenzanwendung.</p>
    </header>

    <div class="container legal-content">
      <section aria-labelledby="provider-title">
        <h2 id="provider-title">Angaben gemäß § 5 DDG</h2>
        <address>
          <strong>Haptikdesign GmbH</strong><br />
          Fuchstanzstraße 33–35<br />
          60489 Frankfurt am Main<br />
          Deutschland
        </address>
        <p>Vertreten durch den Geschäftsführer: Thomas Hofmann</p>
        <p>E-Mail: <a href="mailto:contact@nexah.de">contact@nexah.de</a></p>
      </section>

      <section aria-labelledby="register-title">
        <h2 id="register-title">Registereintrag</h2>
        <p>Handelsregister: Amtsgericht Frankfurt am Main<br />Registernummer: HRB 87166</p>
      </section>

      <section aria-labelledby="services-title">
        <h2 id="services-title">Geltungsbereich</h2>
        <p>Dieses Impressum ist die zentral gepflegte Anbieterkennzeichnung für <a href="https://nexah.de">nexah.de</a> und <a href="https://nexahedron.com">nexahedron.com</a>. Dienstspezifische Datenschutzhinweise werden auf dem jeweiligen Angebot bereitgestellt.</p>
      </section>

      <section aria-labelledby="editorial-title">
        <h2 id="editorial-title">Redaktionell verantwortlich</h2>
        <p>Verantwortlich für journalistisch-redaktionelle Inhalte gemäß § 18 Abs. 2 MStV:</p>
        <address>
          Thomas Hofmann<br />
          Haptikdesign GmbH<br />
          Fuchstanzstraße 33–35<br />
          60489 Frankfurt am Main
        </address>
      </section>
    </div>
  </article>
</BaseLayout>
