---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { predictionPaper } from "@/data/prediction-paper";
import { nexahIdentity } from "@/data/nexah-identity";
import { aboutCopyDe } from "@/data/about-copy.de";

const researchRoutes = [
  {
    code: "01 · Position",
    title: { de: "Forschungsstand", en: "Research position" },
    description: {
      de: "Was trägt, welche Grenzen gelten und welches wissenschaftliche Gate als Nächstes offen ist.",
      en: "What currently holds, which boundaries apply and which scientific gate remains open next.",
    },
    href: "/A0_SCIENTIFIC_POSITION_REPORT.html#currentness-20261019",
  },
  {
    code: "02 · Evidence",
    title: { de: "Ergebnisse & Papers", en: "Results & papers" },
    description: {
      de: "Formale, negative, methodische und instrumentelle Resultate mit getrennten Evidenzklassen.",
      en: "Formal, negative, methodological and instrumental results with distinct evidence classes.",
    },
    href: "/A0_SCIENCE.html#contributions",
    exampleHref: "https://github.com/Scarabaeus1031/NEXAH-Science-Lab/blob/0e81f2597884e0bcacbc43e409b005b2d3dc9af3/RESEARCH_PROGRAM_B_MATHEMATICAL_FOUNDATIONS/AXIOM0_QMODE_ORIENTATION_TO_MEASUREMENT_FOUNDATION_PACKAGE_2026-10-01/A0_BOOK/A0_DRAFT_DRIFT_HOUSING_112_NOTE_2026-11-23.md#beispielphase-137-h--august--und-septemberwechsel",
  },
  {
    code: "03 · Field",
    title: { de: "Mathfield", en: "Mathfield" },
    description: {
      de: "Träger, Schnitte, Operatoren, mathematische Fugen und ihre Gültigkeitsgrenzen.",
      en: "Carriers, cuts, operators, mathematical joints and the boundaries of their validity.",
    },
    href: "/A0_MATHEMATICAL_JOINTS.html#register-cut-aperture",
  },
  {
    code: "04 · Review",
    title: { de: "Offene Fragen", en: "Open questions" },
    description: {
      de: "Ungeklärte Fragen, externe Prüfung und der öffentliche Rückkanal bleiben sichtbar.",
      en: "Unresolved questions, external review and the public return channel remain visible.",
    },
    href: "/NEXAH_C_CONNECT.html#scientific-review",
  },
] as const;
---

<BaseLayout
  title="Forschen — NEXAH Science"
  description="Der öffentliche Einstieg in Forschungsstand, Ergebnisse, Mathfield, Methode und offene Review-Fragen von NEXAH Science."
  hideSessionQuestion={true}
  lang="de"
>
  <section class="research-entry">
    <div class="container research-entry__hero">
      <div>
        <p class="eyebrow"><span class="lang-copy lang-copy--de">NEXAH Science · öffentlicher Forschungsraum</span><span class="lang-copy lang-copy--en">NEXAH Science · public research space</span></p>
        <h1><span class="lang-copy lang-copy--de">Was trägt – und was bleibt offen?</span><span class="lang-copy lang-copy--en">What holds — and what remains open?</span></h1>
        <p class="lead"><span class="lang-copy lang-copy--de">NEXAH Science untersucht, was erhalten bleibt, sich verändert oder verloren geht, wenn begrenzte Darstellungen ausgewählt, geschnitten, transformiert oder zurückgeführt werden. Forschungsstand, Ergebnisse und offene Prüfgrenzen bleiben unterscheidbar.</span><span class="lang-copy lang-copy--en">NEXAH Science investigates what remains, changes or is lost when bounded representations are selected, cut, transformed or returned. Research position, results and open validation boundaries remain distinct.</span></p>
      </div>
      <aside>
        <strong>Source-bound</strong>
        <p><span class="lang-copy lang-copy--de">Diese Seite ordnet vorhandene, freigegebene Quellen. Sie erzeugt keine zweite Forschungsautorität und verändert keinen Labstatus.</span><span class="lang-copy lang-copy--en">This page organizes existing, released sources. It creates no second research authority and changes no Lab status.</span></p>
      </aside>
    </div>
  </section>

  <section class="research-foundation section--line" aria-labelledby="research-foundation-title">
    <div class="container">
      <header class="research-foundation__head">
        <p class="eyebrow"><span class="lang-copy lang-copy--de">Was die Forschung trägt</span><span class="lang-copy lang-copy--en">What carries the research</span></p>
        <div>
          <h2 id="research-foundation-title"><span class="lang-copy lang-copy--de">Fünf Säulen. Keine verborgene Gesamtformel.</span><span class="lang-copy lang-copy--en">Five supports. No hidden total formula.</span></h2>
          <p><span class="lang-copy lang-copy--de">Der eigene Beitrag liegt in ihrer kontrollierten Verbindung, nicht in der behaupteten Neuheit jedes Bausteins.</span><span class="lang-copy lang-copy--en">The distinct contribution lies in their controlled integration, not in claiming that every component is new.</span></p>
        </div>
      </header>
      <ol class="research-foundation__grid">
        {nexahIdentity.researchFoundation.map((entry, index) => (
          <li>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3><span class="lang-copy lang-copy--de">{aboutCopyDe.researchFoundation[index].name}</span><span class="lang-copy lang-copy--en">{entry.name}</span></h3>
            <p><span class="lang-copy lang-copy--de">{aboutCopyDe.researchFoundation[index].role}</span><span class="lang-copy lang-copy--en">{entry.role}</span></p>
            <small><span class="lang-copy lang-copy--de">{aboutCopyDe.researchFoundation[index].boundary}</span><span class="lang-copy lang-copy--en">{entry.boundary}</span></small>
          </li>
        ))}
      </ol>
      <p class="research-foundation__position"><strong>R2–R3 · internal:</strong> <span class="lang-copy lang-copy--de">Enge formale Linien sind replaybar. Externe Neuheit, unabhängige Replikation und allgemeine Utility bleiben offen.</span><span class="lang-copy lang-copy--en">Narrow formal lines are replayable. External novelty, independent replication and general utility remain open.</span></p>
    </div>
  </section>

  <section class="research-routes section--line" aria-labelledby="research-routes-title">
    <div class="container">
      <header>
        <p class="eyebrow"><span class="lang-copy lang-copy--de">Vier Zugänge</span><span class="lang-copy lang-copy--en">Four entrances</span></p>
        <h2 id="research-routes-title"><span class="lang-copy lang-copy--de">Beginnen Sie mit Ihrer Frage.</span><span class="lang-copy lang-copy--en">Begin with your question.</span></h2>
      </header>
      <nav aria-label="NEXAH Science research areas">
        {researchRoutes.map((route) => (
          <div class="research-routes__item">
            <a class="research-routes__primary" href={route.href}>
              <span>{route.code}</span>
              <h3><span class="lang-copy lang-copy--de">{route.title.de}</span><span class="lang-copy lang-copy--en">{route.title.en}</span></h3>
              <p><span class="lang-copy lang-copy--de">{route.description.de}</span><span class="lang-copy lang-copy--en">{route.description.en}</span></p>
              <b aria-hidden="true">→</b>
            </a>
            {"exampleHref" in route && (
              <a class="research-routes__example text-link text-link--external" href={route.exampleHref}>
                <span class="lang-copy lang-copy--de">IOTA/JPL +137 h · Warum übersieht ein Raster zwei Wechsel?</span>
                <span class="lang-copy lang-copy--en">IOTA/JPL +137 h · Why does a grid miss two crossings?</span>
              </a>
            )}
          </div>
        ))}
      </nav>
    </div>
  </section>

  <section class="research-papers section--line" aria-labelledby="research-papers-title">
    <div class="container research-papers__grid">
      <header>
        <p class="eyebrow">Working papers</p>
        <h2 id="research-papers-title"><span class="lang-copy lang-copy--de">Prüfbar lesen, bevor etwas behauptet wird.</span><span class="lang-copy lang-copy--en">Read what can be tested before anything is claimed.</span></h2>
        <a class="text-link" href="/papers/"><span class="lang-copy lang-copy--de">Paper-Section öffnen</span><span class="lang-copy lang-copy--en">Open paper section</span></a>
      </header>
      <article>
        <div><span>{predictionPaper.category}</span><b>{predictionPaper.reviewStatus}</b></div>
        <p class="eyebrow">{predictionPaper.date} · Protocol 01</p>
        <h3>{predictionPaper.title}<br /><em>{predictionPaper.subtitle}</em></h3>
        <p><span class="lang-copy lang-copy--de">Source-bound Methodenpapier und Preregistration-Kandidat. Keine aktivierte Vorhersage, kein bestätigtes Ergebnis.</span><span class="lang-copy lang-copy--en">Source-bound method paper and preregistration candidate. No activated prediction and no confirmed result.</span></p>
        <a class="button" href={`/papers/${predictionPaper.slug}/`}><span class="lang-copy lang-copy--de">Working Paper lesen</span><span class="lang-copy lang-copy--en">Read working paper</span></a>
      </article>
    </div>
  </section>

  <section id="review" class="research-review section--line" aria-labelledby="research-review-title">
    <div class="container">
      <header class="research-review__head">
        <p class="eyebrow">Review field</p>
        <div><h2 id="research-review-title"><span class="lang-copy lang-copy--de">Zwei Objekte. Zwei verschiedene Gates.</span><span class="lang-copy lang-copy--en">Two objects. Two different gates.</span></h2><p><span class="lang-copy lang-copy--de">Öffentlicher Review und methodischer Review-Kandidat bleiben getrennt.</span><span class="lang-copy lang-copy--en">Public review and method-review candidate remain distinct.</span></p></div>
      </header>
      <div class="research-review__grid">
        <article>
          <p class="eyebrow">SCC-003-R1 · Public review</p>
          <h3>Five Pascal Carriers.<br />One Quotient.</h3>
          <p><span class="lang-copy lang-copy--de">Owner-autorisierter, begrenzter mathematischer Review. Reviewer ausstehend; keine Novelty- oder Prioritätsbehauptung.</span><span class="lang-copy lang-copy--en">Owner-authorized bounded mathematical review. Reviewer pending; no novelty or priority claim.</span></p>
          <strong>PUBLIC_REVIEW · REVIEWER_PENDING</strong>
          <a class="button" href="/scc-003-r1/"><span class="lang-copy lang-copy--de">Review-Raum öffnen</span><span class="lang-copy lang-copy--en">Open review room</span></a>
        </article>
        <article>
          <p class="eyebrow">{predictionPaper.category} · Protocol 01</p>
          <h3>{predictionPaper.title}<br /><em>{predictionPaper.subtitle}</em></h3>
          <p><span class="lang-copy lang-copy--de">Das Pre-Lock-Paket ist hashgebunden und für die unabhängige Prüfung von Methode, Lock-Feldern und Falsifikationslogik geöffnet. Die Vorhersage bleibt unversiegelt und inaktiv.</span><span class="lang-copy lang-copy--en">The pre-lock packet is hash-bound and open for independent review of method, lock fields and falsification logic. The prediction remains unsealed and inactive.</span></p>
          <strong>{predictionPaper.reviewRoomStatus} · {predictionPaper.predictionStatus}</strong>
          <a class="button" href={predictionPaper.reviewRoute}><span class="lang-copy lang-copy--de">Method Review öffnen</span><span class="lang-copy lang-copy--en">Open method review</span></a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const metadata = {
      de: {
        title: "Forschen — NEXAH Science",
        description: "Der öffentliche Einstieg in Forschungsstand, Ergebnisse, Mathfield, Methode und offene Review-Fragen von NEXAH Science.",
      },
      en: {
        title: "Research — NEXAH Science",
        description: "The public entrance to the research position, results, Mathfield, method and open review questions of NEXAH Science.",
      },
    };
    const applyMetadata = (language) => {
      const copy = metadata[language === "en" ? "en" : "de"];
      document.title = copy.title;
      document.querySelector('meta[name="description"]')?.setAttribute("content", copy.description);
      document.querySelector('meta[property="og:title"]')?.setAttribute("content", copy.title);
      document.querySelector('meta[property="og:description"]')?.setAttribute("content", copy.description);
      document.querySelector('meta[name="twitter:title"]')?.setAttribute("content", copy.title);
      document.querySelector('meta[name="twitter:description"]')?.setAttribute("content", copy.description);
    };
    applyMetadata(document.documentElement.dataset.siteLanguage);
    window.addEventListener("nexah:language-changed", (event) => applyMetadata(event.detail));
  })();
</script>

<style>
  .research-entry { padding-block: clamp(5rem, 9vw, 9rem); background: #071d26; color: #edf4f2; }
  .research-entry__hero { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(18rem, .55fr); gap: clamp(2rem, 7vw, 7rem); align-items: end; }
  .research-entry .eyebrow { color: #f1bd3d; }
  .research-entry h1 { max-width: 10ch; margin: 1rem 0 1.5rem; color: #edf4f2; font-size: clamp(3.5rem, 8vw, 8rem); line-height: .9; }
  .research-entry .lead { max-width: 50rem; color: #c8d6d9; }
  .research-entry aside { padding: 1.5rem 0 1.5rem 1.5rem; border-left: 1px solid #f1bd3d; }
  .research-entry aside strong { color: #f1bd3d; font: 800 .68rem/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; }
  .research-entry aside p { color: #b8c9cd; }
  .research-foundation { padding-block: var(--space-7); background: #eef0ea; }
  .research-foundation__head { display: grid; grid-template-columns: .45fr 1.55fr; gap: var(--space-5); margin-bottom: var(--space-5); }
  .research-foundation__head h2 { margin: 0; font-size: var(--step-3); }
  .research-foundation__head > p { color: var(--gold); }
  .research-foundation__head div > p { color: var(--muted); }
  .research-foundation__grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); margin: 0; padding: 0; border: 1px solid var(--rule); list-style: none; }
  .research-foundation__grid li { min-height: 24rem; padding: var(--space-4); }
  .research-foundation__grid li + li { border-left: 1px solid var(--rule); }
  .research-foundation__grid li > span { color: var(--gold); font: 800 .66rem/1 var(--mono); letter-spacing: .09em; }
  .research-foundation__grid h3 { margin: 3rem 0 1rem; font-family: var(--serif); font-size: clamp(1.45rem, 2vw, 2.1rem); font-weight: 400; line-height: 1.05; }
  .research-foundation__grid p { color: var(--muted); }
  .research-foundation__grid small { display: block; margin-top: 1.5rem; color: #66767a; line-height: 1.5; }
  .research-foundation__position { margin: 0; padding: var(--space-4); border: 1px solid var(--rule); border-top: 0; color: var(--muted); }
  .research-foundation__position strong { color: var(--gold); font-family: var(--mono); }
  .research-routes { padding-block: var(--space-7); }
  .research-routes header { display: grid; grid-template-columns: .6fr 1.4fr; gap: var(--space-5); align-items: end; margin-bottom: var(--space-5); }
  .research-routes h2 { margin: 0; font-size: var(--step-3); }
  .research-routes nav { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border: 1px solid var(--rule); }
  .research-routes__item { display: flex; flex-direction: column; min-height: 22rem; border-right: 1px solid var(--rule); }
  .research-routes__item:last-child { border-right: 0; }
  .research-routes__primary { position: relative; flex: 1; padding: var(--space-4) var(--space-4) 3rem; color: var(--ink); text-decoration: none; }
  .research-routes__primary > span { color: var(--gold); font: 800 .66rem/1 var(--mono); letter-spacing: .09em; text-transform: uppercase; }
  .research-routes__example { align-self: flex-start; margin: 0 var(--space-4) var(--space-4); }
  .research-routes nav h3 { margin: 3rem 0 1rem; overflow-wrap: anywhere; font-family: var(--serif); font-size: clamp(1.65rem, 2.35vw, 2.55rem); font-weight: 400; hyphens: auto; line-height: 1.05; }
  .research-routes nav p { color: var(--muted); }
  .research-routes nav b { position: absolute; right: 1.5rem; bottom: 1.25rem; color: var(--gold); }
  .research-papers { padding-block: var(--space-7); background: #eef0ea; }
  .research-papers__grid { display: grid; grid-template-columns: .7fr 1.3fr; gap: clamp(2rem, 7vw, 7rem); }
  .research-papers header h2 { margin: 1rem 0 2rem; font-size: var(--step-3); }
  .research-papers article { padding: clamp(1.5rem, 4vw, 3rem); border: 1px solid var(--rule); background: var(--paper); }
  .research-papers article > div { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--rule); font: 800 .66rem/1.4 var(--mono); }
  .research-papers article > div span { color: var(--gold); }
  .research-papers article h3 { margin: 2rem 0 1rem; font-family: var(--serif); font-size: var(--step-3); font-weight: 400; line-height: 1; }
  .research-papers article h3 em { color: var(--muted); font-weight: 400; }
  .research-review { padding-block: var(--space-7); background: #071d26; color: #edf4f2; }
  .research-review__head { display: grid; grid-template-columns: .45fr 1.55fr; gap: var(--space-5); margin-bottom: var(--space-5); }
  .research-review__head h2 { margin: 0; color: #edf4f2; font-size: var(--step-3); }
  .research-review__head p { color: #aebfc4; }
  .research-review__grid { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid #34505a; }
  .research-review__grid article { display: flex; min-height: 28rem; flex-direction: column; padding: clamp(1.5rem, 4vw, 3rem); }
  .research-review__grid article + article { border-left: 1px solid #34505a; }
  .research-review__grid h3 { margin: 2rem 0 1rem; color: #fff; font-family: var(--serif); font-size: var(--step-3); font-weight: 400; line-height: 1; }
  .research-review__grid h3 em { color: #8fb0b7; font-weight: 400; }
  .research-review__grid article > p:not(.eyebrow) { color: #b8c9cd; }
  .research-review__grid strong { margin-top: auto; padding-block: 1rem; color: #efbd3d; font: 800 .7rem/1.4 var(--mono); }
  .research-review__grid .button { align-self: flex-start; }
  @media (max-width: 900px) {
    .research-entry__hero, .research-foundation__head, .research-routes header, .research-papers__grid, .research-review__head { grid-template-columns: 1fr; }
    .research-foundation__grid { grid-template-columns: 1fr; }
    .research-foundation__grid li { min-height: auto; }
    .research-foundation__grid li + li { border-top: 1px solid var(--rule); border-left: 0; }
    .research-routes nav { grid-template-columns: repeat(2, 1fr); }
    .research-routes__item:nth-child(2) { border-right: 0; }
    .research-routes__item:nth-child(-n+2) { border-bottom: 1px solid var(--rule); }
  }
  @media (max-width: 600px) {
    .research-entry h1 { font-size: clamp(3.1rem, 17vw, 5rem); }
    .research-routes nav { grid-template-columns: 1fr; }
    .research-routes__item { min-height: 16rem; border-right: 0; border-bottom: 1px solid var(--rule); }
    .research-routes__item:last-child { border-bottom: 0; }
    .research-review__grid { grid-template-columns: 1fr; }
    .research-review__grid article + article { border-top: 1px solid #34505a; border-left: 0; }
  }
</style>
