---
import type { VisualCollection } from "@/data/atlas";
type Props = { visual: VisualCollection; href?: string };
const { visual, href } = Astro.props;
---
{href ? (
  <a class="visual-collection-card" href={href}>
    <span class="visual-collection-card__cover">
      <img src={visual.cover} alt={`Cover for ${visual.title}`} width="1024" height="1536" loading="lazy" />
    </span>
    <span class="visual-collection-card__copy">
      <h3>{visual.title}</h3>
      <p>{visual.summary}</p>
      <strong>Enter collection <span aria-hidden="true">→</span></strong>
    </span>
  </a>
) : (
  <article class="visual-collection-card">
    <span class="visual-collection-card__cover">
      <img src={visual.cover} alt={`Cover for ${visual.title}`} width="1024" height="1536" loading="lazy" />
    </span>
    <span class="visual-collection-card__copy">
      <h3>{visual.title}</h3>
      <p>{visual.summary}</p>
    </span>
  </article>
)}
