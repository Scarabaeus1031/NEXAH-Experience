---
type Props = {
  title: string;
  description?: string;
  id?: string;
};
const { title, description, id } = Astro.props;
---
<section class="relationship-section" id={id}>
  <header>
    <h2>{title}</h2>
    {description && <p>{description}</p>}
  </header>
  <div class="relationship-section__content"><slot /></div>
</section>
