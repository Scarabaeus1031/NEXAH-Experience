---
type Chapter = {
  chapter: string;
  symbol: string;
  name: string;
  role: string;
  owns: string;
  next: string;
  href: string;
  current?: boolean;
  external?: boolean;
};

const chapters: readonly Chapter[] = [
  {
    chapter: "Place 01",
    symbol: "◎",
    name: "nexah.de",
    role: "Public and intellectual home",
    owns: "The public introduction, Library, Atlas and routes into the ecosystem.",
    next: "Begin here",
    href: "/",
    current: true,
  },
  {
    chapter: "Place 02",
    symbol: "⌕",
    name: "NEXAH Repository",
    role: "Research and framework",
    owns: "The scientific record, Orientation Language, framework, experiments and governance.",
    next: "Open the research",
    href: "https://github.com/Scarabaeus1031/NEXAH",
    external: true,
  },
  {
    chapter: "Place 03",
    symbol: "◇",
    name: "ORION",
    role: "Certified deterministic core",
    owns: "Immutable structural orientation artifacts and their certified responsibility boundaries.",
    next: "Inspect the core",
    href: "https://github.com/Scarabaeus1031/NEXAH-ORION",
    external: true,
  },
  {
    chapter: "Place 04",
    symbol: "⬡",
    name: "NEXAHEDRON",
    role: "Human-facing reference implementation",
    owns: "One Workspace for Encounter, Reflection, Rest and a Human-owned Orientation Record.",
    next: "Try one session",
    href: "https://nexahedron.com",
    external: true,
  },
];
---

<div class="ecosystem-map ecosystem-map--public" aria-label="NEXAH Version 1 public ecosystem map">
  <header class="ecosystem-map__public-header">
    <p class="ecosystem-map__label">You are here</p>
    <strong>NEXAH — The Orientation Ecosystem</strong>
    <span>One ecosystem. Distinct roles. One coherent journey.</span>
  </header>
  <div class="ecosystem-map__chapters">
    {chapters.map((chapter) => (
      <a
        class:list={["ecosystem-chapter", { "ecosystem-chapter--current": chapter.current }]}
        href={chapter.href}
        target={chapter.external ? "_blank" : undefined}
        rel={chapter.external ? "noopener noreferrer" : undefined}
      >
        <span class="ecosystem-chapter__heading">
          <span class="ecosystem-chapter__symbol" aria-hidden="true">{chapter.symbol}</span>
          <small>{chapter.chapter}</small>
        </span>
        <small>{chapter.role}</small>
        <strong>{chapter.name}</strong>
        <p>{chapter.owns}</p>
        <span class="ecosystem-destination__invitation">{chapter.next} <span aria-hidden="true">{chapter.external ? "↗" : "→"}</span></span>
      </a>
    ))}
  </div>
  <footer class="ecosystem-map__foundations">
    <strong>Shared foundations</strong>
    <a href="https://github.com/Scarabaeus1031/NEXAH/blob/main/ORIENTATION_LANGUAGE/README.md">Orientation Language 1.0</a>
    <a href="https://github.com/Scarabaeus1031/NEXAH/blob/main/GOVERNANCE/">Governance</a>
    <a href="https://github.com/Scarabaeus1031/NEXAH">Canonical research</a>
  </footer>
</div>
