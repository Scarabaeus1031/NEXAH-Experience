---
import { withPublicRevision } from "@/data/public-route";

const path = Astro.url.pathname;

const mainSections = [
  {
    label: "Orientieren",
    href: "/",
    external: false,
    current: path === "/" || path.startsWith("/about/") || path.startsWith("/how-nexah-works/"),
  },
  {
    label: "Forschen",
    href: "/forschen/",
    external: false,
    current: path.startsWith("/forschen/") || path.startsWith("/A0_SCIENTIFIC_") || path.startsWith("/A0_MATHEMATICAL_") || path.startsWith("/A0_NEXAH_") || path.startsWith("/A0_RETURN_") || path.startsWith("/A0_FIELDS_") || path.startsWith("/A0_BOUNDARY_"),
  },
  {
    label: "Lesen & erkunden",
    href: "/library/",
    external: false,
    current: path.startsWith("/library/") || path.startsWith("/atlas/") || path.startsWith("/atlas-of-atlases/") || path.startsWith("/01_FROM_LINE_TO_READOUT"),
  },
  {
    label: "Anwenden & erleben",
    href: "/A0_TOURS.html",
    external: false,
    current: path.startsWith("/A0_TOURS") || path.startsWith("/laboratory/") || path.startsWith("/threshold/") || path.startsWith("/departure/"),
  },
] as const;

const menuGroups = [
  {
    code: "01", title: "Orientieren",
    description: "Verstehen, was NEXAH ist und wie die Bereiche zusammenhängen.",
    links: [
      { label: "Startseite", href: "/" },
      { label: "About NEXAH", href: "/about/" },
      { label: "How NEXAH Works", href: "/how-nexah-works/" },
    ],
  },
  {
    code: "02", title: "Forschen",
    description: "Stand, Resultate, Belege und offene Grenzen prüfen.",
    links: [
      { label: "Forschen · Überblick", href: "/forschen/" },
      { label: "Forschungsstand", href: "/A0_SCIENTIFIC_POSITION_REPORT.html" },
      { label: "Ergebnisse & Papers", href: "/forschen/#contributions" },
      { label: "Mathfield", href: "/A0_MATHEMATICAL_JOINTS.html" },
      { label: "Offene Fragen & Review", href: "/forschen/#validation-boundary" },
    ],
  },
  {
    code: "03", title: "Lesen & erkunden",
    description: "Bücher, Publikationen und Karten als eigene Räume öffnen.",
    links: [
      { label: "Library", href: "/library/" },
      { label: "Orientation-Bücher", href: "/library/#orientation-books" },
      { label: "Sieben Reader-Räume", href: "/library/#reader-rooms" },
      { label: "Book · Kapitel 01–08", href: "/01_FROM_LINE_TO_READOUT.html" },
      { label: "Atlas of Atlases", href: "/atlas-of-atlases/" },
      { label: "Are.na · Referenzen", href: "https://www.are.na/nexah-scarabaeus1031" },
      { label: "Substack · Essays", href: "https://nexah.substack.com/" },
      { label: "Behance · Visuelle Arbeiten", href: "https://www.behance.net/Scarabaeus1033" },
    ],
  },
  {
    code: "04", title: "Anwenden & erleben",
    description: "Touren, Instrumente und die verbundenen öffentlichen Häuser öffnen.",
    links: [
      { label: "Geführte Tour", href: "/A0_TOURS.html" },
      { label: "Laboratory", href: "/laboratory/" },
      { label: "NEXAHEDRON · Human", href: "https://nexahedron.com" },
      { label: "Scarabæus · Builder", href: "https://www.scarabaeus1033.net" },
      { label: "Review & Forschungsfrage", href: "/NEXAH_C_CONNECT.html#scientific-review" },
    ],
  },
] as const;
---

<header class="science-public-shell">
  <div class="science-public-top">
    <a class="science-public-brand" href="/">NEXAH <span>· Orientation</span></a>
    <nav class="science-public-primary" aria-label="NEXAH Hauptnavigation">
      {mainSections.map((section) => (
        <a
          href={withPublicRevision(section.href)}
          target={section.external ? "_blank" : undefined}
          rel={section.external ? "noopener noreferrer" : undefined}
          aria-current={section.current ? "page" : undefined}
        >{section.label}{section.external ? <span aria-hidden="true"> ↗</span> : null}</a>
      ))}
    </nav>
    <details class="science-public-menu">
      <summary>Navigation <span aria-hidden="true">+</span></summary>
      <div class="science-public-menu__panel">
        <header>
          <p>NEXAH · öffentliche Übersicht</p>
          <h2>Wohin möchten Sie gehen?</h2>
          <span>Ein Werk, vier klare Zugänge. Interne A0-, Desk- und Mission-Control-Bereiche bleiben getrennt.</span>
        </header>
        <div class="science-public-menu__grid">
          {menuGroups.map((group) => (
            <section>
              <small>{group.code}</small>
              <h3>{group.title}</h3>
              <p>{group.description}</p>
              <nav aria-label={group.title}>
                {group.links.map((link) => <a href={withPublicRevision(link.href)}>{link.label}<span aria-hidden="true">→</span></a>)}
              </nav>
            </section>
          ))}
        </div>
      </div>
    </details>
  </div>
</header>

<script>
  const menus = document.querySelectorAll<HTMLDetailsElement>(".science-public-menu");
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") menus.forEach((menu) => { menu.open = false; });
  });
</script>

<style>
  .science-public-shell {
    position: sticky; top: 0; z-index: 90;
    border-bottom: 1px solid #d2c9b9;
    background: rgba(255, 253, 248, .97); color: #10233d;
    backdrop-filter: blur(14px);
  }
  .science-public-top {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center; gap: clamp(1rem, 2.3vw, 2.5rem); min-height: 58px; padding: .7rem 5vw;
  }
  .science-public-brand {
    color: inherit; font: 850 .88rem/1 ui-sans-serif, system-ui, sans-serif;
    letter-spacing: .14em; text-decoration: none; white-space: nowrap;
  }
  .science-public-brand span { color: #657287; font-weight: 550; letter-spacing: .03em; }
  .science-public-primary { display: flex; justify-content: flex-end; gap: clamp(.65rem, 1.15vw, 1.15rem); min-width: 0; }
  .science-public-shell nav a, .science-public-menu summary {
    color: inherit; font: 750 .58rem/1.2 "SFMono-Regular", Consolas, monospace;
    letter-spacing: .065em; text-decoration: none; text-transform: uppercase;
  }
  .science-public-shell nav a:hover, .science-public-shell nav a:focus-visible,
  .science-public-shell nav a[aria-current="page"] {
    color: #785407; text-decoration: underline; text-decoration-color: #e9b541; text-underline-offset: .35rem;
  }
  .science-public-menu { position: static; }
  .science-public-menu summary {
    display: flex; align-items: center; gap: .45rem; padding: .58rem .7rem;
    border: 1px solid #c9bdab; border-radius: .45rem; cursor: pointer; list-style: none; white-space: nowrap;
  }
  .science-public-menu summary::-webkit-details-marker { display: none; }
  .science-public-menu summary span { color: #9a6c00; font-size: .9rem; transition: transform 160ms ease; }
  .science-public-menu[open] summary { border-color: #d7a52d; background: #fff6dd; color: #785407; }
  .science-public-menu[open] summary span { transform: rotate(45deg); }
  .science-public-menu__panel {
    position: absolute; top: 100%; right: 4vw; left: 4vw; z-index: 95;
    max-height: min(44rem, calc(100vh - 7rem)); overflow: auto;
    padding: clamp(1.25rem, 2.5vw, 2.5rem); border: 1px solid #d2c9b9; border-top: 3px solid #e9b541;
    border-radius: 0 0 1.1rem 1.1rem; background: #fffdf8; box-shadow: 0 1.5rem 4rem rgba(7, 25, 35, .25);
  }
  .science-public-menu__panel > header { display: grid; grid-template-columns: minmax(0, 1fr) minmax(18rem, .7fr); gap: .35rem 3rem; margin-bottom: 1.5rem; }
  .science-public-menu__panel > header p { grid-column: 1 / -1; margin: 0; color: #9a6c00; font: 800 .58rem/1.3 "SFMono-Regular", Consolas, monospace; letter-spacing: .12em; text-transform: uppercase; }
  .science-public-menu__panel > header h2 { margin: 0; color: #10233d; font: 650 clamp(1.7rem, 3vw, 2.7rem)/1.05 Georgia, serif; }
  .science-public-menu__panel > header > span { align-self: end; color: #657287; font: 500 .86rem/1.5 ui-sans-serif, system-ui, sans-serif; }
  .science-public-menu__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border: 1px solid #d8cfc1; }
  .science-public-menu__grid > section { min-width: 0; padding: 1.25rem; border-right: 1px solid #d8cfc1; }
  .science-public-menu__grid > section:last-child { border-right: 0; }
  .science-public-menu__grid small { color: #9a6c00; font: 800 .58rem/1 "SFMono-Regular", Consolas, monospace; letter-spacing: .1em; }
  .science-public-menu__grid h3 { margin: .55rem 0 .5rem; color: #10233d; font: 750 1rem/1.2 ui-sans-serif, system-ui, sans-serif; }
  .science-public-menu__grid p { min-height: 4.3em; margin: 0 0 1rem; color: #657287; font: 500 .78rem/1.45 ui-sans-serif, system-ui, sans-serif; }
  .science-public-menu__grid nav { display: grid; gap: .35rem; }
  .science-public-menu__grid nav a { display: flex; justify-content: space-between; gap: 1rem; padding: .55rem 0; border-top: 1px solid #e5ded3; font-size: .56rem; }
  .science-public-menu__grid nav a span { color: #9a6c00; }
  @media (max-width: 820px) {
    .science-public-top { grid-template-columns: auto auto; }
    .science-public-primary { grid-column: 1 / -1; grid-row: 2; justify-content: flex-start; overflow-x: auto; padding: .25rem 0; scrollbar-width: thin; }
    .science-public-menu { grid-column: 2; grid-row: 1; justify-self: end; }
    .science-public-menu__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .science-public-menu__grid > section { border-bottom: 1px solid #d8cfc1; }
    .science-public-menu__grid > section:nth-child(2) { border-right: 0; }
    .science-public-menu__grid > section:nth-child(n+3) { border-bottom: 0; }
  }
  @media (max-width: 680px) {
    .science-public-top { padding-inline: 1rem; }
    .science-public-primary { gap: 1rem; }
    .science-public-menu__panel { right: .75rem; left: .75rem; max-height: calc(100vh - 8rem); }
    .science-public-menu__panel > header { grid-template-columns: 1fr; }
    .science-public-menu__panel > header > span { margin-top: .35rem; }
    .science-public-menu__grid { grid-template-columns: 1fr; }
    .science-public-menu__grid > section { border-right: 0; border-bottom: 1px solid #d8cfc1 !important; }
    .science-public-menu__grid > section:last-child { border-bottom: 0 !important; }
  }
</style>
