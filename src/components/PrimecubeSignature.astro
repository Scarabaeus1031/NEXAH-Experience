---
const researchHref = "/forschen/";
---

<section id="primecube" class="primecube-signature" aria-labelledby="primecube-title" data-primecube-signature>
  <div class="container primecube-signature__inner">
    <div class="primecube-signature__copy">
      <p class="eyebrow"><span class="lang-copy lang-copy--de">NEXAH Instrument · endlicher Zahlenträger</span><span class="lang-copy lang-copy--en">NEXAH instrument · finite number carrier</span></p>
      <h2 id="primecube-title"><span class="lang-copy lang-copy--de">Die Zahl bleibt.<br />Die Ansicht verändert sich.</span><span class="lang-copy lang-copy--en">The number remains.<br />The view changes.</span></h2>
      <p class="lead"><span class="lang-copy lang-copy--de">Der Primecube hält die Zahlen <strong>1…1111</strong> als eindeutige Adressen. Matrix, Würfel und Faltung zeigen denselben endlichen Träger aus verschiedenen Perspektiven.</span><span class="lang-copy lang-copy--en">The Primecube holds the numbers <strong>1…1111</strong> as unique addresses. Matrix, cube and fold show the same finite carrier from different perspectives.</span></p>
      <div class="primecube-signature__equation" aria-label="Standard Base-11 address rule with exact return">
        <small><span class="lang-copy lang-copy--de">Standard-Adressregel · Base 11</span><span class="lang-copy lang-copy--en">Standard address rule · base 11</span></small>
        <strong>n = 1 + x + 11y + 121z</strong>
        <span>x,y ∈ &#123;0,…,10&#125; · z ∈ &#123;0,…,9&#125;</span>
      </div>
      <p class="primecube-signature__boundary"><span class="lang-copy lang-copy--de"><strong>Grenze:</strong> exakte Adressarithmetik und deklarierte Ansichtswechsel. Kein Primzahlgenerator und keine intrinsische kubische Primzahlgeometrie.</span><span class="lang-copy lang-copy--en"><strong>Boundary:</strong> exact address arithmetic and declared view transforms. No prime generator and no intrinsic cubic prime geometry.</span></p>
      <a class="button" href={researchHref}><span class="lang-copy lang-copy--de">NEXAH Science betreten</span><span class="lang-copy lang-copy--en">Enter NEXAH Science</span></a>
    </div>

    <div class="primecube-signature__instrument" aria-label="Interaktive öffentliche Primecube-Signatur">
      <div class="primecube-signature__status" aria-hidden="true">
        <span>FINITE CARRIER · 1…1111</span>
        <span>EXACT RETURN</span>
      </div>
      <div class="primecube-signature__modes" role="group" aria-label="Primecube view">
        <button type="button" data-primecube-view="matrix" aria-pressed="false">2D Matrix</button>
        <button type="button" data-primecube-view="cube" aria-pressed="true">3D Cube</button>
        <button type="button" data-primecube-view="fold" aria-pressed="false">Gap Fold</button>
      </div>
      <div class="primecube-signature__stage">
        <svg viewBox="0 0 720 520" role="img" aria-labelledby="primecube-visual-title primecube-visual-desc">
          <title id="primecube-visual-title">Primecube finite carrier</title>
          <desc id="primecube-visual-desc">Prime numbers up to 1111 projected into a selected matrix, cube or declared fold view. The selected source number retains its exact address.</desc>
          <g class="primecube-signature__frame" data-primecube-frame></g>
          <g class="primecube-signature__points" data-primecube-points></g>
          <g class="primecube-signature__hinge" data-primecube-hinge></g>
          <circle class="primecube-signature__selection" data-primecube-selection r="9"></circle>
        </svg>
        <div class="primecube-signature__readout" aria-live="polite">
          <small data-primecube-record>RECORD PC1111:N0661</small>
          <strong data-primecube-value>661 · prime #121</strong>
          <dl>
            <div><dt>Cube</dt><dd data-primecube-address>[0, 5, 5]</dd></div>
            <div><dt>Return</dt><dd data-primecube-return>EXACT · 661</dd></div>
          </dl>
        </div>
      </div>
      <div class="primecube-signature__records" role="group" aria-label="Select source record">
        <span>Source record</span>
        <button type="button" data-primecube-number="659" aria-pressed="false">659</button>
        <button type="button" data-primecube-number="661" aria-pressed="true">661</button>
        <button type="button" data-primecube-number="787" aria-pressed="false">787</button>
        <button type="button" data-primecube-number="811" aria-pressed="false">811</button>
      </div>
    </div>
  </div>
</section>

<script>
  const NS = "http://www.w3.org/2000/svg";

  type ViewMode = "matrix" | "cube" | "fold";
  type Point3D = { x: number; y: number; z: number };
  type Point2D = { x: number; y: number };

  const createSvgElement = (name: string, attributes: Record<string, string | number> = {}) => {
    const element = document.createElementNS(NS, name);
    Object.entries(attributes).forEach(([key, value]) => element.setAttribute(key, String(value)));
    return element;
  };

  const createPrimeTable = (limit: number) => {
    const table = Array(limit + 1).fill(true);
    table[0] = false;
    table[1] = false;
    for (let p = 2; p * p <= limit; p += 1) {
      if (!table[p]) continue;
      for (let multiple = p * p; multiple <= limit; multiple += p) table[multiple] = false;
    }
    return table;
  };

  const primeTable = createPrimeTable(1111);
  const primes = primeTable.flatMap((isPrime, value) => isPrime ? [value] : []);
  const primeRank = new Map(primes.map((value, index) => [value, index + 1]));

  const addressOf = (number: number): Point3D => {
    const offset = number - 1;
    return {
      x: offset % 11,
      y: Math.floor(offset / 11) % 11,
      z: Math.floor(offset / 121),
    };
  };

  const projectMatrix = (number: number): Point2D => {
    const offset = number - 1;
    return {
      x: 48 + (offset % 37) * 13.8,
      y: 50 + Math.floor(offset / 37) * 13.4,
    };
  };

  const projectIso = ({ x, y, z }: Point3D): Point2D => ({
    x: 350 + (x - 5) * 27 + (z - 4.5) * 21,
    y: 270 + (y - 5) * 18 - (z - 4.5) * 27,
  });

  const projectCube = (number: number) => projectIso(addressOf(number));

  const projectFold = (number: number) => {
    const { x, y, z } = addressOf(number);
    const ux = (2 * x / 10) - 1;
    let uy = (2 * y / 10) - 1;
    let uz = (2 * z / 9) - 1;
    const hinge = 1 / 9;
    if (number >= 661) {
      const angle = Math.PI / 3;
      const nextY = uy * Math.cos(angle) + (uz - hinge) * Math.sin(angle);
      const nextZ = hinge - uy * Math.sin(angle) + (uz - hinge) * Math.cos(angle);
      uy = nextY;
      uz = nextZ;
    }
    return projectIso({ x: (ux + 1) * 5, y: (uy + 1) * 5, z: (uz + 1) * 4.5 });
  };

  const renderFrame = (frame: SVGGElement, mode: ViewMode) => {
    frame.replaceChildren();
    if (mode === "matrix") {
      frame.append(createSvgElement("rect", { x: 36, y: 38, width: 520, height: 414, rx: 10 }));
      for (let column = 1; column < 37; column += 1) {
        frame.append(createSvgElement("line", { x1: 48 + column * 13.8, y1: 48, x2: 48 + column * 13.8, y2: 442 }));
      }
      for (let row = 1; row < 30; row += 1) {
        frame.append(createSvgElement("line", { x1: 48, y1: 50 + row * 13.4, x2: 545, y2: 50 + row * 13.4 }));
      }
      return;
    }

    const vertices = [
      { x: 0, y: 0, z: 0 }, { x: 10, y: 0, z: 0 }, { x: 10, y: 10, z: 0 }, { x: 0, y: 10, z: 0 },
      { x: 0, y: 0, z: 9 }, { x: 10, y: 0, z: 9 }, { x: 10, y: 10, z: 9 }, { x: 0, y: 10, z: 9 },
    ].map(projectIso);
    [[0,1,2,3],[4,5,6,7],[0,1,5,4],[1,2,6,5]].forEach((face, index) => {
      frame.append(createSvgElement("polygon", {
        points: face.map((vertex) => `${vertices[vertex].x},${vertices[vertex].y}`).join(" "),
        class: `is-cube-face is-cube-face--${index + 1}`,
      }));
    });
    [3, 6].forEach((z) => {
      const slice = [
        projectIso({ x: 0, y: 0, z }), projectIso({ x: 10, y: 0, z }),
        projectIso({ x: 10, y: 10, z }), projectIso({ x: 0, y: 10, z }),
      ];
      frame.append(createSvgElement("polygon", {
        points: slice.map((point) => `${point.x},${point.y}`).join(" "),
        class: "is-cube-slice",
      }));
    });
    [[0,1],[1,2],[2,3],[3,0],[4,5],[5,6],[6,7],[7,4],[0,4],[1,5],[2,6],[3,7]].forEach(([a,b]) => {
      frame.append(createSvgElement("line", { x1: vertices[a].x, y1: vertices[a].y, x2: vertices[b].x, y2: vertices[b].y, class: "is-cube-edge" }));
    });
    [[0,"0"],[1,"x"],[3,"y"],[4,"z"]].forEach(([vertex, label]) => {
      const point = vertices[Number(vertex)];
      frame.append(createSvgElement("circle", { cx: point.x, cy: point.y, r: 3, class: "is-cube-corner" }));
      const axisLabel = createSvgElement("text", { x: point.x + 8, y: point.y - 8, class: "is-cube-axis" });
      axisLabel.textContent = String(label);
      frame.append(axisLabel);
    });
  };

  document.querySelectorAll<HTMLElement>("[data-primecube-signature]").forEach((root) => {
    const frame = root.querySelector<SVGGElement>("[data-primecube-frame]");
    const points = root.querySelector<SVGGElement>("[data-primecube-points]");
    const hinge = root.querySelector<SVGGElement>("[data-primecube-hinge]");
    const selection = root.querySelector<SVGCircleElement>("[data-primecube-selection]");
    const record = root.querySelector<HTMLElement>("[data-primecube-record]");
    const value = root.querySelector<HTMLElement>("[data-primecube-value]");
    const addressReadout = root.querySelector<HTMLElement>("[data-primecube-address]");
    const returnReadout = root.querySelector<HTMLElement>("[data-primecube-return]");
    const viewButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-primecube-view]")];
    const numberButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-primecube-number]")];
    if (!frame || !points || !hinge || !selection || !record || !value || !addressReadout || !returnReadout) return;

    let mode: ViewMode = "cube";
    let selectedNumber = 661;

    const projector = () => mode === "matrix" ? projectMatrix : mode === "fold" ? projectFold : projectCube;

    const render = () => {
      renderFrame(frame, mode);
      points.replaceChildren();
      hinge.replaceChildren();
      const project = projector();

      primes.forEach((number) => {
        const position = project(number);
        const twin = primeTable[number - 2] || primeTable[number + 2];
        points.append(createSvgElement("circle", {
          cx: position.x,
          cy: position.y,
          r: twin ? 3.1 : 2.25,
          class: twin ? "is-twin" : "is-prime",
        }));
      });

      if (mode === "fold") {
        const a = projectFold(661);
        const b = projectFold(781);
        hinge.append(createSvgElement("line", { x1: a.x - 55, y1: a.y, x2: b.x + 55, y2: b.y, class: "is-fold-line" }));
      }

      const selected = project(selectedNumber);
      selection.setAttribute("cx", String(selected.x));
      selection.setAttribute("cy", String(selected.y));

      const address = addressOf(selectedNumber);
      if (mode === "cube") {
        [
          projectIso({ x: address.x, y: 0, z: address.z }),
          projectIso({ x: 0, y: address.y, z: address.z }),
          projectIso({ x: address.x, y: address.y, z: 0 }),
        ].forEach((endpoint) => hinge.append(createSvgElement("line", {
          x1: selected.x, y1: selected.y, x2: endpoint.x, y2: endpoint.y, class: "is-coordinate-guide",
        })));
      }
      record.textContent = `RECORD PC1111:N${String(selectedNumber).padStart(4, "0")}`;
      value.textContent = `${selectedNumber} · prime #${primeRank.get(selectedNumber)}`;
      addressReadout.textContent = `[${address.x}, ${address.y}, ${address.z}]`;
      returnReadout.textContent = `EXACT · ${1 + address.x + 11 * address.y + 121 * address.z}`;
    };

    viewButtons.forEach((button) => button.addEventListener("click", () => {
      mode = (button.dataset.primecubeView ?? "cube") as ViewMode;
      viewButtons.forEach((candidate) => candidate.setAttribute("aria-pressed", String(candidate === button)));
      render();
    }));

    numberButtons.forEach((button) => button.addEventListener("click", () => {
      selectedNumber = Number(button.dataset.primecubeNumber);
      numberButtons.forEach((candidate) => candidate.setAttribute("aria-pressed", String(candidate === button)));
      render();
    }));

    render();
  });
</script>

<style>
  .primecube-signature { overflow: hidden; padding-block: clamp(4.5rem, 8vw, 8rem); background: radial-gradient(circle at 78% 42%, rgba(77,218,232,.12), transparent 26rem), #06141d; color: #edf4f2; }
  .primecube-signature__inner { display: grid; grid-template-columns: minmax(0,.75fr) minmax(30rem,1.25fr); gap: clamp(2rem,6vw,6rem); align-items: center; }
  .primecube-signature .eyebrow { color: #f1bd3d; }
  .primecube-signature h2 { max-width: 11ch; margin: .8rem 0 1.4rem; color: #fff; font-size: clamp(2.8rem,5.2vw,5.8rem); font-weight: 400; line-height: .9; }
  .primecube-signature .lead { max-width: 39rem; color: #c3d1d5; }
  .primecube-signature__equation { display: grid; gap: .4rem; margin: 2rem 0; padding: 1.1rem 0 1.1rem 1.2rem; border-left: 2px solid #f1bd3d; color: #9eb4ba; font: 600 clamp(.78rem,1.2vw,.95rem)/1.5 var(--mono); }
  .primecube-signature__equation small { color: #f1bd3d; font-size: .65rem; letter-spacing: .08em; text-transform: uppercase; }
  .primecube-signature__equation strong { color: #fff; }
  .primecube-signature__boundary { max-width: 38rem; color: #8fa4aa; font-size: .78rem; line-height: 1.55; }
  .primecube-signature__copy .button { margin-top: 1.25rem; }
  .primecube-signature__instrument { border: 1px solid #294451; background: rgba(4,15,23,.78); box-shadow: 0 2rem 5rem rgba(0,0,0,.3); }
  .primecube-signature__status { display: flex; justify-content: space-between; gap: 1rem; padding: .85rem 1rem; border-bottom: 1px solid #294451; color: #78929a; font: 700 .66rem/1 var(--mono); letter-spacing: .08em; }
  .primecube-signature__status span:last-child { color: #67d7e4; }
  .primecube-signature__modes { display: grid; grid-template-columns: repeat(3,1fr); border-bottom: 1px solid #294451; }
  .primecube-signature button { min-height: 3rem; border: 0; background: transparent; cursor: pointer; color: #90a5ab; font: 700 .72rem/1 var(--mono); letter-spacing: .04em; }
  .primecube-signature button + button { border-left: 1px solid #294451; }
  .primecube-signature button[aria-pressed="true"] { background: #102a39; color: #fff; box-shadow: inset 0 -2px #f1bd3d; }
  .primecube-signature button:focus-visible { outline: 2px solid #f1bd3d; outline-offset: -4px; }
  .primecube-signature__stage { position: relative; min-height: 31rem; }
  .primecube-signature__stage svg { display: block; width: 100%; height: auto; min-height: 31rem; }
  .primecube-signature__frame :global(rect),.primecube-signature__frame :global(line),.primecube-signature__frame :global(polygon) { fill: none; stroke: #35505d; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .primecube-signature__frame :global(line) { opacity: .75; }
  .primecube-signature__frame :global(.is-cube-face) { fill: rgba(77,218,232,.025); stroke: rgba(112,174,190,.34); }
  .primecube-signature__frame :global(.is-cube-face--2) { fill: rgba(241,189,61,.035); }
  .primecube-signature__frame :global(.is-cube-slice) { stroke: rgba(77,218,232,.26); stroke-dasharray: 4 7; }
  .primecube-signature__frame :global(.is-cube-edge) { stroke: #567682; stroke-width: 1.35; opacity: .95; }
  .primecube-signature__frame :global(.is-cube-corner) { fill: #f1bd3d; stroke: #071923; }
  .primecube-signature__frame :global(.is-cube-axis) { fill: #91a9af; font: 700 13px/1 var(--mono); }
  .primecube-signature__points :global(circle) { vector-effect: non-scaling-stroke; }
  .primecube-signature__points :global(.is-prime) { fill: #d8ad3b; opacity: .72; }
  .primecube-signature__points :global(.is-twin) { fill: #ec615a; opacity: .9; }
  .primecube-signature__hinge :global(.is-fold-line) { stroke: #f1bd3d; stroke-dasharray: 7 7; stroke-width: 1.5; opacity: .8; }
  .primecube-signature__hinge :global(.is-coordinate-guide) { stroke: #4ddae8; stroke-dasharray: 3 6; stroke-width: 1; opacity: .75; }
  .primecube-signature__selection { fill: #fff; stroke: #4ddae8; stroke-width: 5; vector-effect: non-scaling-stroke; }
  .primecube-signature__readout { position: absolute; right: 1rem; bottom: 1rem; width: min(15rem,45%); padding: 1rem; border-left: 2px solid #4ddae8; background: rgba(2,12,18,.9); }
  .primecube-signature__readout small { display: block; color: #718c94; font: 700 .62rem/1.3 var(--mono); }
  .primecube-signature__readout > strong { display: block; margin: .55rem 0 .8rem; color: #fff; font-family: var(--serif); font-size: 1.25rem; font-weight: 400; }
  .primecube-signature__readout dl { display: grid; gap: .35rem; margin: 0; }
  .primecube-signature__readout dl div { display: flex; justify-content: space-between; gap: 1rem; }
  .primecube-signature__readout dt,.primecube-signature__readout dd { margin: 0; font: 700 .63rem/1.4 var(--mono); }
  .primecube-signature__readout dt { color: #718c94; }
  .primecube-signature__readout dd { color: #d7e5e8; }
  .primecube-signature__records { display: grid; grid-template-columns: 1fr repeat(4,auto); align-items: center; border-top: 1px solid #294451; }
  .primecube-signature__records > span { padding-inline: 1rem; color: #718c94; font: 700 .64rem/1 var(--mono); text-transform: uppercase; }
  .primecube-signature__records button { min-width: 4.5rem; border-left: 1px solid #294451; }
  @media (max-width: 980px) {
    .primecube-signature__inner { grid-template-columns: 1fr; }
    .primecube-signature h2 { max-width: 14ch; }
    .primecube-signature__instrument { width: min(100%,48rem); }
  }
  @media (max-width: 620px) {
    .primecube-signature__stage,.primecube-signature__stage svg { min-height: 23rem; }
    .primecube-signature__readout { right: .65rem; bottom: .65rem; width: 52%; padding: .75rem; }
    .primecube-signature__records { grid-template-columns: repeat(4,1fr); }
    .primecube-signature__records > span { grid-column: 1/-1; padding-block: .8rem; border-bottom: 1px solid #294451; }
    .primecube-signature__records button { min-width: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .primecube-signature * { scroll-behavior: auto; }
  }
</style>
