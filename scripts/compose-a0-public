#!/bin/zsh

set -euo pipefail

readonly SCRIPT_DIR="${0:A:h}"
readonly REPOSITORY_ROOT="${SCRIPT_DIR:h}"
readonly DIST_DIR="${REPOSITORY_ROOT}/dist"
readonly A0_EXPORT_DIR="${1:-}"

if [[ -z "${A0_EXPORT_DIR}" ]]; then
  print -u2 "Usage: scripts/compose-a0-public /absolute/path/to/verified-a0-export"
  exit 1
fi

if [[ ! -f "${DIST_DIR}/index.html" ]]; then
  print -u2 "Experience dist is missing. Run npm run build first."
  exit 1
fi

if [[ ! -f "${A0_EXPORT_DIR}/index.html" || ! -f "${A0_EXPORT_DIR}/.a0-public-export.json" ]]; then
  print -u2 "The supplied directory is not a verified A0 public export."
  exit 1
fi

# Experience owns the nexah.de root and public route contract. The verified A0
# export contributes only its allowlisted Science bundle; it never replaces the
# public root and can never add a Desk or Mission-Control surface.
for source in "${A0_EXPORT_DIR}"/*; do
  name="${source:t}"
  [[ "${name}" == "index.html" ]] && continue
  cp -R "${source}" "${DIST_DIR}/"
done
cp "${A0_EXPORT_DIR}/.a0-public-export.json" "${DIST_DIR}/.a0-public-export.json"

mkdir -p "${DIST_DIR}/forschen"
cp "${A0_EXPORT_DIR}/A0_SCIENCE.html" "${DIST_DIR}/forschen/index.html"

# Root-level A0 pages retain their source-bound content but receive the same
# compact public NEXAH shell as the Astro routes. This prevents the primary
# navigation and reading scale from jumping when a visitor moves between the
# host site and an allowlisted A0 research page.
for public_page in \
  "${DIST_DIR}"/A0_*.html \
  "${DIST_DIR}/01_FROM_LINE_TO_READOUT.html" \
  "${DIST_DIR}/NEXAH_C_CONNECT.html" \
  "${DIST_DIR}/forschen/index.html"; do
  [[ -f "${public_page}" ]] || continue
  if ! grep -q 'a0-public-bridge.css' "${public_page}"; then
    perl -0pi -e 's#</head>#  <link rel="stylesheet" href="/a0-public-bridge.css?rev=public-shell-r10-20261029">\n  <script src="/a0-public-bridge.js?rev=public-shell-r10-20261029" defer></script>\n</head>#' "${public_page}"
  fi
done

# The source-bound A0 page also remains usable as a standalone export, where
# sibling document links are intentionally relative. Once it is mounted at the
# public /forschen/ route, rebase only those allowlisted document links to the
# site root so they continue to resolve inside the composed nexah.de build.
perl -0pi -e 's/href="((?:A0_|NEXAH_C_CONNECT|01_FROM_LINE_TO_READOUT)[^"]*)"/href="\/$1"/g' "${DIST_DIR}/forschen/index.html"

print "Composed the verified, allowlisted A0 Science bundle without replacing nexah.de root."
print "Artifact: ${DIST_DIR}"
